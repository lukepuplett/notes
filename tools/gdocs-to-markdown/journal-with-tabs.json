                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5720
            },
            {
              "endIndex": 5744,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5744,
                    "startIndex": 5721,
                    "textRun": {
                      "content": "Here is the evidence: \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5721
