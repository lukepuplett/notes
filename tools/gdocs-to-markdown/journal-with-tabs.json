                "elements": [
                  {
                    "endIndex": 15018,
                    "startIndex": 15002,
                    "textRun": {
                      "content": "Reduced Utility:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
