                }
              },
              "startIndex": 57077
            },
            {
              "endIndex": 57148,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 57148,
                    "startIndex": 57078,
                    "textRun": {
                      "content": "Our industry is going through a very serious consolidation right now.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 57078
            },
            {
              "endIndex": 57149,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 57149,
                    "startIndex": 57148,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 57148
            },
            {
              "endIndex": 57242,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 57242,
                    "startIndex": 57149,
                    "textRun": {
                      "content": "I've been here for so long but never seen so many companies shutting down and/or downsizing.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 57149
            },
            {
              "endIndex": 57243,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 57243,
                    "startIndex": 57242,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 57242
            },
            {
              "endIndex": 57584,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 57584,
                    "startIndex": 57243,
                    "textRun": {
                      "content": "^ Consolidation, centralisation, failure of vision which was always at odds with how civilization and humankind has always worked. However, it might be good for my idea, as I can potentially build on Tempo, and AI ‘mentors’ and non-crypto VCs continually remind me that the tech doesn’t matter, making a product people will pay for matters.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 57243
            },
