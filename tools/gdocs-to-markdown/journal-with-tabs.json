              "endIndex": 78734,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 78734,
                    "startIndex": 78660,
                    "textRun": {
                      "content": "5. Another 50 fighter jets in 24 hours, including F-35s, F-22s, and F-16s\n",
