                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 115785
            },
            {
              "endIndex": 116017,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116017,
                    "startIndex": 115786,
                    "textRun": {
                      "content": "AI (incl. “vibe coding”) commoditizes code, not systems of record. CSU owns mission‑critical systems of record in niche markets. Those moats are data, workflows, integrations & switching costs – not the difficulty of writing code.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 115786
            },
            {
              "endIndex": 116018,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116018,
                    "startIndex": 116017,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116017
            },
            {
              "endIndex": 116299,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116299,
                    "startIndex": 116018,
                    "textRun": {
                      "content": "Think about what CSU actually buys: 20‑year‑old billing, practice management, municipal, utility, hospital, etc. systems that are completely entangled with how that vertical runs. Replacing them is a multi‑year capex + career‑risking project. AI doesn’t change that risk calculus.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116018
            },
            {
              "endIndex": 116300,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116300,
                    "startIndex": 116299,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116299
            },
            {
              "endIndex": 116362,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116362,
                    "startIndex": 116300,
                    "textRun": {
                      "content": "Vibe coding makes it cheap to stand up “an app”. It does not:\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116300
            },
            {
              "endIndex": 116406,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116406,
                    "startIndex": 116362,
                    "textRun": {
                      "content": "• migrate 15 years of messy production data\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116362
            },
            {
              "endIndex": 116476,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116476,
                    "startIndex": 116406,
                    "textRun": {
                      "content": "• recreate hundreds of integrations (banks, tax authorities, devices)\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116406
            },
            {
              "endIndex": 116530,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116530,
                    "startIndex": 116476,
                    "textRun": {
                      "content": "• rebuild reports auditors & regulators already trust\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116476
            },
            {
              "endIndex": 116577,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116577,
                    "startIndex": 116530,
                    "textRun": {
                      "content": "• retrain an entire workforce on new workflows\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116530
            },
            {
              "endIndex": 116578,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116578,
                    "startIndex": 116577,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116577
            },
            {
              "endIndex": 116835,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116835,
                    "startIndex": 116578,
                    "textRun": {
                      "content": "Most CSU businesses sit at a control point in the value chain. They are the authoritative ledger for money, people, or regulated data. That’s qualitatively different from a point solution that sends emails or draws dashboards on top of someone else’s data.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116578
            },
            {
              "endIndex": 116836,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116836,
                    "startIndex": 116835,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116835
            },
            {
              "endIndex": 117099,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117099,
                    "startIndex": 116836,
                    "textRun": {
                      "content": "AI is great at “systems of action”: generating content, orchestrating tasks, moving data between APIs. Those are the tools that get nuked – thin SaaS wrappers around Gmail, Stripe, HubSpot, QuickBooks, etc. They have shallow data gravity and low switching costs.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116836
            },
            {
              "endIndex": 117100,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117100,
                    "startIndex": 117099,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117099
            },
            {
              "endIndex": 117149,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117149,
                    "startIndex": 117100,
                    "textRun": {
                      "content": "But systems of record (ERP/CRM/core VMS) encode:\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117100
            },
            {
              "endIndex": 117194,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117194,
                    "startIndex": 117149,
                    "textRun": {
                      "content": "• strict data models & referential integrity\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117149
            },
            {
              "endIndex": 117234,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117234,
                    "startIndex": 117194,
                    "textRun": {
                      "content": "• audit trails, permissions, compliance\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117194
            },
            {
              "endIndex": 117310,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117310,
                    "startIndex": 117234,
                    "textRun": {
                      "content": "• deterministic workflows that boards, auditors, and regulators understand.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117234
            },
            {
              "endIndex": 117376,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117376,
                    "startIndex": 117310,
                    "textRun": {
                      "content": "You don’t vibe‑code your general ledger or your clinical records.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117310
            },
            {
              "endIndex": 117377,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117377,
                    "startIndex": 117376,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117376
            },
            {
              "endIndex": 117649,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117649,
                    "startIndex": 117377,
                    "textRun": {
                      "content": "We’ve seen a similar wave already: low‑code/no‑code. For a decade you could drag‑and‑drop your own business app. Did enterprises kill SAP, Oracle, or niche ERPs? No – they use low‑code at the edges while keeping standardized core systems. AI just turns that dial further.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117377
            },
            {
              "endIndex": 117650,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117650,
                    "startIndex": 117649,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117649
            },
            {
              "endIndex": 117919,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117919,
                    "startIndex": 117650,
                    "textRun": {
                      "content": "The “every company will build their own ERP with AI agents” story underestimates non‑coding costs: product mgmt, domain expertise, change mgmt, security, incident response, integration maintenance. Most CSU end‑markets don’t even have the teams to run that experiment.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117650
            },
            {
              "endIndex": 117920,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117920,
                    "startIndex": 117919,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117919
            },
            {
              "endIndex": 117999,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117999,
                    "startIndex": 117920,
                    "textRun": {
                      "content": "On margins: AI is more likely to be margin‑accretive for CSU‑type vendors. It:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117920
            },
            {
              "endIndex": 118070,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118070,
                    "startIndex": 117999,
                    "textRun": {
                      "content": "• boosts dev productivity (faster features/integrations with same R&D)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117999
            },
            {
              "endIndex": 118117,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118117,
                    "startIndex": 118070,
                    "textRun": {
                      "content": "• automates support, onboarding, documentation\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118070
            },
            {
              "endIndex": 118177,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118177,
                    "startIndex": 118117,
                    "textRun": {
                      "content": "• improves internal ops (billing, collections, forecasting)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118117
            },
            {
              "endIndex": 118178,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118178,
                    "startIndex": 118177,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118177
            },
            {
              "endIndex": 118451,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118451,
                    "startIndex": 118178,
                    "textRun": {
                      "content": "Can buyers use AI to squeeze prices? Some, at the margin. But in most CSU verticals, software is 1–2% of revenue and mission‑critical. The binding constraint is risk, not license cost. As long as the app works and is maintained, there isn’t much appetite to rock the boat.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118178
            },
            {
              "endIndex": 118452,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118452,
                    "startIndex": 118451,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118451
            },
            {
              "endIndex": 118727,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118727,
                    "startIndex": 118452,
                    "textRun": {
                      "content": "Meanwhile vendors can repackage AI as upsell: copilots, agents, forecasting, process mining. Core ERP/CRM pricing stays per‑seat/per‑site; AI is a new line item or higher tier. That’s ARPU expansion, not commoditization. The code got cheaper – the outcome got more valuable.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118452
            },
            {
              "endIndex": 118728,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118728,
                    "startIndex": 118727,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118727
            },
            {
              "endIndex": 118822,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118822,
                    "startIndex": 118728,
                    "textRun": {
                      "content": "Where AI really hurts is exactly what you flagged: point solutions. Single‑feature SaaS that:\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118728
            },
            {
              "endIndex": 118845,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118845,
                    "startIndex": 118822,
                    "textRun": {
                      "content": "• sits at the UI layer\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118822
            },
            {
              "endIndex": 118867,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118867,
                    "startIndex": 118845,
                    "textRun": {
                      "content": "• talks to a few APIs\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118845
            },
            {
              "endIndex": 118918,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118918,
                    "startIndex": 118867,
                    "textRun": {
                      "content": "• has no proprietary data model or workflow depth.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118867
            },
            {
              "endIndex": 118992,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118992,
                    "startIndex": 118918,
                    "textRun": {
                      "content": "Those become prompts: “Hey model, do what this $30/month SaaS was doing.”\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118918
            },
            {
              "endIndex": 118993,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 118993,
                    "startIndex": 118992,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118992
            },
            {
              "endIndex": 119005,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119005,
                    "startIndex": 118993,
                    "textRun": {
                      "content": "Net effect:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118993
            },
            {
              "endIndex": 119067,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119067,
                    "startIndex": 119005,
                    "textRun": {
                      "content": "• Point solutions & generic horizontal tools: heavy pressure.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119005
            },
            {
              "endIndex": 119153,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119153,
                    "startIndex": 119067,
                    "textRun": {
                      "content": "• Core vertical systems of record: AI is an add‑on + cost reducer, not a replacement.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119067
            },
            {
              "endIndex": 119276,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119276,
                    "startIndex": 119153,
                    "textRun": {
                      "content": "• CSU’s skill set (buying sticky, boring, regulated, low‑IT‑budget software) is aligned with where AI is least disruptive.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119153
            },
            {
              "endIndex": 119277,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119277,
                    "startIndex": 119276,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119276
            },
            {
              "endIndex": 119544,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119544,
                    "startIndex": 119277,
                    "textRun": {
                      "content": "Could AI still reshuffle winners within verticals? Sure. Incumbents that ignore AI may lose to incumbents that embrace it. Some CSU properties will under‑invest and stagnate. But that’s competition at the margin, not “vibe coding obsoletes the whole business model.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119277
            },
            {
              "endIndex": 119545,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119545,
                    "startIndex": 119544,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119544
            },
            {
              "endIndex": 119820,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119580,
                    "startIndex": 119545,
                    "textRun": {
                      "content": "So why doesn’t AI commoditize CSU? ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 119820,
                    "startIndex": 119580,
                    "textRun": {
                      "content": "Because their moat isn’t lines of code. It’s being the entrenched, audited, regulator‑blessed system that runs payroll, billing, tax, and operations for thousands of tiny niches. AI will sit on top of that stack long before it replaces it.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119545
            },
            {
              "endIndex": 119821,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119821,
                    "startIndex": 119820,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119820
            },
            {
              "endIndex": 119932,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119932,
                    "startIndex": 119821,
                    "textRun": {
                      "content": "Oh and I haven't even started talking about the complexity of running a software company and building a team. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119821
            },
