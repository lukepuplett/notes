                }
              },
              "startIndex": 151
            },
            {
              "endIndex": 154,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 153,
                    "inlineObjectElement": {
                      "inlineObjectId": "kix.2ianyn1j40tu",
                      "textStyle": {}
                    },
