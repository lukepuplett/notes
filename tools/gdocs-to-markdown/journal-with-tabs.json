                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 252787
            },
            {
              "endIndex": 252915,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 252915,
                    "startIndex": 252788,
                    "textRun": {
                      "content": "“The idea that we're going to be in a Middle Eastern war for years with no end in sight — there is no chance that will happen”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 252788
            },
