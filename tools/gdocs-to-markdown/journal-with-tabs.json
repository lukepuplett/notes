              "endIndex": 314751,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 314751,
                    "startIndex": 314730,
                    "textRun": {
                      "content": "A hundred times off.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "green": 1
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 314730
            },
            {
              "endIndex": 314752,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 314752,
                    "startIndex": 314751,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 314751
            },
            {
              "endIndex": 314907,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 314907,
                    "startIndex": 314752,
                    "textRun": {
                      "content": "Musk: “Most people in the AI community don’t yet understand. The intelligence density potential is vastly greater than what we’re currently experiencing.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 314752
            },
            {
              "endIndex": 314908,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 314908,
                    "startIndex": 314907,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 314907
            },
            {
              "endIndex": 315030,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315030,
                    "startIndex": 314908,
                    "textRun": {
                      "content": "Everyone is focused on the hardware race. Bigger data centers. More GPUs. Nuclear power plants built to feed the compute.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 314908
            },
            {
              "endIndex": 315031,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315031,
                    "startIndex": 315030,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315030
            },
            {
              "endIndex": 315057,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315057,
                    "startIndex": 315031,
                    "textRun": {
                      "content": "That’s half the equation.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315031
            },
            {
              "endIndex": 315058,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315058,
                    "startIndex": 315057,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315057
            },
            {
              "endIndex": 315210,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315210,
                    "startIndex": 315058,
                    "textRun": {
                      "content": "Musk: “I think we’re off by two orders of magnitude in terms of intelligence density per gigabyte. That’s just algorithmic improvement. Same computer.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315058
            },
            {
              "endIndex": 315211,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315211,
                    "startIndex": 315210,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315210
            },
            {
              "endIndex": 315286,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315286,
                    "startIndex": 315211,
                    "textRun": {
                      "content": "Read that carefully. Not more hardware. Not more energy. Not more capital.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315211
            },
            {
              "endIndex": 315287,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315287,
                    "startIndex": 315286,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315286
            },
            {
              "endIndex": 315354,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315354,
                    "startIndex": 315287,
                    "textRun": {
                      "content": "The same machine. A hundred times smarter. Through software alone.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315287
            },
            {
              "endIndex": 315355,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315355,
                    "startIndex": 315354,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 315354
            },
            {
              "endIndex": 315418,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 315418,
                    "startIndex": 315355,
                    "textRun": {
                      "content": "That’s before the hardware improvements compound on top of it.\n",
