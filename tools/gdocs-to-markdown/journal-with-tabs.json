                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 10219
            },
            {
              "endIndex": 10440,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 10440,
                    "startIndex": 10220,
                    "textRun": {
                      "content": "HEFEI, China, Feb 5 (Reuters) - Volkswagen (VOWG.DE), plans by 2030 to build most of the vehicles it offers in China on its new electronic architecture platform developed with EV maker Xpeng (9868.HK), the company said.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 10220
            },
            {
              "endIndex": 10441,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 10441,
                    "startIndex": 10440,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 10440
            },
            {
              "endIndex": 10760,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 10760,
                    "startIndex": 10441,
                    "textRun": {
                      "content": "The move is part of its efforts to win back the world's largest auto market. The architecture enables it to develop cars up to 30% faster and 40% cheaper when compared with using the German-developed MEB platform, thanks to centralised control units and increased in-house component production, company officials said.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 10441
            },
