              "endIndex": 131634,
              "paragraph": {
                "bullet": {
                  "listId": "kix.uz4i8xkk50yk",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 131634,
                    "startIndex": 131532,
                    "textRun": {
                      "content": "Bulk/automated delegation for fleets (human delegates to manager agent → manager to many sub-agents).\n",
                      "textStyle": {}
                    }
