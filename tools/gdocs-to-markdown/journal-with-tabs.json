                }
              },
              "startIndex": 50467
            },
            {
              "endIndex": 50599,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50599,
                    "startIndex": 50468,
                    "textRun": {
                      "content": "Gradually unfollowing and usually blocking people who post AI writing passing it off as their own.  Several hundred blocked so far\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50468
            },
            {
              "endIndex": 50600,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50600,
                    "startIndex": 50599,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50599
            },
            {
              "endIndex": 50837,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50837,
                    "startIndex": 50600,
                    "textRun": {
                      "content": "Writing has historically been useful as proof-of-thought. AI writing tends to be proof-of-performing-thought.  These are not the same.  Indeed, the latter tends also to be proof-of-lack-of-thought, and blocking is the appropriate action\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50600
            },
            {
              "endIndex": 50838,
              "paragraph": {
