              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305712,
                    "startIndex": 305665,
                    "textRun": {
                      "content": " smaller today. here's my note to the company.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
