                    "textRun": {
                      "content": "CEO @HyperWriteAI, @OthersideAI, investing via Shumer Capital in @GroqInc @Etched @Rork_App @DaytonaIO @OpenRouterAI + more\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 60827
            },
            {
              "endIndex": 60952,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 60952,
                    "startIndex": 60951,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 60951
            },
            {
              "endIndex": 61049,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61049,
                    "startIndex": 60952,
                    "textRun": {
                      "content": "^ My response was, we're going to need all that AI to handle all the extra work AI will create. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 60952
            },
            {
              "endIndex": 61050,
              "paragraph": {
