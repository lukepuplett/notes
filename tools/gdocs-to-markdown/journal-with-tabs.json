                  {
                    "endIndex": 3340,
                    "startIndex": 3279,
                    "textRun": {
                      "content": "## OpenAI Unsatisfied With Speed of Nvidia Hardware: Reuters\n",
                      "textStyle": {}
                    }
                  }
                ],
