              "paragraph": {
                "elements": [
                  {
                    "endIndex": 141122,
                    "startIndex": 141080,
                    "textRun": {
                      "content": "Silver is now cutting into solar margins.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 141080
            },
