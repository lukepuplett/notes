                "elements": [
                  {
                    "endIndex": 28500,
                    "startIndex": 28455,
                    "textRun": {
                      "content": "Michael Burry implying bearishness on Google\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
