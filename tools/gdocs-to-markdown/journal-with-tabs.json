              "endIndex": 34098,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 34098,
                    "startIndex": 33967,
                    "textRun": {
                      "content": "-ChatGPT will release a much better model trained on NVL72 Blackwell clusters at Microsoft. Sentiment will shift back to ChatGPT. \n",
                      "textStyle": {}
                    }
