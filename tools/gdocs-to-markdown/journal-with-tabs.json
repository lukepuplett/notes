            {
              "endIndex": 89562,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 89562,
                    "startIndex": 89312,
                    "textRun": {
                      "content": "> One of the most interesting aspects of this is to keep asking further exploration questions for the proposed ramifications, e.g. “Low-margin apps that get crushed by the rising cost of API calls” and to ask an AI what might happen if this happens?\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
