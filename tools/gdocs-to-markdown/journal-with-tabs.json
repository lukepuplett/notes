              "endIndex": 61513,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61513,
                    "startIndex": 61512,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61512
            },
            {
              "endIndex": 61557,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61557,
                    "startIndex": 61513,
                    "textRun": {
                      "content": "$300+ oil & Global Depression are possible.\n",
                      "textStyle": {}
                    }
