                  "direction": "LEFT_TO_RIGHT",
                  "headingId": "h.1l0nsxzi4w6",
                  "keepLinesTogether": false,
                  "keepWithNext": false,
                  "lineSpacing": 100,
                  "namedStyleType": "HEADING_2",
                  "spaceAbove": {
                    "unit": "PT"
