              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74689,
                    "startIndex": 74488,
                    "textRun": {
                      "content": "Most people don't do high stakes activities, and accountability is retroactive, a comforter for the boss; AI does not need to 'feel repercussions' to do its best, because it is not a conflicted human.\n",
                      "textStyle": {}
                    }
