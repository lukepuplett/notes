                "elements": [
                  {
                    "endIndex": 12068,
                    "startIndex": 12041,
                    "textRun": {
                      "content": "Removing Hostile Influence:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
                              "red": 0.12156863
                            }
                          }
                        },
