                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36257
            },
            {
              "endIndex": 36408,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36408,
                    "startIndex": 36258,
                    "textRun": {
                      "content": "It felt like momentum. It felt productive. But when they stepped back, they described feeling stretched, busier, and completely unable to disconnect.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36258
            },
            {
              "endIndex": 36409,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36409,
                    "startIndex": 36408,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36408
            },
            {
              "endIndex": 36473,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36473,
                    "startIndex": 36409,
                    "textRun": {
                      "content": "83% said AI increased their workload. Not decreased. Increased.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36409
            },
            {
              "endIndex": 36474,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36474,
                    "startIndex": 36473,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36473
            },
            {
              "endIndex": 36693,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36693,
                    "startIndex": 36474,
                    "textRun": {
                      "content": "62% of associates and 61% of entry-level workers reported burnout. Only 38% of executives felt the same strain. The people doing the actual work absorbed the damage while leadership celebrated the productivity numbers.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36474
            },
            {
              "endIndex": 36694,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36694,
                    "startIndex": 36693,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36693
            },
            {
              "endIndex": 36988,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36988,
                    "startIndex": 36694,
                    "textRun": {
                      "content": "Then came the trap nobody saw coming. When one person uses AI to take on extra work, everyone else feels like they're falling behind. So the whole team speeds up. Nobody formally raises expectations. But the new pace quietly becomes the default. What AI made possible became what was expected.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36694
            },
            {
              "endIndex": 36989,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 36989,
                    "startIndex": 36988,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36988
            },
            {
              "endIndex": 37133,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 37133,
                    "startIndex": 36989,
                    "textRun": {
                      "content": "The researchers gave it a name: workload creep. It looks like productivity at first. Then it becomes the new baseline. Then it becomes burnout.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 36989
            },
            {
              "endIndex": 37134,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 37134,
                    "startIndex": 37133,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 37133
            },
            {
              "endIndex": 37272,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 37272,
                    "startIndex": 37134,
                    "textRun": {
                      "content": "AI was supposed to give you your time back. Instead it's eating more of it. And the worst part? You're doing it to yourself. Voluntarily.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 37134
            },
