                }
              },
              "startIndex": 46500
            },
            {
              "endIndex": 46560,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46560,
                    "startIndex": 46501,
                    "textRun": {
                      "content": "> Another from Vitalik in response to the following tweet:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46501
            },
            {
              "endIndex": 46561,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46561,
                    "startIndex": 46560,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46560
            },
            {
              "endIndex": 46591,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46591,
                    "startIndex": 46561,
                    "textRun": {
                      "content": "Original tweet, Tom Kruise - \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46561
            },
            {
              "endIndex": 46592,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46592,
                    "startIndex": 46591,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46591
            },
            {
              "endIndex": 46612,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46612,
                    "startIndex": 46592,
                    "textRun": {
                      "content": "2026-30 predictions\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46592
            },
            {
              "endIndex": 46613,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46613,
                    "startIndex": 46612,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46612
            },
            {
              "endIndex": 46830,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46830,
                    "startIndex": 46613,
                    "textRun": {
                      "content": "-globalism is dead. resilience is the new god. countries and individuals are racing for sovereign compute and mineral sovereignty. if you can't produce your own energy, food, and intelligence locally, you're a vassal\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46613
            },
            {
              "endIndex": 47030,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47030,
                    "startIndex": 46830,
                    "textRun": {
                      "content": "-the winner in robotics is the company whose humanoids can navigate a messy, 70s built warehouse. general purpose labor becomes a purchasable SKU, starting in logistics and moving toward elderly care\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46830
            },
            {
              "endIndex": 47182,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47182,
                    "startIndex": 47030,
                    "textRun": {
                      "content": "-the west stops moralizing about mining and starts treating lithium, cobalt, and copper with the same ruthless blood for oil energy of the 20th century\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47030
            },
            {
              "endIndex": 47412,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47412,
                    "startIndex": 47182,
                    "textRun": {
                      "content": "-the line between peace and war permanently dissolves. conflict shifts to gray zone operations. constant cyber attrition, undersea cable \"accidents\" and satellite interference. no more grand declarations, just a baseline of chaos\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47182
            },
            {
              "endIndex": 47616,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47616,
                    "startIndex": 47412,
                    "textRun": {
                      "content": "-the internet officially splinters. you now have the \"open web\" (chaotic, bot heavy, western), the \"fortress web\" (highly censored, eastern), and the \"sovereign web\" (encrypted, boutique, and high trust)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47412
            },
            {
              "endIndex": 47817,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47817,
                    "startIndex": 47616,
                    "textRun": {
                      "content": "-neuralink and its competitors move from clinical trials to high performance enhancement for the wealthy. the augmented vs natural cognitive divide begins to show its first cracks in the social fabric\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47616
            },
            {
              "endIndex": 47939,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47939,
                    "startIndex": 47817,
                    "textRun": {
                      "content": "-control over freshwater sources becomes the primary driver of regional skirmishes, replacing traditional border disputes\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47817
            },
            {
              "endIndex": 48124,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 48124,
                    "startIndex": 47939,
                    "textRun": {
                      "content": "-corporations with bigger balance sheets than countries (the big 5) begin negotiating directly with governments for territorial autonomy to host their own data centers and energy grids\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47939
            },
            {
              "endIndex": 48341,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 48341,
                    "startIndex": 48124,
                    "textRun": {
                      "content": "-the alliance between the New Tech Right and traditional populism fractures. SV realizes that nationalism is bad for the global talent flow they need for AGI. they pivot toward techno statehood and local city states.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 48124
            },
            {
              "endIndex": 48427,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 48427,
                    "startIndex": 48341,
                    "textRun": {
                      "content": "-being unreachable is the new wealth. the always-on worker is seen as a low level cog\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 48341
            },
            {
              "endIndex": 48549,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 48549,
                    "startIndex": 48427,
                    "textRun": {
                      "content": "-content with errors, rough edges, and physical presence becomes 10x more valuable than polished, AI generated perfection\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 48427
            },
            {
              "endIndex": 48658,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 48658,
                    "startIndex": 48549,
                    "textRun": {
                      "content": "-the Ivy League degree finally loses its power for good. Proof of Work becomes the only resume that matters \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 48549
            },
            {
              "endIndex": 48801,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 48801,
                    "startIndex": 48658,
                    "textRun": {
                      "content": "-high performers begin taking analog sabbats. deleting all apps for a month to reset dopamine receptors. a requirement for mental elite status\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 48658
            },
            {
              "endIndex": 48948,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 48948,
                    "startIndex": 48801,
                    "textRun": {
                      "content": "-after a year of AI-slop, the low-fi aesthetic wins. grainy film, handwritten notes, and physical gatherings become the only signs of authenticity\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 48801
            },
            {
              "endIndex": 49090,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49090,
                    "startIndex": 48948,
                    "textRun": {
                      "content": "-micro schools and high level apprenticeship guilds replace the bloated university model. learning becomes a high stakes, boutique experience\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 48948
            },
            {
              "endIndex": 49231,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49231,
                    "startIndex": 49090,
                    "textRun": {
                      "content": "-physical neighborhoods begin self organizing around shared values (techno-optimism, homeschooling, fitness, etc) rather than just proximity\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49090
            },
            {
              "endIndex": 49304,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49304,
                    "startIndex": 49231,
                    "textRun": {
                      "content": "-infinite scroll is viewed with the same social stigma as indoor smoking\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49231
            },
            {
              "endIndex": 49450,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49450,
                    "startIndex": 49304,
                    "textRun": {
                      "content": "-massive cultural pivot back to the importance of circadian rhythms, mineral balance, and real world movement as the bio-hacks that actually work\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49304
            },
            {
              "endIndex": 49644,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49644,
                    "startIndex": 49450,
                    "textRun": {
                      "content": "-AI is no longer a tech trend. it’s a national utility like electricity. small, high IQ nations pull ahead by building proprietary national models, while large bureaucracies choke on regulation\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49450
            },
            {
              "endIndex": 49840,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49840,
                    "startIndex": 49644,
                    "textRun": {
                      "content": "-high production value is now synonymous with fake or corporate. the most viral content is raw, unedited, and intentionally flawed. if it looks like it could have been made by an AI, it’s ignored\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49644
            },
            {
              "endIndex": 49841,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49841,
                    "startIndex": 49840,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49840
            },
            {
              "endIndex": 49860,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49860,
                    "startIndex": 49841,
                    "textRun": {
                      "content": "Vitalik subtweet -\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49841
            },
            {
              "endIndex": 49861,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 49861,
                    "startIndex": 49860,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49860
            },
            {
              "endIndex": 50075,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50075,
                    "startIndex": 49861,
                    "textRun": {
                      "content": "I agree with maybe 60% of this, but one bit that is particularly important to highlight is the explicit separation between what the poster calls \"the open web\" (really, the corposlop web), and \"the sovereign web\".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 49861
            },
            {
              "endIndex": 50076,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50076,
                    "startIndex": 50075,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50075
            },
            {
              "endIndex": 50130,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50130,
                    "startIndex": 50076,
                    "textRun": {
                      "content": "https://x.com/tom777kruise/status/2006710624424702362\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50076
            },
            {
              "endIndex": 50131,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50131,
                    "startIndex": 50130,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50130
            },
            {
              "endIndex": 50659,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50659,
                    "startIndex": 50131,
                    "textRun": {
                      "content": "This is a distinction I did not realize until recently, and I must admit the bitcoin maximalists were far ahead: a big part of their resistance to ICOs, tokens other than bitcoin, arbitrary financial applications, etc was precisely about keeping bitcoin \"sovereign\" and not \"corposlop\". The big error that many of them made was trying to achieve this goal with either government crackdowns or user disempowerment (keeping bitcoin script limited, and rejecting many categories of applications entirely), but their fear was real.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50131
            },
            {
              "endIndex": 50660,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50660,
                    "startIndex": 50659,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50659
            },
            {
              "endIndex": 50733,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50733,
                    "startIndex": 50660,
                    "textRun": {
                      "content": "So what is corposlop? In essence, it is the combination of three things:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50660
            },
            {
              "endIndex": 50734,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50734,
                    "startIndex": 50733,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50733
            },
            {
              "endIndex": 50765,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50765,
                    "startIndex": 50734,
                    "textRun": {
                      "content": "* Corporate optimization power\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50734
            },
            {
              "endIndex": 50842,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50842,
                    "startIndex": 50765,
                    "textRun": {
                      "content": "* An aura of respectableness of being a company with sleek polished branding\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50765
            },
            {
              "endIndex": 50941,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50941,
                    "startIndex": 50842,
                    "textRun": {
                      "content": "* Behavior that the exact opposite of respectable, because that's what's needed to maximize profit\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50842
            },
            {
              "endIndex": 50942,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50942,
                    "startIndex": 50941,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50941
            },
            {
              "endIndex": 50974,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50974,
                    "startIndex": 50942,
                    "textRun": {
                      "content": "Corposlop includes things like:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50942
            },
            {
              "endIndex": 50975,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 50975,
                    "startIndex": 50974,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50974
            },
            {
              "endIndex": 51114,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51114,
                    "startIndex": 50975,
                    "textRun": {
                      "content": "* Social media that maximizes dopamine, outrage, other methods of short-term engagement, at the expense of long-term value and fulfillment\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 50975
            },
            {
              "endIndex": 51244,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51244,
                    "startIndex": 51114,
                    "textRun": {
                      "content": "* Needless mass data collection from users, often followed by managing it carelessly or even casually selling it to third parties\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51114
            },
            {
              "endIndex": 51361,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51361,
                    "startIndex": 51244,
                    "textRun": {
                      "content": "* Walled gardens charging monopolistic high fees and actively preventing people from even linking to other platforms\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51244
            },
            {
              "endIndex": 51471,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51471,
                    "startIndex": 51361,
                    "textRun": {
                      "content": "* Hollywood releasing the 7th sequel to some tired franchise, because that's the most risk-averse thing to do\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51361
            },
            {
              "endIndex": 51662,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51662,
                    "startIndex": 51471,
                    "textRun": {
                      "content": "* Every corporation that rallied around slogans of diversity and equity and the need to overturn society to fight racism in 2020, and then publicly mocked those causes for engagement in 2025\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51471
            },
            {
              "endIndex": 51663,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51663,
                    "startIndex": 51662,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51662
            },
            {
              "endIndex": 51767,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51767,
                    "startIndex": 51663,
                    "textRun": {
                      "content": "This is all digital corposlop; there are big and important analogues to this in the physical world too.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51663
            },
            {
              "endIndex": 51768,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51768,
                    "startIndex": 51767,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51767
            },
            {
              "endIndex": 51937,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51937,
                    "startIndex": 51768,
                    "textRun": {
                      "content": "Corposlop is soulless: trend-following homogeneity that is both evil and lame https://vitalik.eth.limo/general/2025/12/30/balance_of_power.html#how-we-fear-big-business\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51768
            },
            {
              "endIndex": 51938,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 51938,
                    "startIndex": 51937,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51937
            },
            {
              "endIndex": 52020,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52020,
                    "startIndex": 51938,
                    "textRun": {
                      "content": "These are things that appear to serve the user, but actually disempower the user.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 51938
            },
            {
              "endIndex": 52021,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52021,
                    "startIndex": 52020,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52020
            },
            {
              "endIndex": 52581,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52524,
                    "startIndex": 52021,
                    "textRun": {
                      "content": "I have many qualms with Apple, but aside from their monopolistic practices, they actually have many non-corposlop traits. They serve users not by constantly asking \"what do users want this quarter\", but by having an opinionated long-term vision. They have a strong emphasis on privacy. They resist and create trends rather than following them. I just wish they could take the brave step of ending their monopolistic practices and switch to an open source first strategy. It may damage their market cap, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 52581,
                    "startIndex": 52524,
                    "textRun": {
                      "content": "but man must live for something higher than market caps.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52021
            },
            {
              "endIndex": 52582,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52582,
                    "startIndex": 52581,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52581
            },
            {
              "endIndex": 52875,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52875,
                    "startIndex": 52582,
                    "textRun": {
                      "content": "Zac from Aztec was also early to recognize the importance of this, with a post that is on the whole very pro-freedom, but at the same time does not shrink back from labeling what is essentially corposlop a primary enemy, even when it does not violate the libertarian non-aggression principle.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52582
            },
            {
              "endIndex": 52876,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52876,
                    "startIndex": 52875,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52875
            },
            {
              "endIndex": 52927,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52927,
                    "startIndex": 52876,
                    "textRun": {
                      "content": "https://x.com/Zac_Aztec/status/1986086241276657868\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52876
            },
            {
              "endIndex": 52928,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52928,
                    "startIndex": 52927,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52927
            },
            {
              "endIndex": 53364,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53364,
                    "startIndex": 52928,
                    "textRun": {
                      "content": "In 2000, the understanding of \"sovereignty\" largely focused on avoiding the iron fist of government. Today, \"sovereignty\" also means securing your digital privacy through cryptography, and securing your own mind from corporate mind warfare trying to extract your attention and your dollars. It also means doing things because you believe in them, and declaring independence from the homogenizing and soul-sucking concept of \"the meta\".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 52928
            },
            {
              "endIndex": 53365,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53365,
                    "startIndex": 53364,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53364
            },
            {
              "endIndex": 53442,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53442,
                    "startIndex": 53365,
                    "textRun": {
                      "content": "These are the kinds of tools that we should build more of. Build tools like:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53365
            },
            {
              "endIndex": 53443,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53443,
                    "startIndex": 53442,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53442
            },
            {
              "endIndex": 53549,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53445,
                    "startIndex": 53443,
                    "textRun": {
                      "content": "* ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 53488,
                    "startIndex": 53445,
                    "textRun": {
                      "content": "Privacy-preserving local-first applications",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 53549,
                    "startIndex": 53488,
                    "textRun": {
                      "content": " that minimize dependence on and data leaks to third parties\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53443
            },
            {
              "endIndex": 53550,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53550,
                    "startIndex": 53549,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53549
            },
            {
              "endIndex": 53702,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53702,
                    "startIndex": 53550,
                    "textRun": {
                      "content": "* Social media platforms and tools that let the user take control of what content they see. Appeal to people's long-term goals, not short-term impulses\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53550
            },
            {
              "endIndex": 53703,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53703,
                    "startIndex": 53702,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53702
            },
            {
              "endIndex": 53850,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53705,
                    "startIndex": 53703,
                    "textRun": {
                      "content": "* ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 53754,
                    "startIndex": 53705,
                    "textRun": {
                      "content": "Financial tools that help users grow their wealth",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 53850,
                    "startIndex": 53754,
                    "textRun": {
                      "content": ", and do not encourage 50x leverage or sports betting or taking out a loan to pay for a burrito\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53703
            },
            {
              "endIndex": 53851,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53851,
                    "startIndex": 53850,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53850
            },
            {
              "endIndex": 54090,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 53902,
                    "startIndex": 53851,
                    "textRun": {
                      "content": "* AI tools that are maximally open and privacy and ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 53916,
                    "startIndex": 53902,
                    "textRun": {
                      "content": "local-friendly",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 54090,
                    "startIndex": 53916,
                    "textRun": {
                      "content": ", and that maximize productivity from merging the power of human and bot, rather than encouraging the user to sit back and let the bot do all the work, so they learn nothing\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 53851
            },
            {
              "endIndex": 54091,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 54091,
                    "startIndex": 54090,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54090
            },
            {
              "endIndex": 54245,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 54245,
                    "startIndex": 54091,
                    "textRun": {
                      "content": "* Applications, companies, and physical environments that take an opinionated view on the kind of world they want to see, and have an opinionated culture\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54091
            },
            {
              "endIndex": 54246,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 54246,
                    "startIndex": 54245,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54245
            },
            {
              "endIndex": 54459,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 54248,
                    "startIndex": 54246,
                    "textRun": {
                      "content": "* ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 54415,
                    "startIndex": 54248,
                    "textRun": {
                      "content": "DAOs that can support organizations and communities that steadfastly pursue a unique objective, and do not all get captured by the same groups. Privacy-preserving and ",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 54444,
                    "startIndex": 54415,
                    "textRun": {
                      "content": "non-tokenholder-driven voting",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9098039,
                              "green": 0.77254903,
                              "red": 0.62352943
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 54459,
                    "startIndex": 54444,
                    "textRun": {
                      "content": " can help here\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54246
            },
            {
              "endIndex": 54460,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 54460,
                    "startIndex": 54459,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54459
            },
            {
              "endIndex": 54514,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 54514,
                    "startIndex": 54460,
                    "textRun": {
                      "content": "Be sovereign. Reject corposlop. Believe in somETHing.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54460
            },
            {
              "endIndex": 54515,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 54515,
                    "startIndex": 54514,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54514
            },
            {
              "endIndex": 55024,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55024,
                    "startIndex": 54515,
                    "textRun": {
                      "content": "^ This is anti-stakeholder capitalism. The problem he does not address is the conspiracy of aligned incentives. By using the term corporation, he doesn’t have to wrangle with the intractable root cause which is individual actors in an operating environment of aligned incentives. One reply points out that the masses also have their incentives and generally don’t share these cares, just want convenience. It takes two to tango. Convenience meets pay maximalisation, and both run within a status seeking ego.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 54515
            },
            {
              "endIndex": 55025,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55025,
                    "startIndex": 55024,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55024
            },
            {
              "endIndex": 55027,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55027,
                    "startIndex": 55025,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55025
            },
            {
              "endIndex": 55028,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55028,
                    "startIndex": 55027,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55027
            },
            {
              "endIndex": 55076,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55076,
                    "startIndex": 55028,
                    "textRun": {
                      "content": "> My personal thoughts on EU and DSA to friend:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55028
            },
            {
              "endIndex": 55077,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55077,
                    "startIndex": 55076,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55076
            },
            {
              "endIndex": 55257,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55257,
                    "startIndex": 55077,
                    "textRun": {
                      "content": "The problem is that the EU cannot stop making rules. As such they have slid into irrelevance in the age of the web. It is now weak and risks aggression and abandonment by the USA.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55077
            },
            {
              "endIndex": 55258,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55258,
                    "startIndex": 55257,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55257
            },
            {
              "endIndex": 55514,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55514,
                    "startIndex": 55258,
                    "textRun": {
                      "content": "That’s the cost of all this. It has played out since broadband internet, my whole life, and its descent is not stopping. Narcissist bureaucrats don’t step down willingly, and so it will slide until something breaks. We are all impoverished by the decline.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55258
            },
            {
              "endIndex": 55515,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55515,
                    "startIndex": 55514,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55514
            },
            {
              "endIndex": 55675,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55675,
                    "startIndex": 55515,
                    "textRun": {
                      "content": "The ultimate problem is that so many Europeans are not just boiling frogs but indoctrinated and disbelieving of those calling out the temperature of the water.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55515
            },
            {
              "endIndex": 55676,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55676,
                    "startIndex": 55675,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55675
            },
            {
              "endIndex": 55795,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55795,
                    "startIndex": 55676,
                    "textRun": {
                      "content": "On the free speech aspect, any legislation that attempts to encode what is and is not ‘proper’ information is suspect.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55676
            },
            {
              "endIndex": 55796,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 55796,
                    "startIndex": 55795,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55795
            },
            {
              "endIndex": 56235,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 56235,
                    "startIndex": 55796,
                    "textRun": {
                      "content": "I’d support a bill of measures that specifically target bot farms and provide users the information to better judge messages. Also a good thing would be to strengthen laws or audit around reporting of MAUs in financial reports and to advertisers, since it is incentives that drive all human activity and politicians would do better to study game design. Right now, it is not in the interests of platforms to admit to Dead Internet Theory.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 55796
            },
            {
              "endIndex": 56236,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 56236,
                    "startIndex": 56235,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 56235
            },
            {
              "endIndex": 56412,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 56412,
                    "startIndex": 56236,
                    "textRun": {
                      "content": "In general I am averse to eternal, big batch laws since they’re often trojan horses and their perverse impacts cannot be felt for a long time and then they cannot be reversed.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 56236
            },
            {
              "endIndex": 56413,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 56413,
                    "startIndex": 56412,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 56412
            },
            {
              "endIndex": 56445,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 56445,
                    "startIndex": 56413,
                    "textRun": {
                      "content": "Small laws of limited lifetime.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 56413
            },
