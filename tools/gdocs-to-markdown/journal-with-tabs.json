              "startIndex": 117484
            },
            {
              "endIndex": 117843,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117843,
                    "startIndex": 117811,
                    "textRun": {
                      "content": "Merchants of learned complexity\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
