                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5300
            },
            {
              "endIndex": 5366,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5366,
                    "startIndex": 5301,
                    "textRun": {
                      "content": "Everyone talks about models. Nobody talks about the scaffolding.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5301
            },
            {
              "endIndex": 5367,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5367,
                    "startIndex": 5366,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5366
            },
            {
              "endIndex": 5661,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5661,
                    "startIndex": 5367,
                    "textRun": {
                      "content": "The companies shipping the best AI agents today- Claude Code, Cursor, Manus, Devin, SWE-Agent all converge on the same architecture: a deliberately simple loop wraps the model, a handful of primitive tools give it hands, and the scaffolding decides what information reaches the model and when.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5367
            },
            {
              "endIndex": 5662,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5662,
                    "startIndex": 5661,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5661
            },
            {
              "endIndex": 5720,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5720,
                    "startIndex": 5662,
                    "textRun": {
                      "content": "The model is interchangeable. The harness is the product.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5662
            },
