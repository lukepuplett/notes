                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 81338
            },
            {
              "endIndex": 81522,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 81522,
                    "startIndex": 81392,
                    "textRun": {
                      "content": "All the capital being spent and lent by the richest companies on earth will not buy enough time-by the very definition of mania. \n",
