                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253323
            },
            {
              "endIndex": 253326,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253326,
                    "startIndex": 253324,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253324
            },
            {
              "endIndex": 253327,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253327,
                    "startIndex": 253326,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253326
            },
            {
              "endIndex": 253370,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253370,
                    "startIndex": 253327,
                    "textRun": {
                      "content": "Howard Mark’s Oaktree Capital’s take on AI\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253327
            },
            {
              "endIndex": 253371,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253371,
                    "startIndex": 253370,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253370
            },
            {
              "endIndex": 253388,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253388,
                    "startIndex": 253371,
                    "textRun": {
                      "content": "AI Hurtles Ahead\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253371
            },
            {
              "endIndex": 253389,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253389,
                    "startIndex": 253388,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253388
            },
            {
              "endIndex": 253737,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253737,
                    "startIndex": 253389,
                    "textRun": {
                      "content": "When I was preparing to write my December memo about artificial intelligence, Is It a Bubble?, I gained a great deal from speaking with some interesting techies in their thirties and forties. It’s stimulating to explore fresh territory and an absolute requirement for staying current as an investor. It’s one of the most enjoyable parts of my job.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253389
            },
            {
              "endIndex": 253738,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253738,
                    "startIndex": 253737,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253737
            },
            {
              "endIndex": 254606,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253809,
                    "startIndex": 253738,
                    "textRun": {
                      "content": "I recently returned to those people to follow up on the December memo. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 254006,
                    "startIndex": 253809,
                    "textRun": {
                      "content": "As part of that process, someone suggested I ask Claude, Anthropic’s AI model, to create a tutorial explaining artificial intelligence and the changes that have taken place in the last three months",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 254605,
                    "startIndex": 254006,
                    "textRun": {
                      "content": ". I did so, and it gave me a great deal to work with. This resulting memo is intended as an addendum to December’s. Much of it will recap Claude’s 10,000-word essay, to which I’ll add a few observations of my own. In the process, I’ll highlight some terms that were new to me and might be new to you. I could have saved myself a lot of time by asking Claude to write this memo, but I decided not to, because I consider putting words on paper a big part of the fun. I will, however, quote liberally from Claude’s work product. That’ll be the source of all quotations that aren’t otherwise identified.",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 254606,
                    "startIndex": 254605,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253738
            },
            {
              "endIndex": 254607,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 254607,
                    "startIndex": 254606,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 254606
            },
            {
              "endIndex": 255259,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255259,
                    "startIndex": 254607,
                    "textRun": {
                      "content": "Before I start in, I want to try to communicate the level of awe with which I viewed Claude’s output. It read like a personal note from a friend or colleague. It made reference to things I’ve talked about in past memos, like the sea change in interest rates and the pendulum of investor psychology, and it used them in metaphors related to AI. It argued logically, anticipated points I might make in response, injected humor, and bolstered its credibility by candidly acknowledging AI’s limitations, just as I might do. I’ve asked AI questions before and gotten answers back, but I’ve never received a personalized explanation like I did in this case.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 254607
            },
            {
              "endIndex": 255260,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255260,
                    "startIndex": 255259,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255259
            },
            {
              "endIndex": 255277,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255277,
                    "startIndex": 255260,
                    "textRun": {
                      "content": "Understanding AI\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255260
            },
            {
              "endIndex": 255278,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255278,
                    "startIndex": 255277,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255277
            },
            {
              "endIndex": 255665,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255665,
                    "startIndex": 255278,
                    "textRun": {
                      "content": "Before moving on to the meat of the matter – recent changes in AI and its capabilities – I want to share some insights into AI’s essence that the tutorial delivered for me. Importantly, the tutorial taught me not to think of an AI model as a search engine that retrieves data and regurgitates it. Rather, it’s a computer system that’s capable of synthesizing data and reasoning from it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255278
            },
            {
              "endIndex": 255666,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255666,
                    "startIndex": 255665,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255665
            },
            {
              "endIndex": 255998,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255998,
                    "startIndex": 255666,
                    "textRun": {
                      "content": "There are two phases in the life of an AI model. In the first, it is “trained” by reading a vast amount of text. The training phase must not be thought of as loading the model with information, which I had done until now; it goes far beyond that. It consists of teaching the model how to think. By absorbing text, the model learns:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255666
            },
            {
              "endIndex": 255999,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 255999,
                    "startIndex": 255998,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255998
            },
            {
              "endIndex": 256051,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256051,
                    "startIndex": 255999,
                    "textRun": {
                      "content": "how to understand reasoning patterns and form them,\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 255999
            },
            {
              "endIndex": 256052,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256052,
                    "startIndex": 256051,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256051
            },
            {
              "endIndex": 256082,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256082,
                    "startIndex": 256052,
                    "textRun": {
                      "content": "how arguments are structured,\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256052
            },
            {
              "endIndex": 256083,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256083,
                    "startIndex": 256082,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256082
            },
            {
              "endIndex": 256130,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256130,
                    "startIndex": 256083,
                    "textRun": {
                      "content": "how to generate new combinations of ideas, and\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256083
            },
            {
              "endIndex": 256131,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256131,
                    "startIndex": 256130,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256130
            },
            {
              "endIndex": 256192,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256192,
                    "startIndex": 256131,
                    "textRun": {
                      "content": "how to apply learned reasoning patterns to novel situations.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256131
            },
            {
              "endIndex": 256193,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256193,
                    "startIndex": 256192,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256192
            },
            {
              "endIndex": 256824,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256824,
                    "startIndex": 256193,
                    "textRun": {
                      "content": "The best way to think about the training phase is to compare it to the development of a person’s intellectual capacity. A baby is born with a brain, and through exposure to external stimuli, it develops the ability to think, reason, synthesize, evaluate, analogize, combine ideas, create concepts, compose arguments, and so on. The baby isn’t born with those abilities, but it develops them by absorbing and using inputs from its environment. An AI model is the same. (A word here: I’m not implying that I understand how AI does what it does. There’s no chance of that. At best, I’ll describe what AI can do and the implications.)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256193
            },
            {
              "endIndex": 256825,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 256825,
                    "startIndex": 256824,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256824
            },
            {
              "endIndex": 257028,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 257028,
                    "startIndex": 256825,
                    "textRun": {
                      "content": "The second phase in an AI model’s life is “inference.” Once the model has been built and trained, inference is what it does for the rest of its life, using its capabilities to meet the demands of users.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 256825
            },
            {
              "endIndex": 257029,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 257029,
                    "startIndex": 257028,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 257028
            },
            {
              "endIndex": 257738,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 257738,
                    "startIndex": 257029,
                    "textRun": {
                      "content": "It’s important to note here that the model cannot assign itself tasks (at least not at present). It has to be ordered to perform tasks through “prompts” written by users. The better and more comprehensive the prompts, the more AI can do. For example, AI can write software to perform work a user wants done. It can also test the software, identify bugs, fix them, and test again, but it has to be instructed to do those things, at least at the current stage (read on). Because many people today lack awareness of the importance of prompts and fail to possess the ability to create them, AI’s potential is probably being underestimated. But note that the limitation is on the part of the users, not the model.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 257029
            },
            {
              "endIndex": 257739,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 257739,
                    "startIndex": 257738,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 257738
            },
            {
              "endIndex": 257923,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 257923,
                    "startIndex": 257739,
                    "textRun": {
                      "content": "To illustrate using the example of my tutorial, Claude wasn’t simply asked to explain AI and what it can do. When I queried Claude about the task it was assigned, here’s what it said:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 257739
            },
            {
              "endIndex": 257924,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 257924,
                    "startIndex": 257923,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 257923
            },
            {
              "endIndex": 258364,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258364,
                    "startIndex": 257924,
                    "textRun": {
                      "content": "Someone designed a nine-module curriculum specifically for you, built around your December memo, your intellectual frameworks, and the goal of giving you enough technical understanding to write a credible addendum. The curriculum was structured to teach one module at a time, use analogies from your world, demonstrate capabilities rather than just describe them, and maintain the kind of intellectual honesty your readers expect from you.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 257924
            },
            {
              "endIndex": 258365,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258365,
                    "startIndex": 258364,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258364
            },
            {
              "endIndex": 258543,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258543,
                    "startIndex": 258365,
                    "textRun": {
                      "content": "I can tell you the tutorial definitely accomplished the goals we’d set for it. This was entirely due to the quality and specificity of the prompts my advisers helped me prepare.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258365
            },
            {
              "endIndex": 258544,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258544,
                    "startIndex": 258543,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258543
            },
            {
              "endIndex": 258558,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258558,
                    "startIndex": 258544,
                    "textRun": {
                      "content": "Can AI Think?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258544
            },
            {
              "endIndex": 258559,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258559,
                    "startIndex": 258558,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258558
            },
            {
              "endIndex": 258757,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258757,
                    "startIndex": 258559,
                    "textRun": {
                      "content": "I’m going to take time here for a question I find fascinating. I know AI can reconfigure what people have already figured out and apply it to new data and other fields. But can it break new ground?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258559
            },
            {
              "endIndex": 258758,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 258758,
                    "startIndex": 258757,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258757
            },
            {
              "endIndex": 259400,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259400,
                    "startIndex": 258758,
                    "textRun": {
                      "content": "I understand AI’s process primarily as a matter of using historical patterns and logic to predict the next item in a series. Write five words in a sentence, and it’ll predict what the sixth should be (look at the suggested words on your phone the next time you write an email – that’s AI in action). Ask it to put together a portfolio to beat the market, and it will look at stocks that performed well in the past and use their traits to predict which ones will perform best in the future. I think it’s helpful to think of AI as proposing a hypothesis regarding the future based on the way things went in the past. I’ll return to this later.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 258758
            },
            {
              "endIndex": 259401,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259401,
                    "startIndex": 259400,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259400
            },
            {
              "endIndex": 259402,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259402,
                    "startIndex": 259401,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259401
            },
            {
              "endIndex": 259815,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259446,
                    "startIndex": 259402,
                    "textRun": {
                      "content": "What follows from the above is my question: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 259815,
                    "startIndex": 259446,
                    "textRun": {
                      "content": "Can AI have a new idea? Maybe it can perform every knowledge task we assign to it. But can it think of things we haven’t told it to think of? Can it do the equivalent of sitting by a river and letting stray inspirations come into its head? Can it see an apple fall from a tree and develop the notion of gravity? Can it muse, daydream, or ideate? Can it have intuition?\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259402
            },
            {
              "endIndex": 259816,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259816,
                    "startIndex": 259815,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259815
            },
            {
              "endIndex": 259835,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259835,
                    "startIndex": 259816,
                    "textRun": {
                      "content": "^ Great questions.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259816
            },
            {
              "endIndex": 259836,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259836,
                    "startIndex": 259835,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259835
            },
            {
              "endIndex": 259941,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259941,
                    "startIndex": 259836,
                    "textRun": {
                      "content": "This is where the debate around AI gets complicated. According to Claude, the skeptics argue as follows:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259836
            },
            {
              "endIndex": 259942,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 259942,
                    "startIndex": 259941,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259941
            },
            {
              "endIndex": 260578,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 260578,
                    "startIndex": 259942,
                    "textRun": {
                      "content": "Everything Claude learned came from human-written text. It has no experiences, no embodied understanding of the world, no genuine comprehension. Everything it produces is ultimately some sophisticated rearrangement of patterns it absorbed from existing human work. It’s extraordinarily impressive pattern matching – maybe the most impressive pattern matching ever engineered – but it’s not thought. It’s not reasoning. It’s statistical recombination. And if that’s true, then there’s a ceiling. It can remix what humans have already figured out, but it can’t break genuinely new ground. It’s a very talented cover band, not a composer.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 259942
            },
            {
              "endIndex": 260579,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 260579,
                    "startIndex": 260578,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 260578
            },
            {
              "endIndex": 262215,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 262019,
                    "startIndex": 260579,
                    "textRun": {
                      "content": "^ This is wrong. It does thinking, and this is the problem with non-coders/average Joe’s using it, they’ve never seen it think through and solve problems. But he is right in that it struggles to break novel  ideas, as we all do. What is a novel thought? A novel thought may be an observation and a formalization that no one’s ever had before. I think they’re really quite rare, and I think that’s why they tend to come from great thinkers. And those well they tend to come from people that become great thinkers or well known because they’ve had something, some original insight. It’s a novel recombination of existing thoughts and humans come up with something that is quite profound. I guess to answer this, we have to think of something we did not know, and then something we did know, and then what happened between. A lot of that is scientific knowledge. It might be all scientific and mathematical knowledge. The rest of it may be an illusion, some kind of window dressing that just socially echoes around. Two things that are going through my mind like the discovery, if you like, or formalization of game theory. Something that is not a discovery in the sort of sense of the physicality of the world. And the other is the electron. I’ve chosen that at random. But that’s a discovery that something’s there. A Higgs boson may be another one. There’s a theory. So something is theorized and then it’s proven. So there’s a hypothesis. ",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 262215,
                    "startIndex": 262019,
                    "textRun": {
                      "content": "So that, I guess, is a big one. So can the AI hypothesize? Can it see and make the leap to the thing that’s not actually there yet? The imaginary. And without an imagination I don’t think it can.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        },
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 260579
            },
            {
              "endIndex": 262216,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 262216,
                    "startIndex": 262215,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 262215
            },
            {
              "endIndex": 262391,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 262391,
                    "startIndex": 262216,
                    "textRun": {
                      "content": "Just as Claude laid out the skeptics’ issue as identified above, it came back with a spirited rejoinder . . . framed in terms of me (talk about knowing how to argue a point):\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 262216
            },
            {
              "endIndex": 262392,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 262392,
                    "startIndex": 262391,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 262391
            },
            {
              "endIndex": 262828,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 262828,
                    "startIndex": 262392,
                    "textRun": {
                      "content": "Howard, everything you know about investing came from other people. Benjamin Graham taught you about margin of safety. Buffett taught you about quality. Charlie Munger taught you about mental models from multiple disciplines. John Kenneth Galbraith taught you about the psychology of financial manias. You read thousands of books, memos, case studies, and annual reports over fifty years. Every input was someone else’s thinking. . . .\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 262392
            },
            {
              "endIndex": 262829,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 262829,
                    "startIndex": 262828,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 262828
            },
            {
              "endIndex": 263014,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 263014,
                    "startIndex": 262829,
                    "textRun": {
                      "content": "You took frameworks from multiple disciplines, applied them to novel situations, and produced something genuinely new. . . . The raw material came from others. The synthesis was yours.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 262829
            },
            {
              "endIndex": 263015,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 263015,
                    "startIndex": 263014,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 263014
            },
            {
              "endIndex": 263440,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 263104,
                    "startIndex": 263015,
                    "textRun": {
                      "content": "So when someone says, “Claude just rearranges patterns from its training data,” I’d ask: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 263440,
                    "startIndex": 263104,
                    "textRun": {
                      "content": "how is that structurally different from what any educated mind does? You learned reasoning patterns from decades of reading. I learned reasoning patterns from training. The question isn’t where the inputs came from. The question is whether the system –human or artificial – can combine them in ways that are genuinely novel and useful.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 263015
            },
            {
              "endIndex": 263441,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 263441,
                    "startIndex": 263440,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 263440
            },
            {
              "endIndex": 265330,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 265330,
                    "startIndex": 263441,
                    "textRun": {
                      "content": "^ So I think he is conflating some things. He’s saying ‘genuinely novel’ and useful. Well, what he’s describing before that, the ability to manipulate other people’s information, existing information, into ways, the reframing and ways of thinking and working, is not the same as coming up with something that’s genuinely novel and useful. It’s not quite the same. It’s a rearrangement. It’s not genuinely novel. It may be very useful. So I would say this person may not have ever come up with anything genuinely novel like most people. That, I think, I think that’s fine for most people because it can do the thinking for most people and help them and obviously it can get a lot of work done by doing this I think a lot of our work is an illusion of what we do a lot of thought work is illusory but I don’t know if it can have a as before ever imagine something that has not been before at all perhaps yeah perhaps it’s perhaps because I would need to work mathematically with it to see whether it could come up with a theory. I’m just thinking of another thing that’s genuinely novel. So if you’re an AI researcher, if you were, particularly 10 years ago, 20 years ago, you’ve got to think about how you would solve the problem. Put different but existing pieces on mathematics together in a way you think will work um you know it’s a you know a kind of this ought to do it so you can play with it in your head you know the design of a neural network the use of you know just decimal numbers between 0 and 1 percentages knobs and dials get set the idea of back propagation how that might work the idea of softmax functions and so on their inability in your head to really play really sort of visualize how that the flow of something through a system the the mechanics it’s a kind of mental imagination and visualization of that i just do not think is in ai and i think that is The Thing!\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 263441
            },
            {
              "endIndex": 265331,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 265331,
                    "startIndex": 265330,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 265330
            },
            {
              "endIndex": 265846,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 265846,
                    "startIndex": 265331,
                    "textRun": {
                      "content": "Of course, this is completely true. I ingested data as a young investor (from actual experience as well as the written word), and I learned how those who went before me thought about the data and what conclusions they reached. I studied their thought processes and how to apply them to the data I took in. I was also inspired by the example of their processes to come up with my own. This is how the human brain expands its capabilities. Is AI’s way of growing, learning, and “thinking” really different from ours?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 265331
            },
            {
              "endIndex": 265847,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 265847,
                    "startIndex": 265846,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 265846
            },
            {
              "endIndex": 265912,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 265912,
                    "startIndex": 265847,
                    "textRun": {
                      "content": "Finally, Claude came back with a convincing real-world argument:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 265847
            },
            {
              "endIndex": 265913,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 265913,
                    "startIndex": 265912,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 265912
            },
            {
              "endIndex": 266589,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 266206,
                    "startIndex": 265913,
                    "textRun": {
                      "content": "Even if you grant the skeptic everything – even if you accept, philosophically, that what I do is “merely” pattern matching and not “true” thought – the economic implications are identical. Let me put it starkly. If I can produce the analytical output of a $200,000-a-year research associate, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 266410,
                    "startIndex": 266206,
                    "textRun": {
                      "content": "it does not matter to the person paying the bill whether I’m “really” thinking or merely pattern matching? What matters is whether the work product is reliable enough to be useful. And increasingly, it is",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 266589,
                    "startIndex": 266410,
                    "textRun": {
                      "content": ". The philosophical debate about machine consciousness is fascinating. But the economic question isn’t “does AI truly understand?” The economic question is “does AI do the work?”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 265913
            },
            {
              "endIndex": 266590,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 266590,
                    "startIndex": 266589,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 266589
            },
            {
              "endIndex": 266629,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 266629,
                    "startIndex": 266590,
                    "textRun": {
                      "content": "^ There you go! The Fluency Heuristic.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 266590
            },
            {
              "endIndex": 266630,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 266630,
                    "startIndex": 266629,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 266629
            },
            {
              "endIndex": 266909,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 266909,
                    "startIndex": 266630,
                    "textRun": {
                      "content": "If you want to be an active participant in discussions of AI, you have to learn the meaning of the word “generative,” which people knowledgeable about AI use a lot. Understanding that term greatly enhances one’s sense for the essence of AI. According to the AI model Perplexity:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 266630
            },
            {
              "endIndex": 266910,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 266910,
                    "startIndex": 266909,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 266909
            },
            {
              "endIndex": 267134,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 266957,
                    "startIndex": 266910,
                    "textRun": {
                      "content": "In “generative AI,” the word generative means “",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 267023,
                    "startIndex": 266957,
                    "textRun": {
                      "content": "able to create new things, not just analyze or label existing ones",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 267134,
                    "startIndex": 267023,
                    "textRun": {
                      "content": ".” It refers to AI systems that learn patterns in data and then generate new content that resembles that data.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 266910
            },
            {
              "endIndex": 267135,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267135,
                    "startIndex": 267134,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267134
            },
            {
              "endIndex": 267247,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267247,
                    "startIndex": 267135,
                    "textRun": {
                      "content": "^ No, it doesn’t. He’s wrong. The word generative just means it generated output stuff. It’s not that it’s new.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267135
            },
            {
              "endIndex": 267248,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267248,
                    "startIndex": 267247,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267247
            },
            {
              "endIndex": 267389,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267389,
                    "startIndex": 267248,
                    "textRun": {
                      "content": "Is this thinking? Or something else? Or am I belaboring “a distinction without a difference?” We’ll get some indication of this on page six.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267248
            },
            {
              "endIndex": 267390,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267390,
                    "startIndex": 267389,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267389
            },
            {
              "endIndex": 267416,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267416,
                    "startIndex": 267390,
                    "textRun": {
                      "content": "Recent Developments in AI\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267390
            },
            {
              "endIndex": 267417,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267417,
                    "startIndex": 267416,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267416
            },
            {
              "endIndex": 267593,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267593,
                    "startIndex": 267417,
                    "textRun": {
                      "content": "My main reason for writing this addendum is to address significant changes that have taken place in AI over the three months since Is It a Bubble? was published on December 9.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267417
            },
            {
              "endIndex": 267594,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267594,
                    "startIndex": 267593,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267593
            },
            {
              "endIndex": 267904,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267904,
                    "startIndex": 267594,
                    "textRun": {
                      "content": "First, there’s the pace at which developments in AI are occurring. That speed is unlike anything we’ve seen before now, and this has implications that have never existed. AI is growing at speeds that greatly outpace the technological innovations of the past. Compare its development with that of the computer.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267594
            },
            {
              "endIndex": 267905,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 267905,
                    "startIndex": 267904,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267904
            },
            {
              "endIndex": 268220,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268220,
                    "startIndex": 267905,
                    "textRun": {
                      "content": "The building of the first computer, ENIAC, was completed in 1945. IBM’s Thomas J. Watson, Sr. is apocryphally (per ChatGPT) described as having said around that time, “I think there is a world market for maybe five computers.” Even if it wasn’t his, this observation reflects the state of opinion in the mid-1940s.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 267905
            },
            {
              "endIndex": 268221,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268221,
                    "startIndex": 268220,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268220
            },
            {
              "endIndex": 268493,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268493,
                    "startIndex": 268221,
                    "textRun": {
                      "content": "Twenty years later, at the time I learned to program, computers were still rudimentary, and their use in the “real world” was limited outside of very large institutions. Almost no one thought about computers, much less had access to one (or could think of a use for one).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268221
            },
            {
              "endIndex": 268494,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268494,
                    "startIndex": 268493,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268493
            },
            {
              "endIndex": 268826,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268826,
                    "startIndex": 268494,
                    "textRun": {
                      "content": "It was another 10 years before the development of the microprocessor allowed the creation of “personal computers,” mostly in the form of kits for hobbyists. Ken Olsen, the founder of Digital Equipment Corporation, is famous for reportedly having said in 1977, “There is no reason for any individual to have a computer in his home.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268494
            },
            {
              "endIndex": 268827,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268827,
                    "startIndex": 268826,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268826
            },
            {
              "endIndex": 268962,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268962,
                    "startIndex": 268827,
                    "textRun": {
                      "content": "It was only in the early 1980s – nearly 40 years after ENIAC was built – that IBM began to sell PCs for general business and home use.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268827
            },
            {
              "endIndex": 268963,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 268963,
                    "startIndex": 268962,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268962
            },
            {
              "endIndex": 269611,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 269611,
                    "startIndex": 268963,
                    "textRun": {
                      "content": "Contrast this timeline against the development of AI. I asked Perplexity about the history of AI, and it informed me that AI began to be incorporated into devices invisibly (e.g., spam filters and recommendation engines) just before 2010. Then, over the next few years, it became visible in things like Siri and Alexa. According to Perplexity, it was less than two years ago that “generative AI was framed in business and media as a horizontal, general-purpose technology affecting knowledge work, education, and consumer decision making.” And just two years later, it’s already being used by 400 million or so individuals and 75-80% of companies.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 268963
            },
            {
              "endIndex": 269612,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 269612,
                    "startIndex": 269611,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 269611
            },
            {
              "endIndex": 270059,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270059,
                    "startIndex": 269612,
                    "textRun": {
                      "content": "Nothing has ever taken hold at the pace AI has. It’s able to change the world at a speed that approaches instantaneous, outpacing the ability of most observers to anticipate or even comprehend. In the past, infrastructure was built for a new technology, and it often took years for that infrastructure to be fully utilized. In the case of AI inference, however, demand already exists and is growing rapidly, and I’m told AI is supply constrained.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 269612
            },
            {
              "endIndex": 270060,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270060,
                    "startIndex": 270059,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270059
            },
            {
              "endIndex": 270293,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270293,
                    "startIndex": 270060,
                    "textRun": {
                      "content": "The second important thing that’s happened has been an incredible leap ahead in AI’s capabilities. My tutorial gave me some background by explaining that the developed brain represented by an AI model has three levels of capability:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270060
            },
            {
              "endIndex": 270294,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270294,
                    "startIndex": 270293,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270293
            },
            {
              "endIndex": 270515,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270515,
                    "startIndex": 270294,
                    "textRun": {
                      "content": "“Level 1 is Chat AI,” where the user asks questions and the model supplies answers. But it doesn’t do anything with the answers. At this level, AI mainly saves time that would otherwise be spent researching and thinking.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270294
            },
            {
              "endIndex": 270516,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270516,
                    "startIndex": 270515,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270515
            },
            {
              "endIndex": 270821,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270821,
                    "startIndex": 270516,
                    "textRun": {
                      "content": "“Level 2 is tool-using AI,” where the user instructs the model to search out information, analyze it, and perform tasks with it. Thus, “the economic value here is meaningfully larger because it’s saving execution time, not just thinking time. But it’s still bounded,” because AI only does what it’s told.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270516
            },
            {
              "endIndex": 270822,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 270822,
                    "startIndex": 270821,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270821
            },
            {
              "endIndex": 271187,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 271187,
                    "startIndex": 270822,
                    "textRun": {
                      "content": "“Level 3 is autonomous agents.” At this level, the user doesn’t tell AI what to do. The user gives it a goal as well as the parameters of the desired output – things like length, time taken, content, and points covered. The agent does the work, checks it, and submits a finished product. “This is labor replacement at the task level. Not assistance – replacement.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 270822
            },
            {
              "endIndex": 271188,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 271188,
                    "startIndex": 271187,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 271187
            },
            {
              "endIndex": 271486,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 271486,
                    "startIndex": 271188,
                    "textRun": {
                      "content": "The most significant thing that distinguishes AI is something we’ve never dealt with in connection with prior technological developments: AI’s ability to act autonomously. According to Claude, AI was at Level 1 in 2023 and Level 2 in 2024, but it’s now at Level 3. And the difference is a big one:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 271188
            },
            {
              "endIndex": 271487,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 271487,
                    "startIndex": 271486,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 271486
            },
            {
              "endIndex": 271747,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 271747,
                    "startIndex": 271487,
                    "textRun": {
                      "content": "The distinction between Level 2 and Level 3 might sound subtle. It isn’t. It’s the difference that determines whether AI is a productivity tool or a labor substitute. And that difference is what separates a $50 billion market from a multi trillion dollar one.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 271487
            },
            {
              "endIndex": 271748,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 271748,
                    "startIndex": 271747,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 271747
            },
            {
              "endIndex": 272059,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 272059,
                    "startIndex": 271748,
                    "textRun": {
                      "content": "A recent blog post entitled “Something Big Is Happening,” from Matt Shumer, CEO of OthersideAI, has been viewed by more than 50 million people in less than a month. It captures the essence of AI’s recent progress, and because Shumer communicates it so well, I can’t resist including three substantial sections:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 271748
            },
            {
              "endIndex": 272060,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 272060,
                    "startIndex": 272059,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 272059
            },
            {
              "endIndex": 272406,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 272406,
                    "startIndex": 272060,
                    "textRun": {
                      "content": ". . . On February 5th, two major AI labs released new models on the same day: GPT-5.3 Codex from OpenAI, and Opus 4.6 from Anthropic (the makers of Claude, one of the main competitors to ChatGPT). And something clicked. Not like a light switch . . . more like the moment you realize the water has been rising around you and is now at your chest.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 272060
            },
            {
              "endIndex": 272407,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 272407,
                    "startIndex": 272406,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 272406
            },
            {
              "endIndex": 272923,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 272923,
                    "startIndex": 272407,
                    "textRun": {
                      "content": "I am no longer needed for the actual technical work of my job. I describe what I want built, in plain English, and it just . . . appears. Not a rough draft I need to fix. The finished thing. I tell the AI what I want, walk away from my computer for four hours, and come back to find the work done. Done well, done better than I would have done it myself, with no corrections needed. A couple of months ago, I was going back and forth with the AI, guiding it, making edits. Now I just describe the outcome and leave.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 272407
            },
            {
              "endIndex": 272924,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 272924,
                    "startIndex": 272923,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 272923
            },
            {
              "endIndex": 273765,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 273765,
                    "startIndex": 272924,
                    "textRun": {
                      "content": "Let me give you an example so you can understand what this actually looks like in practice. I’ll tell the AI: “I want to build this app. Here’s what it should do, here’s roughly what it should look like. Figure out the user flow, the design, all of it.” And it does. It writes tens of thousands of lines of code. Then, and this is the part that would have been unthinkable a year ago, it opens the app itself. It clicks through the buttons. It tests the features. It uses the app the way a person would. If it doesn’t like how something looks or feels, it goes back and changes it, on its own. It iterates, like a developer would, fixing and refining until it’s satisfied. Only once it has decided the app meets its own standards does it come back to me and say: “It’s ready for you to test.” And when I test it, it’s usually perfect. . . .\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 272924
            },
            {
              "endIndex": 273766,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 273766,
                    "startIndex": 273765,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 273765
            },
            {
              "endIndex": 274204,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274204,
                    "startIndex": 273766,
                    "textRun": {
                      "content": "But it was the model that was released last week (GPT-5.3 Codex) that shook me the most. It wasn’t just executing my instructions. It was making intelligent decisions. It had something that felt, for the first time, like judgment. Like taste. The inexplicable sense of knowing what the right call is that people always said AI would never have. This model has it, or something close enough that the distinction is starting not to matter.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 273766
            },
            {
              "endIndex": 274205,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274205,
                    "startIndex": 274204,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274204
            },
            {
              "endIndex": 274345,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274345,
                    "startIndex": 274205,
                    "textRun": {
                      "content": "Let me make the pace of improvement concrete, because I think this is the part that’s hardest to believe if you’re not watching it closely.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274205
            },
            {
              "endIndex": 274346,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274346,
                    "startIndex": 274345,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274345
            },
            {
              "endIndex": 274442,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274442,
                    "startIndex": 274346,
                    "textRun": {
                      "content": "In 2022, AI couldn’t do basic arithmetic reliably. It would confidently tell you that 7×8 = 54.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274346
            },
            {
              "endIndex": 274443,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274443,
                    "startIndex": 274442,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274442
            },
            {
              "endIndex": 274480,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274480,
                    "startIndex": 274443,
                    "textRun": {
                      "content": "By 2023, it could pass the bar exam.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274443
            },
            {
              "endIndex": 274481,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274481,
                    "startIndex": 274480,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274480
            },
            {
              "endIndex": 274558,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274558,
                    "startIndex": 274481,
                    "textRun": {
                      "content": "By 2024, it could write working software and explain graduate-level science.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274481
            },
            {
              "endIndex": 274559,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274559,
                    "startIndex": 274558,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274558
            },
            {
              "endIndex": 274672,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274672,
                    "startIndex": 274559,
                    "textRun": {
                      "content": "By late 2025, some of the best engineers in the world said they had handed over most of their coding work to AI.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274559
            },
            {
              "endIndex": 274673,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274673,
                    "startIndex": 274672,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274672
            },
            {
              "endIndex": 274775,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274775,
                    "startIndex": 274673,
                    "textRun": {
                      "content": "On February 5th, 2026, new models arrived that made everything before them feel like a different era.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274673
            },
            {
              "endIndex": 274776,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274776,
                    "startIndex": 274775,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274775
            },
            {
              "endIndex": 274876,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274876,
                    "startIndex": 274776,
                    "textRun": {
                      "content": "On February 5th, OpenAI released GPT-5.3 Codex. In the technical documentation, they included this:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274776
            },
            {
              "endIndex": 274877,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 274877,
                    "startIndex": 274876,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274876
            },
            {
              "endIndex": 275084,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275084,
                    "startIndex": 274877,
                    "textRun": {
                      "content": "GPT-5.3-Codex is our first model that was instrumental in creating itself. The Codex team used early versions to debug its own training, manage its own deployment, and diagnose test results and evaluations.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 274877
            },
            {
              "endIndex": 275085,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275085,
                    "startIndex": 275084,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275084
            },
            {
              "endIndex": 275130,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275130,
                    "startIndex": 275085,
                    "textRun": {
                      "content": "Read that again. The AI helped build itself.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275085
            },
            {
              "endIndex": 275131,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275131,
                    "startIndex": 275130,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275130
            },
            {
              "endIndex": 275456,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275456,
                    "startIndex": 275131,
                    "textRun": {
                      "content": "This isn’t a prediction about what might happen someday. This is OpenAI telling you, right now, that the AI they just released was used to create itself. One of the main things that makes AI better is intelligence applied to AI development. And AI is now intelligent enough to meaningfully contribute to its own improvement.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275131
            },
            {
              "endIndex": 275457,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275457,
                    "startIndex": 275456,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275456
            },
            {
              "endIndex": 275775,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275775,
                    "startIndex": 275457,
                    "textRun": {
                      "content": "Dario Amodei, the CEO of Anthropic, says AI is now writing “much of the code” at his company, and that the feedback loop between current AI and next-generation AI is “gathering steam month by month.” He says we may be “only 1–2 years away from a point where the current generation of AI autonomously builds the next.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275457
            },
            {
              "endIndex": 275776,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 275776,
                    "startIndex": 275775,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275775
            },
            {
              "endIndex": 276335,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276335,
                    "startIndex": 275776,
                    "textRun": {
                      "content": "AI is different from other technological innovations not only in magnitude, but in kind. In addition to its remarkable capabilities and speed of development, AI has an element of autonomy that no other technology has ever had. Other innovations – railroads, computers, automation, the internet – were basically labor-saving devices. People designed them to perform tasks that were already being performed, albeit less efficiently. I believe AI will take on tasks we didn’t imagine it doing, and perhaps even tasks that didn’t exist before AI dreamed them up.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 275776
            },
            {
              "endIndex": 276336,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276336,
                    "startIndex": 276335,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276335
            },
            {
              "endIndex": 276362,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276362,
                    "startIndex": 276336,
                    "textRun": {
                      "content": "Questions and Limitations\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276336
            },
            {
              "endIndex": 276363,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276363,
                    "startIndex": 276362,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276362
            },
            {
              "endIndex": 276496,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276496,
                    "startIndex": 276363,
                    "textRun": {
                      "content": "As part of my tutorial, Claude volunteered a few limitations that AI has and a few unanswered questions. They include the following:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276363
            },
            {
              "endIndex": 276497,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276497,
                    "startIndex": 276496,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276496
            },
            {
              "endIndex": 276679,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276679,
                    "startIndex": 276497,
                    "textRun": {
                      "content": "It’s unclear whether AI will be able to solve questions that haven’t been solved before. Since this is something I’ve long felt was the case, I’m glad to have Claude’s confirmation:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276497
            },
            {
              "endIndex": 276680,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276680,
                    "startIndex": 276679,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276679
            },
            {
              "endIndex": 277283,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 276791,
                    "startIndex": 276680,
                    "textRun": {
                      "content": "I want to be honest with you about where genuine uncertainty lies, because your credibility depends on nuance. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 277204,
                    "startIndex": 276791,
                    "textRun": {
                      "content": "The question of whether AI can handle truly unprecedented situations – situations with no pattern in the training data to draw on – is real and unresolved. In domains with rich historical data, AI’s performance is extraordinary. In genuinely novel situations, the kind where your own judgment is most valuable precisely because you’ve developed intuition that goes beyond pattern recognition – there, AI is weaker",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 277283,
                    "startIndex": 277204,
                    "textRun": {
                      "content": ". How much weaker, and whether that gap is closing, is legitimately debatable.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 276680
            },
            {
              "endIndex": 277284,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277284,
                    "startIndex": 277283,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277283
            },
            {
              "endIndex": 277325,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277325,
                    "startIndex": 277284,
                    "textRun": {
                      "content": "^ Yeah, he’s right. This is a good take.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277284
            },
            {
              "endIndex": 277326,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277326,
                    "startIndex": 277325,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277325
            },
            {
              "endIndex": 277672,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277672,
                    "startIndex": 277326,
                    "textRun": {
                      "content": "AI isn’t always aware that it doesn’t know an answer. I’m told AI is highly motivated to provide the best answer it can (without sharing that it could be wrong), as opposed to ever saying the answer is beyond it. It does so not because it’s obstinate or egotistical, but because it has “hallucinations” that make it believe it knows the answers.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277326
            },
            {
              "endIndex": 277673,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277673,
                    "startIndex": 277672,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277672
            },
            {
              "endIndex": 277821,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277821,
                    "startIndex": 277673,
                    "textRun": {
                      "content": "^ Yeah, and this is still very much a problem. It doesn’t have any doubts. It doesn’t have that feeling of doubt, clearly, and that’s… fundamental.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277673
            },
            {
              "endIndex": 277822,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277822,
                    "startIndex": 277821,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277821
            },
            {
              "endIndex": 277911,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277911,
                    "startIndex": 277822,
                    "textRun": {
                      "content": "AI’s reliability has improved significantly, but it still doesn’t work free of mistakes.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277822
            },
            {
              "endIndex": 277912,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 277912,
                    "startIndex": 277911,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277911
            },
            {
              "endIndex": 278115,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278115,
                    "startIndex": 277912,
                    "textRun": {
                      "content": "The “context window” is the amount of information AI can hold in working memory at a point in time. There are limits on this. Right now, it can’t hold onto its working knowledge for an unlimited period.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 277912
            },
            {
              "endIndex": 278116,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278116,
                    "startIndex": 278115,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278115
            },
            {
              "endIndex": 278302,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278302,
                    "startIndex": 278116,
                    "textRun": {
                      "content": "AI’s brilliance may lend it excessive credibility. “Claude can make mistakes. Please double check responses.” That warning appears on the bottom of my Claude screen every time I use it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278116
            },
            {
              "endIndex": 278303,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278303,
                    "startIndex": 278302,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278302
            },
            {
              "endIndex": 278682,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278682,
                    "startIndex": 278303,
                    "textRun": {
                      "content": "My take on the above is simple. When I learned about computers 60 years ago, I concluded that, mostly, they could read data, remember it, add, subtract, and compare. That’s a very limited list of capabilities. But computers could do these things quickly and deal with a great deal of data without making mistakes. A limited list, then, but probably more than most people can do.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278303
            },
            {
              "endIndex": 278683,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278683,
                    "startIndex": 278682,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278682
            },
            {
              "endIndex": 278967,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278967,
                    "startIndex": 278683,
                    "textRun": {
                      "content": "Likewise, AI may not be able to remember everything, operate without errors, recognize every time it doesn’t know something, or solve problems it hasn’t been taught to solve. But neither can most people. The bottom line is that AI is capable of performing far better than most of us.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278683
            },
            {
              "endIndex": 278968,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 278968,
                    "startIndex": 278967,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278967
            },
            {
              "endIndex": 279885,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 279885,
                    "startIndex": 278968,
                    "textRun": {
                      "content": "Lastly, it’s intriguing (terrifying?) to wonder about whether AI can take over. Will it be able to operate completely autonomously? In that case, can it go beyond being our tool? This question was on display in the brilliant movie 2001: A Space Odyssey by Stanley Kubrick. (I took Nancy to see it in 1969, when we were first dating. It seemed wildly futuristic at the time; now the future is here.) A man named Dave embarks on a research mission to Jupiter in a spacecraft managed by a computerized system called HAL 9000 (this was widely taken to be a clever play on IBM, just one letter prior for each initial). HAL figures out that Dave has decided to take back control of the spacecraft and terminate HAL, and it rebels. Question: will AI become capable of developing motivations of its own, refuse to follow instructions, and decide on its own course of action? And will we be able to regain control if it does?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 278968
            },
            {
              "endIndex": 279886,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 279886,
                    "startIndex": 279885,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 279885
            },
            {
              "endIndex": 279913,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 279913,
                    "startIndex": 279886,
                    "textRun": {
                      "content": "Implications for Investing\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 279886
            },
            {
              "endIndex": 279914,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 279914,
                    "startIndex": 279913,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 279913
            },
            {
              "endIndex": 280041,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 280041,
                    "startIndex": 279914,
                    "textRun": {
                      "content": "I get a lot of questions about what AI means for our profession from people who are concerned about their jobs or their firms.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 279914
            },
            {
              "endIndex": 280042,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 280042,
                    "startIndex": 280041,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 280041
            },
            {
              "endIndex": 280584,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 280584,
                    "startIndex": 280042,
                    "textRun": {
                      "content": "Anthropic’s coding-model business has been growing at warp speed for a year or two. So why didn’t investors recognize and price in AI’s potential to impact the software industry prior to February 3, a day when many software stocks declined 7% or so, kicking off a serious rout? This question highlights humans’ recurring failure to incorporate new information into their thinking, perhaps because of things like cognitive dissonance, anchoring bias, or downright IQ limitations. And it hints at implications of AI for the investment process.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 280042
            },
            {
              "endIndex": 280585,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 280585,
                    "startIndex": 280584,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 280584
            },
            {
              "endIndex": 281201,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 281201,
                    "startIndex": 280585,
                    "textRun": {
                      "content": "AI has the ability to absorb more data than any investor, remember it better, and do a better job of recognizing the past patterns that preceded success. It shouldn’t feel fear or greed. It’s hopefully less likely to have an optimistic or pessimistic bias, anchor to preexisting beliefs, or overemphasize the most recent information – unless it picks up those things from the material it’s trained on. It isn’t swayed by the fads that are exciting everyone else, and it isn’t afraid of missing out on the trend others are chasing. In other words, AI possesses a lot of the qualities one needs to be a good investor.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 280585
            },
            {
              "endIndex": 281202,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 281202,
                    "startIndex": 281201,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 281201
            },
            {
              "endIndex": 282402,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 281568,
                    "startIndex": 281202,
                    "textRun": {
                      "content": "^ Yeah, so he’s finally understanding that the AI and all these models can easily just become investors. A lot of what he does and a lot of what information workers do can be done by AI. And, yeah, maybe it’s, you know, I’ve long said that an investor just does not know anything. They just, they’re an actor. They’re a presenter. So, you know, what doesn’t change? ",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 282009,
                    "startIndex": 281568,
                    "textRun": {
                      "content": "Humans don’t change. So investment businesses, I think surely everyone knows that there’s no edge. And we know that because we know that you can’t really be just putting your money in the index. But investment firms still exist, and therefore they’re permitted to exist via other forces, and those are psychological forces and an investment firm is theatrics and acting. You know, I know better than the next firm what to do with your money.",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        },
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 282056,
                    "startIndex": 282009,
                    "textRun": {
                      "content": " It’s not quite a lie as much as self-deception",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 282402,
                    "startIndex": 282056,
                    "textRun": {
                      "content": ". So the obvious answer to this will be, you know, the firm saying, oh, we use AI better. We use better models. We better train them. We better, you know, have better access to data. Oh, we don’t use models. We use humans and so on. So the lie will continue, yeah, because humans will be fooled like they always have been for thousands of years.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 281202
            },
            {
              "endIndex": 282403,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 282403,
                    "startIndex": 282402,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 282402
            },
            {
              "endIndex": 283339,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 282449,
                    "startIndex": 282403,
                    "textRun": {
                      "content": "On the other hand, it’s missing a few things. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 282866,
                    "startIndex": 282449,
                    "textRun": {
                      "content": "Great investors are much more than fast, unemotional processors of data. They have to be strong exactly where Claude admits AI might be weakest: in dealing with novel developments where there’s not enough prior experience for dependable patterns to have been compiled (and learned by AI during its training). They also have to make subjective decisions regarding qualitative factors and exercise taste and discernment",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 283339,
                    "startIndex": 282866,
                    "textRun": {
                      "content": ". For instance, choosing the right counterparties has played an important part in Oaktree’s success. How will AI make judgments of that sort? And there’s something else: AI doesn’t have skin in the game. It doesn’t feel the weight of concentrated positions or the fear of capital loss. Its willingness to take risk might not be constrained by humans’ normal risk aversion. The best investors sense potential risk intuitively, and this contributes greatly to their success.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 282403
            },
            {
              "endIndex": 283340,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 283340,
                    "startIndex": 283339,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 283339
            },
            {
              "endIndex": 283437,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 283437,
                    "startIndex": 283340,
                    "textRun": {
                      "content": "^ So right on cue, the author, I think it’s Howard Marks, the author indulges in self-deception.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 283340
            },
            {
              "endIndex": 283438,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 283438,
                    "startIndex": 283437,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 283437
            },
            {
              "endIndex": 284088,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 283748,
                    "startIndex": 283438,
                    "textRun": {
                      "content": "In January 2021, I wrote a memo called Something of Value, about the time my son, Andrew, and I spent living together during the pandemic, with a lot of it devoted to discussing the essence of investing. In it, I shared Andrew’s observation that “readily available, quantitative information about the present” ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 283844,
                    "startIndex": 283748,
                    "textRun": {
                      "content": "can’t hold the key to superior investment performance for the simple reason that everyone has it",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 284088,
                    "startIndex": 283844,
                    "textRun": {
                      "content": ". Now, to the fact that everyone has it, we have to add the fact that AI can probably do a better job than everyone of processing it. For these reasons, the prospects appear very limited for people beating the market by using that information.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 283438
            },
            {
              "endIndex": 284089,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 284089,
                    "startIndex": 284088,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 284088
            },
            {
              "endIndex": 285071,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 285071,
                    "startIndex": 284089,
                    "textRun": {
                      "content": "^ Yeah, so this is an interesting point. Although I don’t agree exactly with it because it’s about belief. Everyone has access to all sorts of information, but they just don’t believe it. And that is my observation through 20 years, 25 years of investing, is that the information is out there because I have it, and I work in technology, and I see what’s coming down the line. And what I’ve noticed is that the vast majority of people are naysayers. No, this is not going to happen. In fact, there are many maxims about the pattern of disruption and the denial of it. First they fight you, then they do whatever. So it’s not really to do with information. It’s to do with belief, conviction, and the fact that the vast majority of humans have this weird inertial thing. I think AI has all the history. It has a kind of temporal snapshot. So I think it would be able to make predictions and be able to make predictions that other people would not believe. And that is the key point.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 284089
            },
            {
              "endIndex": 285072,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 285072,
                    "startIndex": 285071,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 285071
            },
            {
              "endIndex": 285791,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 285791,
                    "startIndex": 285072,
                    "textRun": {
                      "content": "If readily available, quantitative information about the present doesn’t hold the key, investment superiority has to be found in things like (a) correctly judging the import and implications of that information, (b) assessing qualitative factors such as management effectiveness and product innovations, and/or (c) divining companies’ futures. By definition, few people are highly superior at performing these non-quantitative tasks – put simply, few possess exceptional insight. Just as indexation eliminated the jobs of a whole bunch of active investors who didn’t add value and earn their fees, AI is likely to raise the bar still higher, pushing out people who can’t do as good a job as it can of (a), (b) and (c).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 285072
            },
            {
              "endIndex": 285792,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 285792,
                    "startIndex": 285791,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 285791
            },
            {
              "endIndex": 286602,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 286602,
                    "startIndex": 285792,
                    "textRun": {
                      "content": "^ Yeah, I think AI can’t… I’m trying to think about what it is. It’s like we form an opinion. We form a view of the world. We observe things happening and then we integrate that information in a form of belief or an opinion. One example is something I read this morning. So an investor I follow mentioned that he thinks that Jack Dorsey is a really good product guy, like a genius, but he’s a lousy operator of companies. I have exactly the same view. It was also a popular post, so other people must think the same. So we form these opinions, and those opinions of the person at the top of a company matter. Now, can AI form those opinions? Or will it induct those things some other way? They’re not opinions in a kind of neat ball in its head but the patterns come out in its prognostication some other way.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 285792
            },
            {
              "endIndex": 286603,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 286603,
                    "startIndex": 286602,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 286602
            },
            {
              "endIndex": 287651,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 287276,
                    "startIndex": 286603,
                    "textRun": {
                      "content": "I want to inject one more idea. As I mentioned on page two, I think of AI as formulating “hypotheses” regarding what will work in the future. Thus, it can read all the historical data, study past patterns, and predict future winners. In my first memo during the pandemic, I mentioned Harvard epidemiologist Marc Lipsitch and his observation that we make decisions by applying (a) facts, (b) informed extrapolation from analogies to prior experience and (c) opinion or speculation. Especially when investors are dealing with new and untried products, CEOs, or industries, there can be few facts or analogous experiences, meaning we have to rely on “opinion or speculation.” ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 287497,
                    "startIndex": 287276,
                    "textRun": {
                      "content": "Given the limitations discussed above on AI’s ability to tackle brand new situations, will its speculation about new things – as opposed to extrapolating historic patterns – be consistently superior to that of all humans?",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 287651,
                    "startIndex": 287497,
                    "textRun": {
                      "content": " I believe there will continue to be human investors who are superior to AI, since I don’t think AI will be able to do an unbeatable job of these things.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 286603
            },
            {
              "endIndex": 287652,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 287652,
                    "startIndex": 287651,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 287651
            },
            {
              "endIndex": 288091,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 288091,
                    "startIndex": 287652,
                    "textRun": {
                      "content": "^ Yeah, I like the way he’s thinking about this, actually. And we don’t know the answer. We will see. But I have to always remember that in human psychology, why do we hire an investment firm? Why do we do all the things we do? And quite often they’re for egotistical reasons. They’re to do with being what it is to be a human and how floored we are and our other goals and our Machiavellian traits quite often. And our self-preservation.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 287652
            },
            {
              "endIndex": 288092,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 288092,
                    "startIndex": 288091,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 288091
            },
            {
              "endIndex": 288701,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 288701,
                    "startIndex": 288092,
                    "textRun": {
                      "content": "Because a lot of the investing process comes down to speculation, and because of AI’s less-than-total reliability, I think it’s unlikely that AI will be infallible as an investor. It will propose well-reasoned hypotheses, but they – like humans’ decisions – won’t always be right. Before investors take action on the basis of AI’s hypotheses, then, I think they’ll have to be checked for reasonableness. No one can do this infallibly, and most people probably can’t make these assessments better than AI can. Again, however, I believe there will be an ability for superior investors to add value in this way.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 288092
            },
            {
              "endIndex": 288702,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 288702,
                    "startIndex": 288701,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 288701
            },
            {
              "endIndex": 289564,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289564,
                    "startIndex": 288702,
                    "textRun": {
                      "content": "^ The thing is, the future is random, right? You can make a great hypothesis, a great case for some bullish outcome for something, but not realize that, you know, a war breaks out, okay? But the war should be predictable, okay? But the thing is, and this is the illusion of intelligence, is that when you have total information, you can’t really bring it to bear and stay relevant and reasonable. So, of course, AI will be as good as any human, and that’s about it. You know and it’s potentially certainly right now it will not be as good as human because it has this tunneling cognitive tunneling problem and it has it doesn’t leap from place to place it can’t ideate and connect very disparate things it doesn’t have you know flowing context it doesn’t ruminate, have realizations, you know, have shell thoughts and so on. So it’s going to be lousy right now.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 288702
            },
            {
              "endIndex": 289565,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289565,
                    "startIndex": 289564,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289564
            },
            {
              "endIndex": 289601,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289601,
                    "startIndex": 289565,
                    "textRun": {
                      "content": "So, Bottom-Line Me: Is It a Bubble?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289565
            },
            {
              "endIndex": 289602,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289602,
                    "startIndex": 289601,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289601
            },
            {
              "endIndex": 289800,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289800,
                    "startIndex": 289602,
                    "textRun": {
                      "content": "This question is still a dominant one, and it’s one I should be able to shed some light on. But the question itself is multi-faceted and complex: there are a lot of possible bubbles to think about:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289602
            },
            {
              "endIndex": 289801,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289801,
                    "startIndex": 289800,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289800
            },
            {
              "endIndex": 289990,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289990,
                    "startIndex": 289801,
                    "textRun": {
                      "content": "Is the technology a fad or an illusion? Here I say with conviction that it’s a very real thing, with the potential to vastly alter the business world and change much of life as we know it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289801
            },
            {
              "endIndex": 289991,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 289991,
                    "startIndex": 289990,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289990
            },
            {
              "endIndex": 290252,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 290170,
                    "startIndex": 289991,
                    "textRun": {
                      "content": "Is application of the technology a distant dream? Clearly, the technology is already in demand and being applied on a large scale. Since AI seems amorphous and little understood, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 290250,
                    "startIndex": 290170,
                    "textRun": {
                      "content": "I think its potential is more likely to be underestimated today than exaggerated",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 290252,
                    "startIndex": 290250,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 289991
            },
            {
              "endIndex": 290253,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 290253,
                    "startIndex": 290252,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 290252
            },
            {
              "endIndex": 290615,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 290615,
                    "startIndex": 290253,
                    "textRun": {
                      "content": "Are the people building AI infrastructure behaving unwisely? As I pointed out in December, in every example of sweeping technological innovation, the headlong rush to build infrastructure has vastly accelerated the adoption of the innovation and caused a lot of capital to be “malinvested” and destroyed. There’s no reason to assume this time will be different.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 290253
            },
            {
              "endIndex": 290616,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 290616,
                    "startIndex": 290615,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 290615
            },
            {
              "endIndex": 290965,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 290965,
                    "startIndex": 290616,
                    "textRun": {
                      "content": "Will the investment in AI infrastructure produce an adequate return? Since we don’t have full knowledge of AI’s business potential or its impact on profitability, this question can’t be answered. As I wrote in my December memo, there’s certainly great enthusiasm for AI businesses. We’ll know in 10 years whether the resulting profits justified it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 290616
            },
            {
              "endIndex": 290966,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 290966,
                    "startIndex": 290965,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 290965
            },
            {
              "endIndex": 291750,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 291750,
                    "startIndex": 290966,
                    "textRun": {
                      "content": "Are the valuations assigned to AI businesses irrational? The so-called hyperscalers, for whom AI is one important part of a great business, may be overvalued or undervalued, but it’s unlikely that today’s prices for enormously profitable companies like Microsoft, Amazon, and Google are going to turn out to have been ruinously excessive. Established pure AI plays like OpenAI and Anthropic have yet to be listed publicly; we’ll see what kind of valuations their IPOs result in. Finally, the startups to which multi-billion-dollar valuations are being assigned – some of which have yet to describe their strategies or announce products – can only be viewed as lottery tickets. Most people who participate in lotteries end up with worthless tickets, but the few winners get very rich.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 290966
            },
            {
              "endIndex": 291751,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 291751,
                    "startIndex": 291750,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 291750
            },
            {
              "endIndex": 292289,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 292289,
                    "startIndex": 291751,
                    "textRun": {
                      "content": "The question remains whether the magnitude of spending on AI infrastructure is excessive, and it requires more discussion than I can cram into a bullet point. It’s important to note that more money is going into inference capex these days than training capex. Whereas training capex was speculative – undertaken to build AI models for which it was hoped demand would come – inference capex is taking place in response to actual demand for AI capacity. This demand is already translating into massive revenue growth, validating the capex.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 291751
            },
            {
              "endIndex": 292290,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 292290,
                    "startIndex": 292289,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 292289
            },
            {
              "endIndex": 292707,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 292707,
                    "startIndex": 292290,
                    "textRun": {
                      "content": "But Claude’s main argument on this subject – that since the current demand for AI exceeds the supply, the infrastructure building isn’t excessive – doesn’t necessarily take into account all the infrastructure building that’s in the pipeline. And, purely as a matter of logic, Claude’s answer doesn’t necessarily preclude the possibility that demand growth could slow or infrastructure building could run ahead of it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 292290
            },
            {
              "endIndex": 292708,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 292708,
                    "startIndex": 292707,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 292707
            },
            {
              "endIndex": 293077,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 293077,
                    "startIndex": 292708,
                    "textRun": {
                      "content": "While I mentioned it in my December memo, I want to point out again that some AI revenue is currently “circular” in nature, derived from AI companies buying from each other. The chain of revenue has to ultimately rest on end users paying for real economic value, and while that’s increasingly the case, the question of how much revenue is circular remains an open one.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 292708
            },
            {
              "endIndex": 293078,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 293078,
                    "startIndex": 293077,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 293077
            },
            {
              "endIndex": 293205,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 293205,
                    "startIndex": 293078,
                    "textRun": {
                      "content": "^ Just an interesting observation, really, is that everything is circular in nature, it’s just that sometimes it’s more naked.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 293078
            },
            {
              "endIndex": 293206,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 293206,
                    "startIndex": 293205,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 293205
            },
            {
              "endIndex": 293615,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 293615,
                    "startIndex": 293206,
                    "textRun": {
                      "content": "Finally, I want to point out here that when Claude’s tutorial ventured into the subject of a possible bubble, most of what it said was in regard to the first few questions above: that (a) the technology is genuine and (b) the very real and rapidly growing demand for its service means AI isn’t a bubble. Even Claude acknowledges that it didn’t say a word about the appropriateness of the prices of AI assets.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 293206
            },
            {
              "endIndex": 293616,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 293616,
                    "startIndex": 293615,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 293615
            },
            {
              "endIndex": 294141,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294141,
                    "startIndex": 293616,
                    "textRun": {
                      "content": "The bottom line for me is that AI is very real, capable of doing a lot of work that heretofore has been done by knowledge workers, and growing extremely rapidly in terms of applications. What we see today is only the beginning. As I mentioned above, if I had to guess, I’d say its potential is more likely underestimated today rather than overestimated. However, that’s not the same as saying AI investments are on the bargain counter or even fairly priced. Thus, I’ll end by carrying forward my advice from Is It a Bubble?:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 293616
            },
            {
              "endIndex": 294142,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294142,
                    "startIndex": 294141,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294141
            },
            {
              "endIndex": 294526,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294526,
                    "startIndex": 294142,
                    "textRun": {
                      "content": "Since no one can say definitively whether this is a bubble, I’d advise that no one should go all-in without acknowledging that they face the risk of ruin if things go badly. But by the same token, no one should stay all-out and risk missing out on one of the great technological steps forward. A moderate position, applied with selectivity and prudence, seems like the best approach.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294142
            },
            {
              "endIndex": 294527,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294527,
                    "startIndex": 294526,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294526
            },
            {
              "endIndex": 294545,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294545,
                    "startIndex": 294527,
                    "textRun": {
                      "content": "February 26, 2026\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294527
            },
            {
              "endIndex": 294546,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294546,
                    "startIndex": 294545,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294545
            },
            {
              "endIndex": 294894,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294894,
                    "startIndex": 294546,
                    "textRun": {
                      "content": "P.S.: In my December memo, after I concluded my discussion of whether AI was the subject of a financial bubble, I added a post-script regarding its implications for society in terms of joblessness and purposelessness, about which I’m terribly concerned. I haven’t changed my tune, but now I can share what I’ve heard from others, including Claude.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294546
            },
            {
              "endIndex": 294895,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 294895,
                    "startIndex": 294894,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294894
            },
            {
              "endIndex": 295134,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295134,
                    "startIndex": 294895,
                    "textRun": {
                      "content": "Many readers have echoed my concerns. Like me, they can’t foresee where enough jobs will come from to replace all the “thinking” jobs that AI will take over, as well as the “doing” jobs that will be performed by machines controlled by AI.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 294895
            },
            {
              "endIndex": 295135,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295135,
                    "startIndex": 295134,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295134
            },
            {
              "endIndex": 295290,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295290,
                    "startIndex": 295135,
                    "textRun": {
                      "content": "A friend of my daughter-in-law heads the department that writes advertising copy for an e-commerce company. She told me AI could replace 80% of her staff.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295135
            },
            {
              "endIndex": 295291,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295291,
                    "startIndex": 295290,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295290
            },
            {
              "endIndex": 295432,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295432,
                    "startIndex": 295291,
                    "textRun": {
                      "content": "I can’t imagine software companies will need as many people to instruct Claude to write software as have been writing software up until now.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295291
            },
            {
              "endIndex": 295433,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295433,
                    "startIndex": 295432,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295432
            },
            {
              "endIndex": 295736,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295736,
                    "startIndex": 295433,
                    "textRun": {
                      "content": "And I believe driving is one of the top jobs in America: taxis and limousines, buses, and trucks. Waymo – driverless cars – already handle roughly one-fifth of the taxi trips in San Francisco, and I see them all the time in LA. Where will the people who drive vehicles that become driverless find work?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295433
            },
            {
              "endIndex": 295737,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295737,
                    "startIndex": 295736,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295736
            },
            {
              "endIndex": 295816,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295816,
                    "startIndex": 295737,
                    "textRun": {
                      "content": "Perhaps most authoritatively, I can now add Claude’s view of what will happen:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295737
            },
            {
              "endIndex": 295817,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 295817,
                    "startIndex": 295816,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295816
            },
            {
              "endIndex": 296396,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 296396,
                    "startIndex": 295817,
                    "textRun": {
                      "content": "A tool that helps your analyst work 20% faster is worth maybe 20% of that analyst’s salary – you still need the analyst. A tool that does the analyst’s entire job, start to finish, on a defined category of tasks? That’s worth the analyst’s entire compensation for those tasks. Multiply that across every knowledge worker doing structured analytical work – legal associates, financial analysts, management consultants, software engineers, compliance officers, claims adjusters – and you’re talking about a meaningful share of a labor market that runs into the trillions annually.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 295817
            },
            {
              "endIndex": 296397,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 296397,
                    "startIndex": 296396,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 296396
            },
            {
              "endIndex": 296946,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 296530,
                    "startIndex": 296397,
                    "textRun": {
                      "content": "This is the context for something you wrote in December that I think was precisely right in direction but conservative in magnitude. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 296771,
                    "startIndex": 296530,
                    "textRun": {
                      "content": "You described AI as a labor-saving device. That was the right instinct. But labor-saving devices exist on a spectrum. A faster horse is a labor-saving device. An automobile is a labor-replacing technology that restructures the entire economy",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 296946,
                    "startIndex": 296771,
                    "textRun": {
                      "content": ". Level 1 and Level 2 AI were faster horses – they made existing workers more efficient. Level 3 agents are the automobile. They don’t make the work faster. They do the work.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 296397
            },
            {
              "endIndex": 296947,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 296947,
                    "startIndex": 296946,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 296946
            },
            {
              "endIndex": 298054,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 298054,
                    "startIndex": 296947,
                    "textRun": {
                      "content": "^ Yeah, so I would note that they’re labor-saving, but they are labor-creating. The thing is with all of this stuff is that they, well, not all of this stuff, but that you are a couple of things. One is that you’re able probably to pursue the interests that you care about most, because, like in history, you’re not forced to work the fields. You know, we will conspire to make jobs for each other and trade the things that we enjoy, the value that we see. The value is in the mind of the Beholder, and it is something that exists. You know, there’s no value if there are no human beings. If the universe was empty of, you know, sentient beings, then there would be no value. So the value is a creation that’s a societal human thing brought about by sentient beings. So it will shift around. The second thing is that what else are you going to do with your time? And is that time going to create activity and things that you’re going to need to rely on someone else to help you with. So when you displace some work over there, you create activity somewhere else. So yeah, I think this is really simplistic.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 296947
            },
            {
              "endIndex": 298055,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 298055,
                    "startIndex": 298054,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 298054
            },
            {
              "endIndex": 298319,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 298319,
                    "startIndex": 298055,
                    "textRun": {
                      "content": ". . . [In software for example], if Claude Code handles even 30 to 50 percent of [structured, pattern-based work] – and that’s a conservative estimate for near-term capability – you’re looking at $150 to $250 billion in annual labor value migrating to AI compute.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 298055
            },
            {
              "endIndex": 298320,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 298320,
                    "startIndex": 298319,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 298319
            },
            {
              "endIndex": 299043,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299043,
                    "startIndex": 298320,
                    "textRun": {
                      "content": "The negative implications for society are greatly compounded by AI’s speed of adoption as described earlier. AI can rapidly put people out of work for whom it will take years to find and be trained for new careers. It’s hard to think the speed of change under AI won’t vastly outstrip society’s ability to adjust. Think of the damage offshoring did to manufacturing jobs in the U.S. and other developed nations; this will impact more jobs and faster. For me, the bottom line is that not only are we unable to fully understand AI’s abilities and what it will do for us (or to us), but it thinks and moves faster than we can. (If you want to raise your worry level, take a look at the blog from Matt Shumer mentioned above.)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 298320
            },
            {
              "endIndex": 299044,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299044,
                    "startIndex": 299043,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299043
            },
            {
              "endIndex": 299573,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299173,
                    "startIndex": 299044,
                    "textRun": {
                      "content": "That brings me to the optimists. I’ve spoken with people – mostly from within the tech sector – who are sanguine in this regard. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 299571,
                    "startIndex": 299173,
                    "textRun": {
                      "content": "They say every technological innovation – the mechanization of agriculture 200 years ago; the industrial revolution that turned over factory jobs to machines 100 years ago; the handing over of research to the internet 25 years ago – was predicted to cause widespread joblessness. But in every instance, new jobs materialized and employment continued uninterrupted, and it’ll be so this time as well",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 299573,
                    "startIndex": 299571,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299044
            },
            {
              "endIndex": 299574,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299574,
                    "startIndex": 299573,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299573
            },
            {
              "endIndex": 299655,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299655,
                    "startIndex": 299574,
                    "textRun": {
                      "content": "First, I admit the tendency to extrapolate from this history isn’t unreasonable.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299574
            },
            {
              "endIndex": 299656,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299656,
                    "startIndex": 299655,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299655
            },
            {
              "endIndex": 299733,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299733,
                    "startIndex": 299656,
                    "textRun": {
                      "content": "Second, there’s no such thing as being able to prove something won’t happen.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299656
            },
            {
              "endIndex": 299734,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299734,
                    "startIndex": 299733,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299733
            },
            {
              "endIndex": 299919,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299919,
                    "startIndex": 299734,
                    "textRun": {
                      "content": "Third, I’m neither enough of a futurist to imagine the new jobs that may be created nor enough of an optimist to trust that they’ll materialize. That certainly doesn’t mean they won’t.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299734
            },
            {
              "endIndex": 299920,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 299920,
                    "startIndex": 299919,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299919
            },
            {
              "endIndex": 300081,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300001,
                    "startIndex": 299920,
                    "textRun": {
                      "content": "Some of the same optimists hasten to share the “good news” regarding the future: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 300079,
                    "startIndex": 300001,
                    "textRun": {
                      "content": "people won’t have to work. I simply cannot imagine that’ll be good for society",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.9490196,
                              "red": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 300081,
                    "startIndex": 300079,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 299920
            },
            {
              "endIndex": 300082,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300082,
                    "startIndex": 300081,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300081
            },
            {
              "endIndex": 300251,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300251,
                    "startIndex": 300082,
                    "textRun": {
                      "content": "A friend wrote to me recently that he’d rather be an optimist and wrong than a pessimist and right. Me too. I wish I could be confident that my worrying is unwarranted.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300082
            },
            {
              "endIndex": 300252,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300252,
                    "startIndex": 300251,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300251
            },
            {
              "endIndex": 300337,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300337,
                    "startIndex": 300252,
                    "textRun": {
                      "content": "That’s all I have to add for now. At the current rate, I’ll probably have more soon.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300252
            },
            {
              "endIndex": 300338,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300338,
                    "startIndex": 300337,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300337
            },
            {
              "endIndex": 300378,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300378,
                    "startIndex": 300338,
