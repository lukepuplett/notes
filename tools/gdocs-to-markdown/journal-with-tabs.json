                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "green": 1
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
