                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 131156,
                    "startIndex": 131061,
                    "textRun": {
                      "content": "Revocation propagation: on-chain revocation of delegations → invalidate downstream ProofPacks.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
