                "elements": [
                  {
                    "endIndex": 11310,
                    "startIndex": 11279,
                    "textRun": {
                      "content": "Benefits to U.S. Oil Companies:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
