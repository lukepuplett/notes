                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33510
            },
            {
              "endIndex": 33696,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33696,
                    "startIndex": 33511,
                    "textRun": {
                      "content": "Ironic b/c that has a seemingly contradictory implication both the SAFEST jobs the most at RISK jobs are likely those most impacted by AI. what matters is not how much AI is being used\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
