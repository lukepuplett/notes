                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119291
            },
            {
              "endIndex": 119402,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119402,
                    "startIndex": 119372,
                    "textRun": {
                      "content": "Agentic search has low recall\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
