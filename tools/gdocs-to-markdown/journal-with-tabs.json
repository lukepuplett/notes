            {
              "endIndex": 17,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 17,
                    "startIndex": 2,
                    "textRun": {
                      "content": "Marc Andreesen\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 2
            },
            {
              "endIndex": 18,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 18,
                    "startIndex": 17,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 17
            },
            {
              "endIndex": 148,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 148,
                    "startIndex": 18,
                    "textRun": {
                      "content": "The \"AI job loss\" narratives are all fake. AI = massive ramp in productivity = massive ramp in demand = massive jobs boom. Watch.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 18
            },
            {
              "endIndex": 149,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 149,
                    "startIndex": 148,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 148
            },
            {
              "endIndex": 151,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 151,
                    "startIndex": 149,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 149
            },
            {
              "endIndex": 152,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 152,
                    "startIndex": 151,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
