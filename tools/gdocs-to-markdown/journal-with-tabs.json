              "paragraph": {
                "elements": [
                  {
                    "endIndex": 96780,
                    "startIndex": 96753,
                    "textRun": {
                      "content": "The VC-to-BigTech Pipeline\n",
                      "textStyle": {}
                    }
                  }
                ],
