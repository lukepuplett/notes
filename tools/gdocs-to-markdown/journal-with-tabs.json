                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 119402
            },
            {
              "endIndex": 119844,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119844,
                    "startIndex": 119627,
                    "textRun": {
                      "content": "And I'm not just talking about context window size or long context attention mechanisms failing at the sight of a 1 million lines of code monster. Those are obvious technical limitations. It's more devious than that.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
