                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30660
            },
            {
              "endIndex": 30911,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30911,
                    "startIndex": 30661,
                    "textRun": {
                      "content": "- **Suggestive early signal on youth hiring**: job-finding rate for 22–25 year olds into exposed occupations fell ~14% post-ChatGPT (barely significant); no similar effect for older workers; echoes Brynjolfsson et al. slowdown in entry-level hiring.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30661
            },
            {
              "endIndex": 30912,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30912,
                    "startIndex": 30911,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30911
            },
            {
              "endIndex": 31083,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31083,
                    "startIndex": 30912,
                    "textRun": {
                      "content": "- Overall: limited evidence of material employment disruption so far; framework designed as early-warning system to detect future effects more reliably as adoption grows.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30912
            },
