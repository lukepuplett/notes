              "paragraph": {
                "elements": [
                  {
                    "endIndex": 160405,
                    "startIndex": 160371,
                    "textRun": {
                      "content": "- OpenAI & Oracle: 2.3 GW on-site ",
                      "textStyle": {}
                    }
                  },
