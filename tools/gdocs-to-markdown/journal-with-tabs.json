                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 161731,
                    "startIndex": 161677,
                    "textRun": {
                      "content": ": €1.2 billion global expansion, hiring 10,000 people\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161661
            },
            {
              "endIndex": 161797,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161733,
                    "startIndex": 161731,
                    "textRun": {
                      "content": "- ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 161749,
                    "startIndex": 161733,
                    "textRun": {
                      "content": "Babcock & Wilcox",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 161797,
                    "startIndex": 161749,
                    "textRun": {
                      "content": ": Steam turbine sets for 1 GW AI power projects\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161731
            },
            {
              "endIndex": 161798,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161798,
                    "startIndex": 161797,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161797
            },
            {
              "endIndex": 162101,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162101,
                    "startIndex": 161798,
                    "textRun": {
                      "content": "The market for data center transformers is growing fast, from about $9.29 billion in 2025 to over $10.24 billion in 2026, due to needs for high-power and efficient types. But even with these investments, shortages continue because of limited skilled workers, special materials, and global trade issues.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161798
            },
            {
              "endIndex": 162102,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162102,
                    "startIndex": 162101,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162101
            },
            {
              "endIndex": 162148,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162148,
                    "startIndex": 162102,
                    "textRun": {
                      "content": "**Small Modular Reactors and Nuclear for AI**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162102
            },
            {
              "endIndex": 162149,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162149,
                    "startIndex": 162148,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162148
            },
            {
              "endIndex": 162401,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162401,
                    "startIndex": 162149,
                    "textRun": {
                      "content": "For steady, low-carbon power, people are looking at nuclear, especially Small Modular Reactors (SMRs). These are smaller, factory-built, and can fit on data center sites. They could cut costs and build times compared to big traditional nuclear plants.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162149
            },
            {
              "endIndex": 162402,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162402,
                    "startIndex": 162401,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162401
            },
            {
              "endIndex": 162805,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162805,
                    "startIndex": 162402,
                    "textRun": {
                      "content": "Progress is happening: the US has approved some designs like NuScale's, and funding goes to projects with TVA and Holtec. But the first real commercial SMRs probably won't start until around 2030, so they won't fix the 2026–2028 power shortage. Smaller microreactors, like Radiant Nuclear's 1 MW Kaleidos (meant to replace diesel generators), are in testing and could help for smaller sites or backups.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162402
            },
            {
              "endIndex": 162806,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162806,
                    "startIndex": 162805,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162805
            },
            {
              "endIndex": 162866,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162866,
                    "startIndex": 162806,
                    "textRun": {
                      "content": "**The Silicon Limit: Advanced Packaging and Memory Issues**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162806
            },
            {
              "endIndex": 162867,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 162867,
                    "startIndex": 162866,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162866
            },
            {
              "endIndex": 163133,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163133,
                    "startIndex": 162867,
                    "textRun": {
                      "content": "The early AI boom was limited by having enough GPU power. Now in 2026, the main hardware limit is combining different chips (\"heterogeneous integration\") and getting enough fast memory bandwidth. The key choke point is putting GPU chips together with memory stacks.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 162867
            },
            {
              "endIndex": 163134,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163134,
                    "startIndex": 163133,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163133
            },
            {
              "endIndex": 163172,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163172,
                    "startIndex": 163134,
                    "textRun": {
                      "content": "**The HBM Monopoly and HBM4 Changes**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163134
            },
            {
              "endIndex": 163173,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163173,
                    "startIndex": 163172,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163172
            },
            {
              "endIndex": 163389,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163272,
                    "startIndex": 163173,
                    "textRun": {
                      "content": "High-Bandwidth Memory (HBM) has become the most expensive part of top AI chips. In an NVIDIA B200, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 163308,
                    "startIndex": 163272,
                    "textRun": {
                      "content": "memory is about half the $6,400 cost",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 163358,
                    "startIndex": 163308,
                    "textRun": {
                      "content": ". Only three companies control almost all supply: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 163387,
                    "startIndex": 163358,
                    "textRun": {
                      "content": "SK Hynix, Samsung, and Micron",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 163389,
                    "startIndex": 163387,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163173
            },
            {
              "endIndex": 163390,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163390,
                    "startIndex": 163389,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163389
            },
            {
              "endIndex": 163763,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163538,
                    "startIndex": 163390,
                    "textRun": {
                      "content": "Recent estimates show SK Hynix leading with around 50–60% market share in recent quarters, Samsung around 20–35%, and Micron lower (around 10–25%). ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 163631,
                    "startIndex": 163538,
                    "textRun": {
                      "content": "HBM4, starting late 2026, adds custom logic right on the memory base using advanced processes",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 163646,
                    "startIndex": 163631,
                    "textRun": {
                      "content": " (3nm or 5nm). ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 163761,
                    "startIndex": 163646,
                    "textRun": {
                      "content": "This links memory supply to the same limited chip factories as GPUs, raising risks if those factories have problems",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 163763,
                    "startIndex": 163761,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163390
            },
            {
              "endIndex": 163764,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163764,
                    "startIndex": 163763,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163763
            },
            {
              "endIndex": 163807,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163807,
                    "startIndex": 163764,
                    "textRun": {
                      "content": "**Advanced Packaging and CoWoS Shortages**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163764
            },
            {
              "endIndex": 163808,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163808,
                    "startIndex": 163807,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163807
            },
            {
              "endIndex": 164079,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 163828,
                    "startIndex": 163808,
                    "textRun": {
                      "content": "Packaging tech like ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 163840,
                    "startIndex": 163828,
                    "textRun": {
                      "content": "TSMC's CoWoS",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 164079,
                    "startIndex": 163840,
                    "textRun": {
                      "content": " is now as important as chip design for performance. TSMC is growing CoWoS fast, aiming for much higher capacity (like 50,000+ wafers/month by late 2025, up a lot from 2023). But demand is growing even faster, so shortages last into 2026.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 163808
            },
            {
              "endIndex": 164080,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164080,
                    "startIndex": 164079,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164079
            },
            {
              "endIndex": 164318,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164249,
                    "startIndex": 164080,
                    "textRun": {
                      "content": "NVIDIA has locked in a large share (reports say 50–70%) of TSMC's 2025 CoWoS capacity. This pushes others to make their own custom chips (ASICs) to get packaging space. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 164318,
                    "startIndex": 164249,
                    "textRun": {
                      "content": "ASICs are expected to take a bigger part of CoWoS AI shipments soon.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164080
            },
            {
              "endIndex": 164319,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164319,
                    "startIndex": 164318,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164318
            },
            {
              "endIndex": 164358,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164358,
                    "startIndex": 164319,
                    "textRun": {
                      "content": "**High-NA EUV and Lithography Limits**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164319
            },
            {
              "endIndex": 164359,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164359,
                    "startIndex": 164358,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164358
            },
            {
              "endIndex": 164603,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164436,
                    "startIndex": 164359,
                    "textRun": {
                      "content": "Going to smaller chip sizes (2nm, 1.4nm) needs new High-NA EUV machines from ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 164440,
                    "startIndex": 164436,
                    "textRun": {
                      "content": "ASML",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 164603,
                    "startIndex": 164440,
                    "textRun": {
                      "content": " (cost ~$380 million each). These allow much denser transistors without tricky extra steps. Intel tested the first ones in late 2025 to try leading again by 2027.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164359
            },
            {
              "endIndex": 164604,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164604,
                    "startIndex": 164603,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164603
            },
            {
              "endIndex": 164738,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164738,
                    "startIndex": 164604,
                    "textRun": {
                      "content": "This is a big change for scaling AI chips. But trade rules and tensions (especially with China) are cutting ASML sales there in 2026.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164604
            },
            {
              "endIndex": 164739,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164739,
                    "startIndex": 164738,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164738
            },
            {
              "endIndex": 164789,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164789,
                    "startIndex": 164739,
                    "textRun": {
                      "content": "**The Data Wall: Running Out of Good Human Text**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164739
            },
            {
              "endIndex": 164790,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 164790,
                    "startIndex": 164789,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164789
            },
            {
              "endIndex": 165039,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165039,
                    "startIndex": 164790,
                    "textRun": {
                      "content": "LLMs grew by eating huge amounts of internet text. By 2026, we're hitting the \"Data Wall\" — high-quality public human text is running low. Epoch AI says about 300 trillion tokens exist, and frontier models could use it all up between 2026 and 2032.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 164790
            },
            {
              "endIndex": 165040,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165040,
                    "startIndex": 165039,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165039
            },
            {
              "endIndex": 165083,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165083,
                    "startIndex": 165040,
                    "textRun": {
                      "content": "**Synthetic Data and Model Collapse Risk**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165040
            },
            {
              "endIndex": 165084,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165084,
                    "startIndex": 165083,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165083
            },
            {
              "endIndex": 165306,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165216,
                    "startIndex": 165084,
                    "textRun": {
                      "content": "To get around this, companies make synthetic (AI-generated) data. It can be endless, but using too much leads to \"model collapse\" — ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 165304,
                    "startIndex": 165216,
                    "textRun": {
                      "content": "models start making nonsense or lose variety after repeated training on their own output",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 165306,
                    "startIndex": 165304,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165084
            },
            {
              "endIndex": 165307,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165307,
                    "startIndex": 165306,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165306
            },
            {
              "endIndex": 165521,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165521,
                    "startIndex": 165307,
                    "textRun": {
                      "content": "The fix is focusing on quality: building better systems to create, clean, and select good synthetic data. Some use \"reasoning\" models that think longer at use time to make better data, trading compute for quality.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165307
            },
            {
              "endIndex": 165522,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165522,
                    "startIndex": 165521,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165521
            },
            {
              "endIndex": 165562,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165562,
                    "startIndex": 165522,
                    "textRun": {
                      "content": "**Data Control and Internet Splitting**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165522
            },
            {
              "endIndex": 165563,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165563,
                    "startIndex": 165562,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165562
            },
            {
              "endIndex": 165794,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165794,
                    "startIndex": 165563,
                    "textRun": {
                      "content": "Countries worry about losing their data, so they're pushing \"AI Sovereignty\" — keeping data inside borders and training on local hardware. China's internet is closing off more, making it harder for outside models to get good data.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165563
            },
            {
              "endIndex": 165795,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165795,
                    "startIndex": 165794,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165794
            },
            {
              "endIndex": 165852,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165852,
                    "startIndex": 165795,
                    "textRun": {
                      "content": "**The People Bottleneck: Talent Shortage and Setup Gap**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165795
            },
            {
              "endIndex": 165853,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165853,
                    "startIndex": 165852,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165852
            },
            {
              "endIndex": 166119,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166119,
                    "startIndex": 165853,
                    "textRun": {
                      "content": "The biggest limit isn't tech — it's people. There's a huge gap between making a strong model and actually using it well in companies (the \"$4.5T Integration Gap\"). Models don't set themselves up; they need to fit messy real systems, gain trust, and work with teams.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 165853
            },
            {
              "endIndex": 166120,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166120,
                    "startIndex": 166119,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166119
            },
            {
              "endIndex": 166149,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166149,
                    "startIndex": 166120,
                    "textRun": {
                      "content": "**The AI Engineer Shortage**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166120
            },
            {
              "endIndex": 166150,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166150,
                    "startIndex": 166149,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166149
            },
            {
              "endIndex": 166368,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166368,
                    "startIndex": 166150,
                    "textRun": {
                      "content": "New key role: AI Engineer — experts in ML, software, and operations (MLOps). Demand grows much faster than regular software jobs, but only a few hundred people worldwide really know how to deploy big AI in production.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166150
            },
            {
              "endIndex": 166369,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166369,
                    "startIndex": 166368,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166368
            },
            {
              "endIndex": 166413,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166413,
                    "startIndex": 166369,
                    "textRun": {
                      "content": "Compared to traditional software engineers:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166369
            },
            {
              "endIndex": 166414,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166414,
                    "startIndex": 166413,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166413
            },
            {
              "endIndex": 166460,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166460,
                    "startIndex": 166414,
                    "textRun": {
                      "content": "- Demand growth: much faster for AI engineers\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166414
            },
            {
              "endIndex": 166506,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166506,
                    "startIndex": 166460,
                    "textRun": {
                      "content": "- Skills: ML pipelines, RAG, Kubernetes, etc.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166460
            },
            {
              "endIndex": 166528,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166528,
                    "startIndex": 166506,
                    "textRun": {
                      "content": "- Salary: big premium\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166506
            },
            {
              "endIndex": 166560,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166560,
                    "startIndex": 166528,
                    "textRun": {
                      "content": "- Supply gap: severe and global\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166528
            },
            {
              "endIndex": 166561,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166561,
                    "startIndex": 166560,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166560
            },
            {
              "endIndex": 166738,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166738,
                    "startIndex": 166561,
                    "textRun": {
                      "content": "This gives talent huge power, with top pay in expensive areas. Companies can't just hire more, so they focus on training inside and small cross-team groups to test AI projects.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166561
            },
            {
              "endIndex": 166739,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166739,
                    "startIndex": 166738,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166738
            },
            {
              "endIndex": 166790,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166790,
                    "startIndex": 166739,
                    "textRun": {
                      "content": "**\"Workslop,\" Tech Debt, and Productivity Issues**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166739
            },
            {
              "endIndex": 166791,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 166791,
                    "startIndex": 166790,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166790
            },
            {
              "endIndex": 167018,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167018,
                    "startIndex": 166791,
                    "textRun": {
                      "content": "Rushing AI has created \"Workslop\" — bad AI output that people fix, wasting time. AI code is often quick but messy, leading to bugs and future fixes. By 2026, many tech leaders deal with growing technical debt from fast AI use.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 166791
            },
            {
              "endIndex": 167019,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167019,
                    "startIndex": 167018,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167018
            },
            {
              "endIndex": 167189,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167189,
                    "startIndex": 167019,
                    "textRun": {
                      "content": "AI productivity gains show mostly in coding and call centers, not everywhere. Experts say 2026 will show real value — or just more hype — as companies measure carefully.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167019
            },
            {
              "endIndex": 167190,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167190,
                    "startIndex": 167189,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167189
            },
            {
              "endIndex": 167233,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167233,
                    "startIndex": 167190,
                    "textRun": {
                      "content": "**Better Designs: The Rise of 1-Bit LLMs**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167190
            },
            {
              "endIndex": 167234,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167234,
                    "startIndex": 167233,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167233
            },
            {
              "endIndex": 167453,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167453,
                    "startIndex": 167234,
                    "textRun": {
                      "content": "With hardware and energy limits, new model types help. 1-bit (or ~1.58-bit) LLMs like BitNet use ternary weights (-1, 0, +1) instead of floating-point numbers. Math changes: add or subtract based on weight, skip zeros.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167234
            },
            {
              "endIndex": 167454,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167454,
                    "startIndex": 167453,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167453
            },
            {
              "endIndex": 167464,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167464,
                    "startIndex": 167454,
                    "textRun": {
                      "content": "Benefits:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167454
            },
            {
              "endIndex": 167465,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167465,
                    "startIndex": 167464,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167464
            },
            {
              "endIndex": 167521,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167521,
                    "startIndex": 167465,
                    "textRun": {
                      "content": "- Big drop in energy for math (up to 71x on some chips)\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167465
            },
            {
              "endIndex": 167594,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167594,
                    "startIndex": 167521,
                    "textRun": {
                      "content": "- Much less memory (e.g., 7x less for 70B model, runs on one laptop CPU)\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167521
            },
            {
              "endIndex": 167651,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167651,
                    "startIndex": 167594,
                    "textRun": {
                      "content": "- Faster speed (1.4x–6x) and energy savings (up to 80%+)\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167594
            },
            {
              "endIndex": 167652,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167652,
                    "startIndex": 167651,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167651
            },
            {
              "endIndex": 167870,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167662,
                    "startIndex": 167652,
                    "textRun": {
                      "content": "This lets ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 167756,
                    "startIndex": 167662,
                    "textRun": {
                      "content": "good AI run locally on normal devices, reducing need for giant data centers and expensive GPUs",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 167870,
                    "startIndex": 167756,
                    "textRun": {
                      "content": ". By 2026, the edge goes to best designs, not just most compute — efficient big models beat smaller precise ones.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167652
            },
            {
              "endIndex": 167871,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167871,
                    "startIndex": 167870,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167870
            },
            {
              "endIndex": 167920,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167920,
                    "startIndex": 167871,
                    "textRun": {
                      "content": "**Geopolitics and Global Competition for Setup**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167871
            },
            {
              "endIndex": 167921,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 167921,
                    "startIndex": 167920,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167920
            },
            {
              "endIndex": 168146,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 168146,
                    "startIndex": 167921,
                    "textRun": {
                      "content": "AI is now a national security race. US, China, and others compete for control of chips and energy at home. US 2026 plans focus on AI for military, using government data and fast setups. India grows as a talent and build hub.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 167921
            },
            {
              "endIndex": 168147,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 168147,
                    "startIndex": 168146,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
