                    "textRun": {
                      "content": "• $EOSE enables long duration storage for 24/7 data center power\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32752
            },
            {
              "endIndex": 32885,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32885,
                    "startIndex": 32817,
                    "textRun": {
                      "content": "• $SMR develops small modular reactors for future nuclear buildouts\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32817
            },
            {
              "endIndex": 32957,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32957,
                    "startIndex": 32885,
                    "textRun": {
                      "content": "• $OKLO provides “local nuclear plant” that the AI economy will require\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32885
            },
            {
              "endIndex": 33029,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33029,
                    "startIndex": 32957,
                    "textRun": {
                      "content": "• $GEV supplies turbines, transformers & grid hardware for grid rebuild\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32957
            },
            {
              "endIndex": 33030,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33030,
                    "startIndex": 33029,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33029
            },
            {
              "endIndex": 33032,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33032,
                    "startIndex": 33030,
                    "textRun": {
