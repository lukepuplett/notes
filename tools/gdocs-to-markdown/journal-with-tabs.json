            {
              "endIndex": 59172,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 59172,
                    "startIndex": 58918,
                    "textRun": {
                      "content": "At least 12,000 people were killed in the largest killing in Iran’s contemporary history, carried out largely over two consecutive nights on January 8 and 9, Iran International’s editorial board concluded, based on a review of sources and medical data. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 58918
            },
            {
              "endIndex": 59173,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 59173,
                    "startIndex": 59172,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 59172
            },
            {
              "endIndex": 59395,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 59395,
                    "startIndex": 59173,
                    "textRun": {
                      "content": "Iran is under a coordinated blackout aimed not only at security control but at concealing the truth, reflected in internet cuts, crippled communications, media shutdowns, and the intimidation of journalists and witnesses.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 59173
            },
            {
              "endIndex": 59396,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 59396,
                    "startIndex": 59395,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 59395
            },
            {
              "endIndex": 59450,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 59450,
                    "startIndex": 59396,
                    "textRun": {
                      "content": "Publication was delayed until the evidence converged.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 59396
            },
            {
              "endIndex": 59451,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 59451,
                    "startIndex": 59450,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 59450
            },
