                "elements": [
                  {
                    "endIndex": 179865,
                    "startIndex": 179828,
                    "textRun": {
                      "content": "Stocks React to Claude Announcements\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 179828
            },
            {
              "endIndex": 179991,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 179991,
                    "startIndex": 179865,
                    "textRun": {
                      "content": "IBM stock, $IBM, just posted its worst day since October 2000 after Anthropic announced that Claude can streamline COBOL code\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
