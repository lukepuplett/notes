                }
              },
              "startIndex": 120424
            },
            {
              "endIndex": 120657,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 120657,
                    "startIndex": 120425,
                    "textRun": {
                      "content": "^ This is the most interesting slide so far - competition from cheaper up-starts. No one ever mentions the need to move commerce onchain. What’s missing here is the radical new interaction paradigms. It’s like the mobile web again.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 120425
