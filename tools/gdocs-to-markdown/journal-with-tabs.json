            {
              "endIndex": 44201,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44201,
                    "startIndex": 44084,
                    "textRun": {
                      "content": "For essentially my entire career in tech, the most valuable person was an engineer who understood some business/GTM.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44084
            },
            {
              "endIndex": 44202,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44202,
                    "startIndex": 44201,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44201
            },
            {
              "endIndex": 44267,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44267,
                    "startIndex": 44202,
                    "textRun": {
                      "content": "The entire economic structure of the industry was built on this.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44202
            },
            {
              "endIndex": 44268,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44268,
                    "startIndex": 44267,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44267
            },
            {
              "endIndex": 44520,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44520,
                    "startIndex": 44268,
                    "textRun": {
                      "content": "Engineers commanded the highest salaries. The cap table was designed around equity comp because you couldn't afford them in cash. The seed round existed to buy engineering time/output. And VCs were, at their core, an arbitrage on engineering scarcity.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44268
            },
            {
              "endIndex": 44521,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44521,
                    "startIndex": 44520,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44520
            },
            {
              "endIndex": 44544,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44544,
                    "startIndex": 44521,
                    "textRun": {
                      "content": "That scarcity is gone.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44521
            },
