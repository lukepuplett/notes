              "startIndex": 1202
            },
            {
              "endIndex": 1333,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 1333,
                    "startIndex": 1249,
                    "textRun": {
                      "content": "1. Seller (legitimately or collusively) decides to issue refund on the 900K payment\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 1249
            },
            {
              "endIndex": 1380,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 1380,
                    "startIndex": 1333,
                    "textRun": {
                      "content": "1. Seller calls `refundBySeller(newPaymentID)`\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 1333
            },
            {
              "endIndex": 1416,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 1416,
                    "startIndex": 1380,
                    "textRun": {
                      "content": "1. Code checks: 900K <= 1M ✓ passes\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 1380
            },
            {
              "endIndex": 1472,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 1472,
                    "startIndex": 1416,
                    "textRun": {
                      "content": "1. Code executes: `balances[seller]` = 1M - 900K = 100K\n",
