                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130612
            },
            {
              "endIndex": 130615,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130615,
                    "startIndex": 130614,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130614
            },
            {
              "endIndex": 130773,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130773,
                    "startIndex": 130615,
                    "textRun": {
                      "content": "^ Falling birthrates getting more attention via financial outlets - this is Germany. Noah Pinion published an article. Grok confirms hitting primary schools.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130615
            },
            {
              "endIndex": 130774,
              "paragraph": {
                "elements": [
                  {
