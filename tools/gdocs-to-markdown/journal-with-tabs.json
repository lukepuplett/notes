                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 12114
            },
            {
              "endIndex": 12367,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 12367,
                    "startIndex": 12115,
                    "textRun": {
                      "content": "But perhaps there'll be a bottleneck in grid/power or a fundamental dilemma* in context/attention, i.e. can present transformer designs hold 1,000 books in context and correctly** prioritise (give attention to) the right information at the right time.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 12115
            },
