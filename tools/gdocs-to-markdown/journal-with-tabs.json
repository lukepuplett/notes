                "elements": [
                  {
                    "endIndex": 17019,
                    "startIndex": 17010,
                    "textRun": {
                      "content": "The Fear:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
