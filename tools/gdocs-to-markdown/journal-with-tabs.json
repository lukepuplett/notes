              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216034,
                    "startIndex": 215935,
                    "textRun": {
                      "content": "BYD, which sells a mix of pure EVs & hybrids, reported sales in Europe jumped 165% to 18,242 units\n",
