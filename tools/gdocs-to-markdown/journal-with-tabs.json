                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5981
            },
            {
              "endIndex": 6044,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 6044,
                    "startIndex": 5982,
                    "textRun": {
                      "content": "Same model. Same benchmark. The only variable is the harness.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5982
            },
