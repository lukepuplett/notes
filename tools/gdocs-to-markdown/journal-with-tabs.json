                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 131257,
                    "startIndex": 131156,
                    "textRun": {
                      "content": "Payment for delegations/MCP calls: human funds agent wallet, sponsored tx, or paymaster integration.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
