              },
              "startIndex": 173581
            },
            {
              "endIndex": 173941,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 173941,
                    "startIndex": 173582,
                    "textRun": {
                      "content": "Beneficiation includes crushing, magnetic separation, and flotation, followed by acid leaching. Traditional leaching uses hydrofluoric acid (HF) to remove grain-boundary impurities, but non-HF methods (caustic baking, phosphoric acid) are being adopted for environmental reasons. Brazil's SME project shows reductions of 94% iron and 97% titanium without HF.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 173582
            },
            {
              "endIndex": 173942,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 173942,
                    "startIndex": 173941,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 173941
            },
            {
              "endIndex": 174041,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 174041,
                    "startIndex": 173942,
                    "textRun": {
                      "content": "Thermal treatment (heating >1,000°C then water quenching) fractures inclusions for later leaching.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 173942
            },
            {
              "endIndex": 174042,
              "paragraph": {
