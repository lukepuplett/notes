              "endIndex": 30150,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30150,
                    "startIndex": 30055,
                    "textRun": {
                      "content": "it’s not happening. there are many other ways to undermine the sovereignty of another nation. \n",
