            },
            {
              "endIndex": 120286,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 120040,
                    "startIndex": 120019,
                    "textRun": {
                      "content": "I disagree.  I think ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 120286,
                    "startIndex": 120040,
                    "textRun": {
                      "content": "legacy applications and middleware from companies like $CSU.TO or $IBM are most exposed as AI eliminates many of the historical ETL barriers-to-switch: Upgrading to modern SaaS solutions and systems of record will now be much easier and cheaper.\n",
                      "textStyle": {
                        "backgroundColor": {
