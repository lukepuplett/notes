              "endIndex": 131341,
              "paragraph": {
                "bullet": {
                  "listId": "kix.uz4i8xkk50yk",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 131341,
                    "startIndex": 131257,
                    "textRun": {
                      "content": "Multi-hop delegation security: depth limits, audit trails, expiration in ProofPack.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
