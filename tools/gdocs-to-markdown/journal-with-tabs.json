                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 10760
            },
            {
              "endIndex": 10921,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 10921,
                    "startIndex": 10761,
                    "textRun": {
                      "content": "^ Unclear if all cars or just cars to sell in China. Erosion of European manufacturing base and putting more eggs in China basket. The opposite of US strategy.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
