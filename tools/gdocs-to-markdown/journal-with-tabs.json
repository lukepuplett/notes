              "paragraph": {
                "elements": [
                  {
                    "endIndex": 169047,
                    "startIndex": 168860,
                    "textRun": {
                      "content": "Here is the text reprinted with identical content and technical details, but rewritten in a direct, concise style without marketing phrases, flowery language, or unnecessary elaboration:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 168860
            },
            {
              "endIndex": 169048,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 169048,
                    "startIndex": 169047,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 169047
            },
            {
              "endIndex": 169620,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 169244,
                    "startIndex": 169048,
                    "textRun": {
                      "content": "High-purity silica and ultra-pure quartz support modern technologies including semiconductors, solar energy, and optical fibers due to the chemical stability and purity of silicon dioxide (SiO₂). ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 169390,
                    "startIndex": 169244,
                    "textRun": {
                      "content": "Although quartz is the second most abundant mineral in Earth's crust, high-purity quartz (HPQ) differs significantly from ordinary industrial sand",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 169392,
                    "startIndex": 169390,
                    "textRun": {
                      "content": ". ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 169533,
                    "startIndex": 169392,
                    "textRun": {
                      "content": "HPQ requires silica content above 99.99% (4N) or 99.999% (5N), with very low metallic impurities, for use in semiconductors and photovoltaics",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 169620,
                    "startIndex": 169533,
                    "textRun": {
                      "content": ". Both the European Union and USGS classify these materials as critical raw materials.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 169048
            },
            {
              "endIndex": 169621,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 169621,
