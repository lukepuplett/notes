              "startIndex": 11854
            },
            {
              "endIndex": 12220,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 12220,
                    "startIndex": 11855,
                    "textRun": {
                      "content": "The firms contrasted the EU's approach with developments in the United States, pointing to regulatory actions that they say have enabled industrial-scale tokenization and paved the way for fully digital, T+0 settlement markets as early as this year. They warn that this creates a multi-year window in which liquidity could migrate permanently away from EU markets.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 11855
            },
