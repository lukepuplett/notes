              "startIndex": 198776
            },
            {
              "endIndex": 199027,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 198805,
                    "startIndex": 198777,
                    "textRun": {
                      "content": "Lowering Barriers to Entry: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 199025,
                    "startIndex": 198805,
                    "textRun": {
                      "content": "AI will allow a single founder to execute the work of a 50-person agency. This will democratize entrepreneurship, potentially offsetting corporate job losses by empowering a new class of hyper-productive sole proprietors",
                      "textStyle": {
