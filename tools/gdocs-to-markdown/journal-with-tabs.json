              "paragraph": {
                "elements": [
                  {
                    "endIndex": 179827,
                    "startIndex": 179764,
                    "textRun": {
                      "content": "If you haven't been paying attention, below are some examples:\n",
                      "textStyle": {}
                    }
                  }
