                }
              },
              "startIndex": 252939
            },
            {
              "endIndex": 253075,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253075,
                    "startIndex": 252940,
                    "textRun": {
                      "content": "BREAKING: Anthropic has rejected the US Pentagon’s “final offer” just 24 hours before Defense Secretary Hegseth’s deadline, per Axios.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 252940
            },
            {
              "endIndex": 253076,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253076,
                    "startIndex": 253075,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253075
            },
            {
              "endIndex": 253197,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253197,
                    "startIndex": 253076,
                    "textRun": {
                      "content": "Anthropic remains adamant on their AI platform not being used for surveillance of Americans or lethal military missions.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253076
            },
            {
              "endIndex": 253198,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253198,
                    "startIndex": 253197,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253197
            },
            {
              "endIndex": 253243,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253243,
                    "startIndex": 253198,
                    "textRun": {
                      "content": "We expect a response from the Pentagon soon.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253198
            },
            {
              "endIndex": 253244,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253244,
                    "startIndex": 253243,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253243
            },
            {
              "endIndex": 253323,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 253323,
                    "startIndex": 253244,
                    "textRun": {
                      "content": "This situation is far more serious and consequential than most people realize.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 253244
            },
            {
              "endIndex": 253324,
              "paragraph": {
