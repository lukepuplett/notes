                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 176763
            },
            {
              "endIndex": 176936,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 176936,
                    "startIndex": 176764,
                    "textRun": {
                      "content": "- Same way 50 years ago if you were simply strong, you could do well. Now, strong isn't enough. You need hard skills (think: electrician, plumber, auto manufacturing etc.)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 176764
            },
