              "paragraph": {
                "elements": [
                  {
                    "endIndex": 40827,
                    "startIndex": 40687,
                    "textRun": {
                      "content": "Short answer: for the average UK citizen, it’s marginally better that Denmark owns Greenland — but the difference is small and situational.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 40687
            },
