              "endIndex": 12114,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 12114,
                    "startIndex": 11913,
                    "textRun": {
                      "content": "Meanwhile, the hosted models will need to increase the context window 10X and 10X again while maintaining relevance/attention, avoiding cognitive tunnelling, and that'll be what you pay a premium for.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 11913
            },
            {
