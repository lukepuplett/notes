                    "startIndex": 41440,
                    "textRun": {
                      "content": "Security clarity. The US already de facto controls Greenland’s defence. Formal ownership could reduce ambiguity and free-riding, tightening NATO’s Arctic posture.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41440
            },
            {
              "endIndex": 41604,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 41604,
                    "startIndex": 41603,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41603
            },
            {
              "endIndex": 41736,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 41736,
                    "startIndex": 41604,
                    "textRun": {
                      "content": "China containment. Washington would shut down any future Chinese economic or infrastructure influence faster than Copenhagen might.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41604
            },
            {
              "endIndex": 41737,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 41737,
                    "startIndex": 41736,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41736
            },
            {
              "endIndex": 41856,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 41856,
                    "startIndex": 41737,
                    "textRun": {
                      "content": "Capability over intent. The US has the money and logistics to develop Arctic infrastructure at scale; Denmark doesn’t.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41737
            },
            {
              "endIndex": 41857,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 41857,
                    "startIndex": 41856,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41856
            },
            {
              "endIndex": 41903,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 41903,
                    "startIndex": 41857,
                    "textRun": {
                      "content": "Second-order effects the UK should care about\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41857
            },
            {
              "endIndex": 41904,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 41904,
                    "startIndex": 41903,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41903
            },
            {
              "endIndex": 42061,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42061,
                    "startIndex": 41904,
                    "textRun": {
                      "content": "Militarisation vs deterrence. US ownership improves deterrence but increases the chance the Arctic becomes a hot strategic theatre. Denmark keeps it cooler.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 41904
            },
            {
              "endIndex": 42062,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42062,
                    "startIndex": 42061,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42061
            },
            {
              "endIndex": 42193,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42193,
                    "startIndex": 42062,
                    "textRun": {
                      "content": "Precedent risk. Normalising territorial acquisition by great powers (even friendly ones) weakens norms the UK relies on elsewhere.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42062
            },
            {
              "endIndex": 42194,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42194,
                    "startIndex": 42193,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42193
            },
            {
              "endIndex": 42306,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42306,
                    "startIndex": 42194,
                    "textRun": {
                      "content": "Trade-offs in alliance politics. A stronger US Arctic hand could crowd out UK influence rather than amplify it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42194
            },
            {
              "endIndex": 42307,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42307,
                    "startIndex": 42306,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42306
            },
            {
              "endIndex": 42319,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42319,
                    "startIndex": 42307,
                    "textRun": {
                      "content": "Bottom line\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42307
            },
            {
              "endIndex": 42320,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42320,
                    "startIndex": 42319,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42319
            },
            {
              "endIndex": 42440,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42440,
                    "startIndex": 42320,
                    "textRun": {
                      "content": "If you optimise for low volatility and institutional continuity, Denmark owning Greenland is better for the UK citizen.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42320
            },
            {
              "endIndex": 42559,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42559,
                    "startIndex": 42440,
                    "textRun": {
                      "content": "If you optimise for hard security against China/Russia, US ownership has appeal — but comes with higher systemic risk.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42440
            },
            {
              "endIndex": 42560,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42560,
                    "startIndex": 42559,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42559
            },
            {
              "endIndex": 42633,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42633,
                    "startIndex": 42560,
                    "textRun": {
                      "content": "Given the UK’s exposure to second-order fallout, boring beats bold here.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42560
            },
            {
              "endIndex": 42634,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42634,
                    "startIndex": 42633,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42633
            },
            {
              "endIndex": 42636,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42636,
                    "startIndex": 42634,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42634
            },
            {
              "endIndex": 42637,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42637,
                    "startIndex": 42636,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42636
            },
            {
              "endIndex": 42645,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42645,
                    "startIndex": 42637,
                    "textRun": {
                      "content": "Vitalik\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42637
            },
            {
              "endIndex": 42646,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42646,
                    "startIndex": 42645,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42645
            },
            {
              "endIndex": 42691,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42691,
                    "startIndex": 42646,
                    "textRun": {
                      "content": "Ethereum itself must pass the walkaway test.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42646
            },
            {
              "endIndex": 42692,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 42692,
                    "startIndex": 42691,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42691
            },
            {
              "endIndex": 43286,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43286,
                    "startIndex": 42692,
                    "textRun": {
                      "content": "Ethereum is meant to be a home for trustless and trust-minimized applications, whether in finance, governance or elsewhere. It must support applications that are more like tools - the hammer that once you buy it's yours - than like services that lose all functionality once the vendor loses interest in maintaining them (or worse, gets hacked or becomes value-extractive). Even when applications do have functionality that depends on a vendor, Ethereum can help reduce those dependencies as much as possible, and protect the user as much as possible in those cases where the dependencies fail.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 42692
            },
            {
              "endIndex": 43287,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43287,
                    "startIndex": 43286,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43286
            },
            {
              "endIndex": 43636,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43636,
                    "startIndex": 43287,
                    "textRun": {
                      "content": "But building such applications is not possible on a base layer which itself depends on ongoing updates from a vendor in order to continue being usable - even if that \"vendor\" is the all core devs process. Ethereum the blockchain must have the traits that we strive for in Ethereum's applications. Hence, Ethereum itself must pass the walkaway test.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43287
            },
            {
              "endIndex": 43637,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43637,
                    "startIndex": 43636,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43636
            },
            {
              "endIndex": 43915,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43778,
                    "startIndex": 43637,
                    "textRun": {
                      "content": "This means that Ethereum must get to a place where we _can ossify if we want to_. We do not have to stop making changes to the protocol, but ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 43913,
                    "startIndex": 43778,
                    "textRun": {
                      "content": "we must get to a place where Ethereum's value proposition does not strictly depend on any features that are not in the protocol already",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 43915,
                    "startIndex": 43913,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43637
            },
            {
              "endIndex": 43916,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43916,
                    "startIndex": 43915,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43915
            },
            {
              "endIndex": 43945,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43945,
                    "startIndex": 43916,
                    "textRun": {
                      "content": "This includes the following:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43916
            },
            {
              "endIndex": 43946,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 43946,
                    "startIndex": 43945,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43945
            },
            {
              "endIndex": 44403,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44403,
                    "startIndex": 43946,
                    "textRun": {
                      "content": "* Full quantum-resistance. We should resist the trap of saying \"let's delay quantum-resistance until the last possible moment in the name of ekeing out more efficiencies for a while longer\". Individual users have that right, but the protocol should not. Being able to say \"Ethereum's protocol, as it stands today, is cryptographically safe for a hundred years\" is something we should strive to get to as soon as possible, and insist on as a point of pride.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 43946
            },
            {
              "endIndex": 44864,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44864,
                    "startIndex": 44403,
                    "textRun": {
                      "content": "* An architecture that can expand to sufficient scalability. The protocol needs to have the properties that allow it to expand to many thousands of TPS over time, most notably ZK-EVM validation and data sampling through PeerDAS. Ideally, we get to a point where further scaling is done through \"parameter only\" changes - and ideally _those_ changes are not BPO-style forks, but rather are made with the same validator voting mechanism we use for the gas limit.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44403
            },
            {
              "endIndex": 45249,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45249,
                    "startIndex": 44864,
                    "textRun": {
                      "content": "* A state architecture that can last decades. This means deciding, and implementing, whatever form of partial statelessness and state expiry will let us feel comfortable letting Ethereum run with thousands of TPS for decades, without breaking sync or hard disk or I/O requirements. It also means future-proofing the tree and storage types to work well with this long-term environment.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44864
            },
            {
              "endIndex": 45386,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45386,
                    "startIndex": 45249,
                    "textRun": {
                      "content": "* An account model that is general-purpose (this is \"full account abstraction\": move away from enshrined ECDSA for signature validation)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45249
            },
            {
              "endIndex": 45495,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45495,
                    "startIndex": 45386,
                    "textRun": {
                      "content": "* A gas schedule that we are confident is free of DoS vulnerabilities, both for execution and for ZK-proving\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45386
            },
            {
              "endIndex": 45805,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45805,
                    "startIndex": 45495,
                    "textRun": {
                      "content": "* A PoS economic model that, with all we have learned over the past half decade of proof of stake in Ethereum and full decade beyond, we are confident can last and remain decentralized for decades, and supports the usefulness of ETH as trustless collateral (eg. in governance-minimized ETH-backed stablecoins)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45495
            },
            {
              "endIndex": 45960,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45960,
                    "startIndex": 45805,
                    "textRun": {
                      "content": "* A block building model that we are confident will resist centralization pressure and guarantee censorship resistance even in unknown future environments\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45805
            },
            {
              "endIndex": 45961,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45961,
                    "startIndex": 45960,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45960
            },
            {
              "endIndex": 46457,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46457,
                    "startIndex": 45961,
                    "textRun": {
                      "content": "Ideally, we do the hard work over the next few years, to get to a point where in the future almost all future innovation can happen through client optimization, and get reflected in the protocol through parameter changes. Every year, we should tick off at least one of these boxes, and ideally multiple. Do the right thing once, based on knowledge of what is truly the right thing (and not compromise halfway fixes), and maximize Ethereum's technological and social robustness for the long term.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45961
            },
            {
              "endIndex": 46458,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46458,
                    "startIndex": 46457,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46457
            },
            {
              "endIndex": 46478,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46478,
                    "startIndex": 46458,
                    "textRun": {
                      "content": "Ethereum goes hard.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46458
            },
            {
              "endIndex": 46479,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46479,
                    "startIndex": 46478,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46478
            },
            {
              "endIndex": 46497,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46497,
                    "startIndex": 46479,
                    "textRun": {
                      "content": "This is the gwei.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46479
            },
            {
              "endIndex": 46498,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46498,
                    "startIndex": 46497,
                    "textRun": {
                      "content": "\n",
