                    "startIndex": 141122,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 141122
            },
            {
              "endIndex": 141238,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 141238,
                    "startIndex": 141123,
                    "textRun": {
                      "content": "At $103/oz, this is no longer a rounding error for panel manufacturers. We’re getting close to the pain threshold.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 141123
            },
            {
              "endIndex": 141438,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 141438,
                    "startIndex": 141238,
                    "textRun": {
                      "content": "At $28/oz (2024 average), the industry made $31bn. At $103 today, they're down to maybe $8-10bn. The breakeven is $134/oz — that's only 30% away. In a 70 vol market, that's not a comfortable cushion.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 141238
            },
            {
              "endIndex": 141439,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 141439,
                    "startIndex": 141438,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 141438
            },
            {
              "endIndex": 141476,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 141476,
                    "startIndex": 141439,
                    "textRun": {
                      "content": "Copper substitution is accelerating.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 141439
            },
