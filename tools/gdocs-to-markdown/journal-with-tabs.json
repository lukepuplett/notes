                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 169846
            },
            {
              "endIndex": 170384,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 169948,
                    "startIndex": 169847,
                    "textRun": {
                      "content": "The Spruce Pine Mining District in North Carolina is the main global source of highest-quality quartz",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 170384,
                    "startIndex": 169948,
                    "textRun": {
                      "content": ". It lies in the Blue Ridge Mountains across Mitchell, Avery, and Yancey counties, covering about 25 miles long and 5 miles wide. The pegmatites formed around 380 million years ago during collision of ancient Africa and North America, when subducted oceanic sediments melted and cooled slowly, producing large crystals. Dry conditions during crystallization limited water-mediated impurity incorporation, resulting in low trace metals.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 169847
            },
