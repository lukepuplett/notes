                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 27952
            },
            {
              "endIndex": 28074,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28074,
                    "startIndex": 27953,
                    "textRun": {
                      "content": "I wanted to build a video editor into X like other social apps. I had expected it to take 3 months of engineering time. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 27953
            },
            {
              "endIndex": 28075,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28075,
                    "startIndex": 28074,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28074
            },
            {
              "endIndex": 28175,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28175,
                    "startIndex": 28075,
                    "textRun": {
                      "content": "Today I decided to try prototyping it myself. I one-shotted a full in-browser editor in 15 minutes.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28075
            },
            {
              "endIndex": 28176,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28176,
                    "startIndex": 28175,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28175
            },
            {
              "endIndex": 28249,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28249,
                    "startIndex": 28176,
                    "textRun": {
                      "content": "It felt like I could replace the entire Adobe software suite by Sunday. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28176
            },
            {
              "endIndex": 28250,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28250,
                    "startIndex": 28249,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28249
            },
            {
              "endIndex": 28357,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28357,
                    "startIndex": 28250,
                    "textRun": {
                      "content": "Then I asked myself: will videos even be edited manually in 3 months? Chatbots can do reasonably well now.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28250
            },
            {
              "endIndex": 28358,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28358,
                    "startIndex": 28357,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28357
            },
            {
              "endIndex": 28451,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28451,
                    "startIndex": 28358,
                    "textRun": {
                      "content": "Product development is getting extraordinarily difficult when the world is changing so fast.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28358
            },
            {
              "endIndex": 28452,
              "paragraph": {
