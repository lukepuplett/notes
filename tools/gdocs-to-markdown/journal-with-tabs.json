                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 117178
            },
            {
              "endIndex": 117811,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117811,
                    "startIndex": 117484,
                    "textRun": {
                      "content": "You realize you can no longer trust the codebase. Worse, you realize that the gazillions of unit, snapshot, and e2e tests you had your clankers write are equally untrustworthy. The only thing that's still a reliable measure of \"does this work\" is manually testing the product. Congrats, you fucked yourself (and your company).\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
