                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 141476
            },
            {
              "endIndex": 141634,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 141634,
                    "startIndex": 141477,
                    "textRun": {
                      "content": "We’re now $22 below the $125 level where copper conversion payback drops below one year. At that point, every board meeting becomes a conversion discussion.\n",
                      "textStyle": {}
                    }
                  }
