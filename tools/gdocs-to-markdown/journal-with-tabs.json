                }
              },
              "startIndex": 61052
            },
            {
              "endIndex": 61073,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61073,
                    "startIndex": 61053,
                    "textRun": {
                      "content": "Miles Jennings a16z\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61053
            },
            {
              "endIndex": 61074,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61074,
                    "startIndex": 61073,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61073
            },
            {
              "endIndex": 61109,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61109,
                    "startIndex": 61074,
                    "textRun": {
                      "content": "I’m the opposite of an AI skeptic.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61074
            },
            {
              "endIndex": 61110,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61110,
                    "startIndex": 61109,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61109
            },
            {
              "endIndex": 61284,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61284,
                    "startIndex": 61110,
                    "textRun": {
                      "content": "BUT I am deeply skeptical of articles that hype-extrapolate the recent gains in AI software engineering to other fields without even mentioning determinism or verifiability…\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61110
            },
            {
              "endIndex": 61285,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61285,
                    "startIndex": 61284,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61284
            },
            {
              "endIndex": 61287,
