                }
              },
              "startIndex": 78841
            },
            {
              "endIndex": 78844,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 78844,
                    "startIndex": 78843,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 78843
            },
            {
              "endIndex": 78871,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 78871,
                    "startIndex": 78844,
                    "textRun": {
                      "content": "Retweeted by John Carmack.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 78844
            },
            {
              "endIndex": 78872,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 78872,
                    "startIndex": 78871,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 78871
            },
            {
              "endIndex": 78947,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 78947,
                    "startIndex": 78872,
                    "textRun": {
                      "content": "Is it weird that AI coding assistance is not giving me identity fracture? \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 78872
            },
            {
              "endIndex": 78948,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 78948,
                    "startIndex": 78947,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 78947
            },
            {
              "endIndex": 79260,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79260,
                    "startIndex": 78948,
                    "textRun": {
                      "content": "A lot of software developers are feeling disoriented and threatened these days. Programming by hand is clearly going the way of the buggy whip and the hand-cranked auger. Which is how we're finding out that a lot of people have their identities bound up in being good at hand-coding and how it feels to do that.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 78948
            },
            {
              "endIndex": 79261,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79261,
                    "startIndex": 79260,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79260
            },
            {
              "endIndex": 79516,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79516,
                    "startIndex": 79261,
                    "textRun": {
                      "content": "That's not me. It's not me at all. Rather to my surprise, I don't miss coding by hand, not any more than I missed writing assembler when compilers ate the world and made that unnecessary. (That was in a couple years back around 1983, for you youngsters.)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79261
            },
            {
              "endIndex": 79517,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79517,
                    "startIndex": 79516,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79516
            },
            {
              "endIndex": 79772,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79772,
                    "startIndex": 79517,
                    "textRun": {
                      "content": "Maybe the fact that I'm not feeling any of this disorientation disqualifies me from having anything to say to people who are. On the other hand...if you can learn to emulate my mental stance and be completely unbothered, maybe that would be a good thing?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79517
            },
            {
              "endIndex": 79773,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79773,
                    "startIndex": 79772,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79772
            },
            {
              "endIndex": 79855,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79855,
                    "startIndex": 79773,
                    "textRun": {
                      "content": "So. If you're a programmer, and you're feeling disoriented, try this on for size:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79773
            },
            {
              "endIndex": 79856,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 79856,
                    "startIndex": 79855,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79855
            },
            {
              "endIndex": 80030,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80030,
                    "startIndex": 79856,
                    "textRun": {
                      "content": "I like being a wizard. I like being able to speak spells, to weave complex patterns of logic that make things happen in the world. Writing code is a way to manifest my will.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 79856
            },
            {
              "endIndex": 80031,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80031,
                    "startIndex": 80030,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80030
            },
            {
              "endIndex": 80343,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80343,
                    "startIndex": 80031,
                    "textRun": {
                      "content": "Yes, I've piled up a lot of arcane knowledge over the 50 years I've been doing this. But languages of invocation, they come and they go. Been a long time since I've had any use for being able to program in 8086 assembler, and that's okay. I have better spells now, and these days some rather powerful familiars.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80031
            },
            {
              "endIndex": 80344,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80344,
                    "startIndex": 80343,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80343
            },
            {
              "endIndex": 80562,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80562,
                    "startIndex": 80344,
                    "textRun": {
                      "content": "What I'm inviting you to do is think of yourself as a wizard. Not as a person who writes code, but as a person who is good at assuming the kind of mental states required to bend reality with the application of spells.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80344
            },
            {
              "endIndex": 80563,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80563,
                    "startIndex": 80562,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80562
            },
            {
              "endIndex": 80715,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80715,
                    "startIndex": 80563,
                    "textRun": {
                      "content": "And if that's who you are, does it matter if the spells are painstakingly scribed in runes of power, versus being spoken to an obedient machine spirit?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80563
            },
            {
              "endIndex": 80716,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80716,
                    "startIndex": 80715,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80715
            },
            {
              "endIndex": 80945,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80945,
                    "startIndex": 80716,
                    "textRun": {
                      "content": "It's all one; it's all the manifestation of will. Arcane languages come and go, machine spirits appear and then diminish to be replaced by more powerful ones, but you? You are the magic-wielder. Without you, none of it happens. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80716
            },
            {
              "endIndex": 80946,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 80946,
                    "startIndex": 80945,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80945
            },
            {
              "endIndex": 81007,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 81007,
                    "startIndex": 80946,
                    "textRun": {
                      "content": "Same as it ever was. Same is it ever was. And so mote it be.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 80946
            },
            {
              "endIndex": 81008,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 81008,
                    "startIndex": 81007,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 81007
            },
