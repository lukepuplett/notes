              "paragraph": {
                "elements": [
                  {
                    "endIndex": 181229,
                    "startIndex": 181178,
                    "textRun": {
                      "content": "^ This is ill thought out with vacuous assertions.\n",
                      "textStyle": {
                        "bold": true
