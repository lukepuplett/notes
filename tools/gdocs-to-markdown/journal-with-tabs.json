              "paragraph": {
                "elements": [
                  {
                    "endIndex": 171264,
                    "startIndex": 171187,
                    "textRun": {
                      "content": "Russia's Kyshtym deposit (Chelyabinsk Oblast), operated by Russian Quartz LLC",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
