                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 179354
            },
            {
              "endIndex": 179541,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 179541,
                    "startIndex": 179355,
                    "textRun": {
                      "content": "Let's start by saying we cannot ignore the market. Anthropic is disrupting the world through Claude, with Fortune 500 companies shedding hundreds of billions of market cap as a result. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 179355
            },
            {
              "endIndex": 179542,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 179542,
                    "startIndex": 179541,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 179541
            },
            {
              "endIndex": 179763,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 179763,
                    "startIndex": 179542,
                    "textRun": {
                      "content": "It's a story we have seen several times already in 2026: Anthropic releases a new AI tool, Claude gets materially better at coding and workflow automation, and within hours the market collapses for the targeted industry.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 179542
            },
            {
              "endIndex": 179764,
