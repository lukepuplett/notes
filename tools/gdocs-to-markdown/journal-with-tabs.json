                    "textRun": {
                      "content": "The skepticism you're hearing from the likes of Rory Stewart or Alastair Campbell isn't necessarily a desire to abandon the U.S., but a fear of ",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
