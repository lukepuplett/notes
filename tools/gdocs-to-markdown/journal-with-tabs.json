                  {
                    "endIndex": 216090,
                    "startIndex": 216035,
                    "textRun": {
                      "content": "So 126% more BYDs sold in Europe last month than Tesla\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
