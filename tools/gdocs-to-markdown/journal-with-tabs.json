                      "content": "@fchollet\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 16644
            },
            {
              "endIndex": 16655,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 16655,
                    "startIndex": 16654,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 16654
            },
            {
              "endIndex": 16847,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 16847,
                    "startIndex": 16655,
                    "textRun": {
                      "content": "For non-verifiable domains, the only way you can improve AI performance at this time is via curating more annotated training data, which is expensive and only yields logarithmic improvements.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 16655
            },
            {
              "endIndex": 16848,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 16848,
                    "startIndex": 16847,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 16847
            },
            {
              "endIndex": 17122,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 17122,
                    "startIndex": 16848,
                    "textRun": {
                      "content": "And here's the thing: nearly all jobs have non-verifiable elements. There's virtually no job that's end-to-end verifiable. Even the job of a mathematician is not end-to-end verifiable. Software engineering involves many verifiable tasks, but it isn't end-to-end verifiable.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 16848
            },
            {
              "endIndex": 17123,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 17123,
                    "startIndex": 17122,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 17122
            },
            {
              "endIndex": 17382,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 17286,
                    "startIndex": 17123,
                    "textRun": {
                      "content": "For this reason the gap between \"AI can automate most of these tasks\" and \"AI can fully replace this job\" will remain for a very long time, across nearly all jobs.",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 17382,
                    "startIndex": 17286,
                    "textRun": {
                      "content": " Like with self-driving, working 99% of the time is not nearly good enough to remove the human.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 17123
            },
            {
              "endIndex": 17383,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 17383,
                    "startIndex": 17382,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 17382
            },
            {
              "endIndex": 17532,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 17532,
                    "startIndex": 17383,
                    "textRun": {
                      "content": "So even when we get superhuman Automated Theorem Provers, mathematicians will still have jobs. We might even end up with more of them (scary I know)\n",
                      "textStyle": {}
                    }
