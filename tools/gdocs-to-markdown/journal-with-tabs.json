            {
              "endIndex": 37749,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 37749,
                    "startIndex": 37507,
                    "textRun": {
                      "content": "\"AI models for generating computer code have become so efficient that we need less people. We can build more SaaS applications for more industries at a lower cost. This makes our SaaS application suites more competitive and more profitable.\"\n",
                      "textStyle": {}
                    }
