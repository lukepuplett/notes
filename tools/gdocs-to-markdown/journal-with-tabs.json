                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 160559,
                    "startIndex": 160502,
                    "textRun": {
                      "content": " (Natrium small reactors) — for steady carbon-free power\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 160458
            },
            {
              "endIndex": 160640,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 160585,
                    "startIndex": 160559,
                    "textRun": {
                      "content": "- Applied Digital: 1.0 GW ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 160607,
                    "startIndex": 160585,
                    "textRun": {
                      "content": "gas and steam turbines",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 160640,
                    "startIndex": 160607,
                    "textRun": {
                      "content": " — dedicated for dense computing\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 160559
            },
            {
              "endIndex": 160725,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 160660,
                    "startIndex": 160640,
                    "textRun": {
                      "content": "- Microsoft: 3.3 GW ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 160667,
                    "startIndex": 160660,
                    "textRun": {
                      "content": "nuclear",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 160725,
                    "startIndex": 160667,
                    "textRun": {
                      "content": " (reviving Three Mile Island) — reusing old nuclear sites\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 160640
            },
            {
              "endIndex": 160799,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 160750,
                    "startIndex": 160725,
                    "textRun": {
                      "content": "- Fermi America: 400+ MW ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 160770,
                    "startIndex": 160750,
                    "textRun": {
                      "content": "Siemens gas turbines",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 160799,
                    "startIndex": 160770,
                    "textRun": {
                      "content": " — quick on-site power setup\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 160725
            },
            {
              "endIndex": 160800,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 160800,
                    "startIndex": 160799,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 160799
            },
            {
              "endIndex": 161051,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161051,
                    "startIndex": 160800,
                    "textRun": {
                      "content": "These moves show tech companies are becoming big players in energy, not just software or cloud. The math makes sense: a 1 GW AI data center can bring in tens of billions in yearly revenue, so paying more for on-site power is worth it to avoid delays.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 160800
            },
            {
              "endIndex": 161052,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161052,
                    "startIndex": 161051,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161051
            },
            {
              "endIndex": 161110,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161110,
                    "startIndex": 161052,
                    "textRun": {
                      "content": "**Power Equipment Manufacturing and Supply Chain Limits**\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161052
            },
            {
              "endIndex": 161111,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161111,
                    "startIndex": 161110,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161110
            },
            {
              "endIndex": 161490,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161490,
                    "startIndex": 161111,
                    "textRun": {
                      "content": "The sudden need for more power setup has created a boom in making grid equipment, but it also causes new shortages. Things like high-voltage transformers and switchgear can take over two years to get, slowing down new projects even when power generation is ready. This has led companies like Siemens Energy and Hitachi Energy to spend billions building more factories in the US.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161111
            },
            {
              "endIndex": 161491,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161491,
                    "startIndex": 161490,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161490
            },
            {
              "endIndex": 161501,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 161501,
                    "startIndex": 161491,
                    "textRun": {
                      "content": "Examples:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 161491
