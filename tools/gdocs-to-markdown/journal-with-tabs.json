              "paragraph": {
                "elements": [
                  {
                    "endIndex": 6217,
                    "startIndex": 6109,
                    "textRun": {
                      "content": "Progressive disclosure- agents discovering context incrementally instead of drowning in everything upfront.\n",
                      "textStyle": {}
