              "endIndex": 179354,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 179354,
                    "startIndex": 179321,
                    "textRun": {
                      "content": "THE ANTHROPIC TAKEDOWNS ARE REAL\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 179321
            },
