              "paragraph": {
                "elements": [
                  {
                    "endIndex": 312654,
                    "startIndex": 312642,
                    "textRun": {
                      "content": "Sam Altman \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 312642
            },
            {
              "endIndex": 312655,
              "paragraph": {
                "elements": [
