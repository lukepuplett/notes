                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 193729
            },
            {
              "endIndex": 193897,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 193897,
                    "startIndex": 193730,
                    "textRun": {
                      "content": "Here is an analysis of the arguments presented in the texts and your inline commentary, evaluated through the lenses of economics, financial history, and game theory.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 193730
            },
            {
              "endIndex": 193898,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 193898,
