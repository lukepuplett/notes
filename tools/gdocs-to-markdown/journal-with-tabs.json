              "endIndex": 180075,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180075,
                    "startIndex": 179991,
                    "textRun": {
                      "content": "Adobe, $ADBE, falls -30% YTD as generative capabilities compress creative workflows\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 179991
            },
            {
              "endIndex": 180076,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180076,
