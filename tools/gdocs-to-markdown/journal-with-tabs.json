                  },
                  {
                    "endIndex": 73950,
                    "startIndex": 73882,
                    "textRun": {
                      "content": ". Instead of moving data via copper wires (which get hot and slow), ",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
