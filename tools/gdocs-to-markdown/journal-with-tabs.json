                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 8498
            },
            {
              "endIndex": 8535,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 8535,
                    "startIndex": 8499,
                    "textRun": {
                      "content": "So it’s this really exciting time.\"\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 8499
            },
            {
