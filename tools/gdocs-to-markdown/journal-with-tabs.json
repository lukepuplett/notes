                  }
                }
              },
              "startIndex": 119372
            },
            {
              "endIndex": 119627,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119627,
                    "startIndex": 119402,
                    "textRun": {
                      "content": "So now you hope your agents can fix the mess, refactor it, make it pristine. But your agents can also no longer deal with it. Because the codebase and complexity are too big, and they only ever have a local view of the mess.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
