                }
              },
              "startIndex": 11789
            },
            {
              "endIndex": 11912,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 11912,
                    "startIndex": 11790,
                    "textRun": {
                      "content": "By late 2027 we may see the first PIM (Processing In Module) designs and 48GB UMA machines for 1,000 USD with 80 tok/sec.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 11790
            },
