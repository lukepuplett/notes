                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 35046
            },
            {
              "endIndex": 35084,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 35084,
                    "startIndex": 35047,
                    "textRun": {
                      "content": "The track record says stop laughing.\n",
                      "textStyle": {}
                    }
                  }
