              "startIndex": 120661
            },
            {
              "endIndex": 120664,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 120664,
                    "startIndex": 120663,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 120663
            },
            {
              "endIndex": 121102,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121102,
                    "startIndex": 120664,
                    "textRun": {
                      "content": "^ This is a great slide. How is Zipwire a system of context? It is exactly this, it is collecting your journal and all you’re working on and potentially your struggles. This information goes on timesheets and is available to the agency and employer. Zipwire will need to scrape the sheets of situational context into date, person (person category) indexed notes and then offer an API through which to pull it into an LLM agent’s context.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 120664
            },
            {
              "endIndex": 121103,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121103,
                    "startIndex": 121102,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121102
            },
            {
              "endIndex": 121146,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121146,
                    "startIndex": 121103,
                    "textRun": {
                      "content": "^ Based on the above slides, I wrote this:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121103
            },
            {
              "endIndex": 121147,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121147,
                    "startIndex": 121146,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121146
            },
            {
              "endIndex": 121226,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121226,
                    "startIndex": 121147,
                    "textRun": {
                      "content": "The death of SaaS discourse doesn't fully address some of the shifts underway.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121147
            },
            {
              "endIndex": 121227,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121227,
                    "startIndex": 121226,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121226
            },
            {
              "endIndex": 121513,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121513,
                    "startIndex": 121227,
                    "textRun": {
                      "content": "AI is like the web in 2000 when software needed to move from an installable Windows app to a web app and then later a mobile and tablet app, allowing people to work at home and while on the move. Companies slowly moved functionality to these platforms over two decades based on demand.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121227
            },
            {
              "endIndex": 121514,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121514,
                    "startIndex": 121513,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121513
            },
            {
              "endIndex": 121663,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121663,
                    "startIndex": 121514,
                    "textRun": {
                      "content": "Today, many apps still have a dreadful old design, indicative of the difficulty changing but also the difficulty (and tremendous fear) in switching.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121514
            },
            {
              "endIndex": 121664,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121664,
                    "startIndex": 121663,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121663
            },
            {
              "endIndex": 121949,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121949,
                    "startIndex": 121664,
                    "textRun": {
                      "content": "AI enables display and voice, and wearables - working while walking the dog. Many developers who need a big screen have now stopped typing and use headsets and even foot pedal mics. Talking and watching is a new interaction paradigm and offices may get noisy, resembling call centres.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121664
            },
            {
              "endIndex": 121950,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121950,
                    "startIndex": 121949,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121949
            },
            {
              "endIndex": 122233,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122233,
                    "startIndex": 121950,
                    "textRun": {
                      "content": "Interactions are likely to be mediated by AI, where a 'browser' is a many tentacled controller displaying and mixing small pieces of content and UI. I would like to think the AI smart enough to interact with an existing website, but many old web apps will need redesigning for this.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121950
            },
            {
              "endIndex": 122234,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122234,
                    "startIndex": 122233,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122233
            },
            {
              "endIndex": 122360,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122360,
                    "startIndex": 122234,
                    "textRun": {
                      "content": "The other major shift underway is the move to onchain commerce. Cryptography is the AI dance partner no one is talking about.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122234
            },
            {
              "endIndex": 122361,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122361,
                    "startIndex": 122360,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122360
            },
            {
              "endIndex": 122692,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122692,
                    "startIndex": 122361,
                    "textRun": {
                      "content": "One way of another, we'll all end up with a wallet, certainly some kind of private-public key pair. Just having billions of users with keys allows for all kinds of things we have been missing, esp. chains of strong trust. When software can know things for sure, then it can safely automate work which had to be manually eyeballed.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122361
            },
            {
              "endIndex": 122693,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122693,
                    "startIndex": 122692,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122692
            },
            {
              "endIndex": 123004,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123004,
                    "startIndex": 122693,
                    "textRun": {
                      "content": "I believe that all commerce moves onto blockchains and systems of record are attested to. Software can go out and buy things from other software platforms using money that's provably clean instructed by someone who's provable not on (or working for anyone on) a sanctions list, and create the proofs for audit.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122693
            },
            {
              "endIndex": 123005,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123005,
                    "startIndex": 123004,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123004
            },
            {
              "endIndex": 123158,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123158,
                    "startIndex": 123005,
                    "textRun": {
                      "content": "How this impacts existing and deep-rooted software players, I don't know, but the coming software debutantes must be both AI-native + blockchain-native.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123005
            },
            {
              "endIndex": 123159,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123159,
                    "startIndex": 123158,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123158
            },
            {
              "endIndex": 123431,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123431,
                    "startIndex": 123159,
                    "textRun": {
                      "content": "If you're skeptical, then look to @tobi 's Shopify which has rapidly added both an AI assistant + x402 which is a Coinbase-led protocol enabling blockchain payments via traditional web APIs. AI agents can potentially browse and order and pay for merchandise from Shopify.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123159
            },
            {
              "endIndex": 123432,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123432,
                    "startIndex": 123431,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123431
            },
            {
              "endIndex": 123484,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123484,
                    "startIndex": 123432,
                    "textRun": {
                      "content": "Another perhaps more obvious one is @jack 's Block.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123432
            },
            {
              "endIndex": 123485,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123485,
                    "startIndex": 123484,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123484
            },
            {
              "endIndex": 123814,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123814,
                    "startIndex": 123485,
                    "textRun": {
                      "content": "I would bet that the survivors will be those selling into inertial, fearful big enterprises still running Windows Server 2008 (60% in 2019), and the thrivers will be the same as it has been since the OG boom, that is companies run by their original visionary engineers - and who have single name handles, it's not a coincidence.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123485
            },
            {
              "endIndex": 123815,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123815,
                    "startIndex": 123814,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123814
            },
            {
              "endIndex": 124300,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124300,
                    "startIndex": 123815,
                    "textRun": {
                      "content": "^ The interesting realisation for me is how there has been bifurcation already that is not discussed. People either use a Mac and modern tools, and the clueless workers use Windows and old software. The incumbent software companies will not want to radically change and their buyers won’t either, since they just want to keep their jobs - the Windows Server 2008 stat shows exactly what’s going to happen. Is it possible that the customers of these legacy SaaS companies will go bust?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123815
            },
            {
              "endIndex": 124301,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124301,
                    "startIndex": 124300,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124300
            },
            {
              "endIndex": 124303,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124303,
                    "startIndex": 124301,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124301
            },
            {
              "endIndex": 124304,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124304,
                    "startIndex": 124303,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124303
            },
            {
              "endIndex": 124393,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124393,
                    "startIndex": 124304,
                    "textRun": {
                      "content": "# Rethinking AI Tools: Why We're Reinventing the Wheel and How the Web Already Solved It\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124304
            },
            {
              "endIndex": 124394,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124394,
                    "startIndex": 124393,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124393
            },
            {
              "endIndex": 124962,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124962,
                    "startIndex": 124394,
                    "textRun": {
                      "content": "Hey everyone, I've been diving deep into how AI agents interact with tools and APIs lately, and it's got me thinking about something that's been bugging me for a while. You know those protocols like MCP (Model Context Protocol) that Anthropic put out? They're basically trying to standardize how LLMs call functions, fetch data, and plug into external systems. On the surface, it sounds great, a kind of universal connector for AI. But the more I look at it, the more it feels like we're just recreating stuff the web figured out decades ago, and not in the best way.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124394
            },
            {
              "endIndex": 124963,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124963,
                    "startIndex": 124962,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124962
            },
            {
              "endIndex": 125567,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125567,
                    "startIndex": 124963,
                    "textRun": {
                      "content": "Let me back up a bit. The web, at its core, is all about content paired with actions. A webpage isn't just text or images; it's a context with built-in tools like links and forms. When you're on a site editing your profile, you only see the relevant fields and buttons for that task. Click a link, and you're navigated to a new context with its own set of options. Forms are genius here: they tell you where to send data (the action URL), what parameters to include (input fields), and even possible values (like dropdowns). It's all self-contained, discoverable, and keeps things focused and efficient.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124963
            },
            {
              "endIndex": 125568,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125568,
                    "startIndex": 125567,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125567
            },
            {
              "endIndex": 126298,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 126298,
                    "startIndex": 125568,
                    "textRun": {
                      "content": "Now, contrast that with MCP. It's essentially JSON-RPC over various transports, where tools are discovered upfront through schemas, and the LLM decides what to call based on its reasoning. Sure, it handles things like runtime plugging in new tools or streaming results, which is handy for agents. But it reinvents links and forms in a clunky way. There's no native equivalent to a redirect shifting context seamlessly, or cookies handling auth without extra hassle. Hypermedia APIs have been doing this in JSON for years, but even they struggle because JSON doesn't have a standard for forms. MCP feels like a step sideways, born from trying to make LLMs reliable at function calling without leaning on the web's proven patterns.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125568
            },
            {
              "endIndex": 126299,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 126299,
                    "startIndex": 126298,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 126298
            },
            {
              "endIndex": 127100,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127100,
                    "startIndex": 126299,
                    "textRun": {
                      "content": "I suspect a big reason for this is skill silos in development teams. From my experience as a backend engineer who's also spent time in web and hypermedia land, backend folks love structured schemas and explicit RPC calls. It's clean, typed, and maps to what we build every day. But if you're steeped in REST as true hypermedia (HATEOAS style, where the API drives state transitions through links and controls), you see the web as the ultimate model for discoverable interfaces. MCP's design screams \"backend engineers solving AI pain points\" more than \"web natives optimizing for evolvability.\" If more web-savvy people had been in the design room, we might have ended up with something that treats HTML as the tool description language, with LLMs parsing pages and outputting HTTP requests directly.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 126299
            },
            {
              "endIndex": 127101,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127101,
                    "startIndex": 127100,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127100
            },
            {
              "endIndex": 127823,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127823,
                    "startIndex": 127101,
                    "textRun": {
                      "content": "Imagine that alternative: an LLM attached to your browser or chat app that reads the current page's content, spots the forms and links, and acts on them. You ask it to do something, it matches your intent to an affordance, crafts a POST or GET request, and the client executes it. Responses come back, redirects switch contexts, cookies handle sessions and login flows. It's stateless where it needs to be, with URLs encoding journey details reliably. No need for a whole new protocol; just train models to grok HTML better and let a thin client handle the transport. This would leverage existing hypermedia APIs, make auth straightforward (find the login form, submit creds, store the cookie), and feel way more natural.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127101
            },
            {
              "endIndex": 127824,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127824,
                    "startIndex": 127823,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127823
            },
            {
              "endIndex": 128578,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128578,
                    "startIndex": 127824,
                    "textRun": {
                      "content": "And here's where it gets exciting: this setup could revolutionize how we browse and interact with apps. An AI trained on HTML like this wouldn't just fetch and dump everything; it could intelligently select the most relevant parts of a page and display only those in its own compact chat window or mini-browser view. Think about it: no more wading through ads, sidebars, or irrelevant nav. You query for flight options, and it extracts just the results table, filters, and booking buttons, rendering a clean snippet with preserved interactivity. It could annotate why it picked those bits, collapse sections, or reformat for better readability. Browsing shifts from passive scrolling to goal-directed extraction, with the AI as your personal UI curator.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127824
            },
            {
              "endIndex": 128579,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128579,
                    "startIndex": 128578,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128578
            },
            {
              "endIndex": 129100,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129100,
                    "startIndex": 128579,
                    "textRun": {
                      "content": "Of course, this isn't without hurdles. One big one is handling dynamic JS-heavy sites, where static HTML doesn't show the full picture; you'd need better rendering or accessibility parsing. Security is another: sandboxing to prevent malicious submissions. But the real showstopper for many apps is legally important content. Disclaimers, terms of use, privacy notices, or regulatory warnings can't be filtered as \"noise.\" Stripping them could lead to liability issues, misinformation, or compliance violations like GDPR.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128579
            },
            {
              "endIndex": 129101,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129101,
                    "startIndex": 129100,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129100
            },
            {
              "endIndex": 129898,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129898,
                    "startIndex": 129101,
                    "textRun": {
                      "content": "To make this future work, we'd need a thoughtful system. Start with standardized markup: new HTML elements or attributes like role=\"legal-disclaimer\" or meta tags flagging essential sections with CSS selectors. Site owners could declare what must be preserved, building on things like schema.org or robots.txt. Then, AI smarts: train models to recognize legal patterns (all-caps blocks, specific phrases, common placements) and always include them in renders, maybe as persistent footers or expandables. Client-side enforcement helps too: the chat window applies policies to fetch and show declared legals, with user toggles for full views or summaries. Finally, regulatory support: guidelines from bodies like the W3C or FTC to mandate AI-safe rendering, with safe harbors for compliant systems.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129101
            },
            {
              "endIndex": 129899,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129899,
                    "startIndex": 129898,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129898
            },
            {
              "endIndex": 130184,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130184,
                    "startIndex": 129899,
                    "textRun": {
                      "content": "There are trade-offs, like over-preservation diluting curation or adversarial sites abusing tags. Global laws vary, so location-aware logic is key. But with consensus on standards, this could scale safely. Sites might add these markers to optimize for AI traffic, just like SEO today.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129899
            },
            {
              "endIndex": 130185,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130185,
                    "startIndex": 130184,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130184
            },
            {
              "endIndex": 130608,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130608,
                    "startIndex": 130185,
                    "textRun": {
                      "content": "In the end, MCP isn't dumb; it solves real integration pains in the agent world. But by leaning harder on the web's foundations, we could build simpler, more composable AI experiences. Models are getting better at HTML every day, so maybe the \"LLM as browser brain\" era is closer than we think. What do you folks reckon? Is this the path forward, or are dedicated protocols like MCP here to stay? Drop your thoughts below.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130185
            },
            {
              "endIndex": 130609,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130609,
                    "startIndex": 130608,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130608
            },
            {
              "endIndex": 130611,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130611,
                    "startIndex": 130609,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130609
            },
            {
              "endIndex": 130612,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130612,
                    "startIndex": 130611,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130611
            },
            {
              "endIndex": 130614,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130613,
                    "inlineObjectElement": {
                      "inlineObjectId": "kix.t8v97bie7pcv",
                      "textStyle": {}
                    },
                    "startIndex": 130612
                  },
                  {
                    "endIndex": 130614,
