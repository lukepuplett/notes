              "endIndex": 95296,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 95296,
                    "startIndex": 95274,
                    "textRun": {
                      "content": "Let’s stress-test it.\n",
                      "textStyle": {}
                    }
                  }
