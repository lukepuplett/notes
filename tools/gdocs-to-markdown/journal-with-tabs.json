                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180075
            },
            {
              "endIndex": 180139,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180139,
                    "startIndex": 180076,
                    "textRun": {
                      "content": "Cybersecurity names collapse on \"Claude Code Security\" release\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180076
            },
            {
              "endIndex": 180271,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180271,
                    "startIndex": 180139,
                    "textRun": {
                      "content": "In the above example, the crash in CrowdStrike stock, $CRWD, was literally seen the minute Claude announced \"Claude Code Security.\"\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180139
            },
            {
              "endIndex": 180272,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180272,
                    "startIndex": 180271,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180271
            },
            {
              "endIndex": 180414,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180414,
                    "startIndex": 180272,
                    "textRun": {
                      "content": "On February 20th, at 1 PM ET, Claude announced \"Claude Code Security.\" This is an automated AI tool that scans codebases for vulnerabilities.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180272
            },
            {
              "endIndex": 180415,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180415,
                    "startIndex": 180414,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180414
            },
            {
              "endIndex": 180517,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180517,
                    "startIndex": 180415,
                    "textRun": {
                      "content": "Just two trading days later, CrowdStrike stock, $CRWD, erased -$20 BILLION of market cap on the news.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180415
            },
            {
              "endIndex": 180518,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180518,
                    "startIndex": 180517,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180517
            },
            {
              "endIndex": 180729,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180729,
                    "startIndex": 180518,
                    "textRun": {
                      "content": "These reactions are not irrational. Markets try to price real time margin compression. When AI replicates what workers do, pricing power shifts to the buyer. That is the first-order impact, and it is very real.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180518
            },
            {
              "endIndex": 180730,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180730,
                    "startIndex": 180729,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180729
            },
            {
              "endIndex": 180981,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180981,
                    "startIndex": 180730,
                    "textRun": {
                      "content": "Commoditization is not collapse. Rather, it is how technology lowers costs and expands access. The personal computer commoditized computing, the internet commoditized distribution, cloud commoditized infrastructure, and AI is commoditizing cognition.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180730
            },
            {
              "endIndex": 180982,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 180982,
                    "startIndex": 180981,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180981
            },
            {
              "endIndex": 181177,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 181177,
                    "startIndex": 180982,
                    "textRun": {
                      "content": "There is no question that some legacy workflows will experience compression of margins. The question is, do lower cognitive costs collapse the economy or do they allow it to expand dramatically?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 180982
            },
            {
              "endIndex": 181178,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 181178,
                    "startIndex": 181177,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 181177
            },
            {
