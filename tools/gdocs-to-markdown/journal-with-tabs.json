            },
            {
              "endIndex": 197278,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 197153,
                    "startIndex": 196975,
                    "textRun": {
                      "content": "The \"Power Wall\" Trumps the \"Intelligence Explosion\": Software scales exponentially; physical infrastructure scales logarithmically. You cannot soft-code a gigawatt transformer. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 197276,
                    "startIndex": 197153,
                    "textRun": {
                      "content": "The 5-to-10-year lead time for power grids will act as a hard macroeconomic brake on Citrini’s fast-paced doomsday scenario",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
