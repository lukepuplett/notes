              "endIndex": 23983,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 23983,
                    "startIndex": 23973,
                    "textRun": {
                      "content": "My reply:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 23973
            },
            {
              "endIndex": 23984,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 23984,
                    "startIndex": 23983,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 23983
            },
            {
              "endIndex": 23997,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 23997,
                    "startIndex": 23984,
                    "textRun": {
                      "content": "Luke Puplett\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 23984
            },
            {
              "endIndex": 24010,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24010,
                    "startIndex": 23997,
                    "textRun": {
                      "content": "@lukepuplett\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 23997
            },
            {
              "endIndex": 24011,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24011,
                    "startIndex": 24010,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24010
            },
            {
              "endIndex": 24051,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24051,
                    "startIndex": 24011,
                    "textRun": {
                      "content": "The Humanity Moat and the Quartz Crisis\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24011
            },
            {
              "endIndex": 24052,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24052,
                    "startIndex": 24051,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24051
            },
            {
              "endIndex": 24134,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24134,
                    "startIndex": 24052,
                    "textRun": {
                      "content": "Ancient books like The Tale of Genji read well today because people don't change.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24052
            },
            {
              "endIndex": 24135,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24135,
                    "startIndex": 24134,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24134
            },
            {
              "endIndex": 24170,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24170,
                    "startIndex": 24135,
                    "textRun": {
                      "content": "Ask yourself what will not change.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24135
            },
            {
              "endIndex": 24171,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24171,
                    "startIndex": 24170,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24170
            },
            {
              "endIndex": 24252,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24252,
                    "startIndex": 24171,
                    "textRun": {
                      "content": "One example: consultancies shouldn't exist. Software hasn't ever been that hard.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24171
            },
            {
              "endIndex": 24253,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24253,
                    "startIndex": 24252,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24252
            },
            {
              "endIndex": 24412,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24412,
                    "startIndex": 24253,
                    "textRun": {
                      "content": "To a techie, hearing from your mate at a consultancy the huge sums they make with dozens in meetings and posh dinners just to copy some files, is bewildering.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24253
            },
            {
              "endIndex": 24413,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24413,
                    "startIndex": 24412,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24412
            },
            {
              "endIndex": 24676,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24676,
                    "startIndex": 24413,
                    "textRun": {
                      "content": "But the consultancy is providing signalling, and a scapegoat for a group of egos who want reassurance, diffusion of responsibility and to remain immortal in power, and posh dinners to keep everyone feeling above the plebs. The high fees are a feature, not a bug.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24413
            },
            {
              "endIndex": 24677,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24677,
                    "startIndex": 24676,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24676
            },
            {
              "endIndex": 24720,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24720,
                    "startIndex": 24677,
                    "textRun": {
                      "content": "A consultancy is an expensive Swiss watch.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24677
            },
            {
              "endIndex": 24721,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24721,
                    "startIndex": 24720,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24720
            },
            {
              "endIndex": 24747,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24747,
                    "startIndex": 24721,
                    "textRun": {
                      "content": "What else stays the same?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24721
            },
            {
              "endIndex": 24748,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 24748,
                    "startIndex": 24747,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24747
            },
            {
              "endIndex": 25043,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25043,
                    "startIndex": 24748,
                    "textRun": {
                      "content": "People settle into their inner script. We have things we enjoy and are comfortable doing. So do groups of people in companies. We specialise and trade because 'we don't do' that other thing. We go to our boss, 'we should do x', boss says 'we don't do x'. Huh?! But that identity binds the team.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 24748
            },
            {
              "endIndex": 25044,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25044,
                    "startIndex": 25043,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25043
            },
            {
              "endIndex": 25170,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25170,
                    "startIndex": 25044,
                    "textRun": {
                      "content": "And we work in networks. We favour our friend's thing, we choose who we want to help out or who's too close. We're CV driven.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25044
            },
            {
              "endIndex": 25171,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25171,
                    "startIndex": 25170,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25170
            },
            {
              "endIndex": 25310,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25310,
                    "startIndex": 25171,
                    "textRun": {
                      "content": "Clayton Christensen coined the phrase Disruptive Innovation, but he also defined Jobs to Be Done, which shows that people remain the same.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25171
            },
            {
              "endIndex": 25311,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25311,
                    "startIndex": 25310,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25310
            },
            {
              "endIndex": 25370,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25370,
                    "startIndex": 25311,
                    "textRun": {
                      "content": "What are those future obsolete companies _really_ selling?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25311
            },
            {
              "endIndex": 25371,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25371,
                    "startIndex": 25370,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25370
            },
            {
              "endIndex": 25373,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25373,
                    "startIndex": 25371,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25371
            },
            {
              "endIndex": 25374,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25374,
                    "startIndex": 25373,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25373
            },
            {
              "endIndex": 25394,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25394,
                    "startIndex": 25374,
                    "textRun": {
                      "content": "The Kobeissi Letter\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25374
            },
            {
              "endIndex": 25410,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25410,
                    "startIndex": 25394,
                    "textRun": {
                      "content": "@KobeissiLetter\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25394
            },
            {
              "endIndex": 25411,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25411,
                    "startIndex": 25410,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25410
            },
            {
              "endIndex": 25571,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25571,
                    "startIndex": 25411,
                    "textRun": {
                      "content": "BREAKING: China has instructed banks to begin selling and limit purchases of US government bonds amid concerns that \"US debt may expose banks to sharp swings.\"\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25411
            },
            {
              "endIndex": 25572,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25572,
                    "startIndex": 25571,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25571
            },
            {
              "endIndex": 25574,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25574,
                    "startIndex": 25572,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25572
            },
            {
              "endIndex": 25575,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25575,
                    "startIndex": 25574,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25574
            },
            {
              "endIndex": 25585,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25585,
                    "startIndex": 25575,
                    "textRun": {
                      "content": "David Orr\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25575
            },
            {
              "endIndex": 25595,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25595,
                    "startIndex": 25585,
                    "textRun": {
                      "content": "@orrdavid\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25585
            },
            {
              "endIndex": 25596,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25596,
                    "startIndex": 25595,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25595
            },
            {
              "endIndex": 25754,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25754,
                    "startIndex": 25596,
                    "textRun": {
                      "content": "It cannot be stressed enough how big a variable it is for Japan to change their constitution.  This would make China's ambition to conquer Taiwan impossible.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25596
            },
            {
              "endIndex": 25755,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25755,
                    "startIndex": 25754,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25754
            },
            {
              "endIndex": 25910,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25910,
                    "startIndex": 25755,
                    "textRun": {
                      "content": "It would take a while for Japan to build up a strong military, so this could pressure China to take action earlier, before it becomes impossible entirely.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25755
            },
            {
              "endIndex": 25911,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25911,
                    "startIndex": 25910,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25910
            },
            {
              "endIndex": 25960,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25960,
                    "startIndex": 25911,
                    "textRun": {
                      "content": "Today is a great day for the eastern free world.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25911
            },
            {
              "endIndex": 25961,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25961,
                    "startIndex": 25960,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25960
            },
            {
              "endIndex": 25974,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25974,
                    "startIndex": 25961,
                    "textRun": {
                      "content": "^ Grok says:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25961
            },
            {
              "endIndex": 25975,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 25975,
                    "startIndex": 25974,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25974
            },
            {
              "endIndex": 26378,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 26378,
                    "startIndex": 25975,
                    "textRun": {
                      "content": "Prime Minister Sanae Takaichi and her Liberal Democratic Party (LDP) won a landslide victory, securing a supermajority (around 316 seats) in the lower house. This strengthens the push to revise Japan's pacifist Constitution, specifically Article 9, which renounces war and limits military forces to self-defense (the Japan Self-Defense Forces exist but aren't explicitly recognized as a full military).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 25975
            },
            {
              "endIndex": 26379,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 26379,
                    "startIndex": 26378,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 26378
            },
            {
              "endIndex": 26896,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 26896,
                    "startIndex": 26379,
                    "textRun": {
                      "content": "Orr argues that amending the constitution would enable Japan to build a stronger, more capable military over time, making a Chinese invasion of Taiwan far more difficult or \"impossible\" due to Japan's geographic proximity, alliance with the US, and potential role in regional defense. He suggests this could force China to act sooner (before Japan fully rearms), and calls it \"a great day for the eastern free world\" — viewing it as a win for anti-China/anti-expansion forces in East Asia (Japan, Taiwan, US allies).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
