                    "startIndex": 228677,
                    "textRun": {
                      "content": "Adoption Rate of Generative AI at Work and Home versus the Rate for Other Technologies\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
