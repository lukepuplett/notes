                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28455
            },
            {
              "endIndex": 28501,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28501,
                    "startIndex": 28500,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28500
            },
            {
              "endIndex": 28651,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28651,
                    "startIndex": 28501,
                    "textRun": {
                      "content": "Alphabet looking to issue a 100-year bond. Last time this happened was Motorola in 1997, which was the last year Motorola was considered a big deal. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28501
            },
            {
              "endIndex": 28652,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28652,
                    "startIndex": 28651,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28651
            },
            {
              "endIndex": 28763,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28763,
                    "startIndex": 28652,
                    "textRun": {
                      "content": "At the start of 1997, Motorola was a top 25 market cap and top 25 revenue corporation in America. Never again.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28652
            },
            {
              "endIndex": 28846,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28846,
                    "startIndex": 28763,
                    "textRun": {
                      "content": "The Motorola corporate brand in 1997 was ranked #1 in the US, ahead of Microsoft. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28763
            },
            {
              "endIndex": 28847,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28847,
                    "startIndex": 28846,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 28846
            },
            {
              "endIndex": 28951,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 28951,
                    "startIndex": 28847,
                    "textRun": {
                      "content": "In 1998, Nokia overtook Motorola in cell phones, and after the iPhone it fell out of the consumer eye. \n",
                      "textStyle": {}
                    }
                  }
