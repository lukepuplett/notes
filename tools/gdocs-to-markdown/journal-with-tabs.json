                  {
                    "endIndex": 14,
                    "startIndex": 2,
                    "textRun": {
                      "content": "## Summary:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
