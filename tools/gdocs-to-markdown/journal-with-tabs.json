                }
              },
              "startIndex": 52693
            },
            {
              "endIndex": 52706,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 52706,
                    "startIndex": 52705,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
