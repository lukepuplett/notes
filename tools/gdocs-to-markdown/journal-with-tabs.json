              "startIndex": 196651
            },
            {
              "endIndex": 196898,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 196898,
                    "startIndex": 196652,
                    "textRun": {
                      "content": "The Apprenticeship Bottleneck: You ask \"what kids will grow up doing differently.\" If AI automates all entry-level white-collar work, humans cannot get the reps required to become senior experts. This breaks the human capital formation pipeline.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
