              "endIndex": 175861,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 175861,
                    "startIndex": 175731,
                    "textRun": {
                      "content": "Recycling recovers silicon at ~93.4% purity, insufficient for solar/chip reuse. PV waste is projected at 78 million tons by 2050.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
