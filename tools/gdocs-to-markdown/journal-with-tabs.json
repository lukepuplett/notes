                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 113824
            },
            {
              "endIndex": 114896,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 114896,
                    "startIndex": 114631,
                    "textRun": {
                      "content": "Now again, this can work for your side project barely anyone is using, including yourself. And hey, maybe there's somebody out there who can actually make this work for a software product that's not a steaming pile of garbage and is used by actual humans in anger.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 114631
            },
            {
              "endIndex": 115058,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 115058,
                    "startIndex": 114896,
                    "textRun": {
                      "content": "If that's you, more power to you. But at least among my circle of peers I have yet to find evidence that this kind of shit works. Maybe we all have skill issues.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 114896
            },
            {
              "endIndex": 115131,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 115131,
                    "startIndex": 115058,
                    "textRun": {
                      "content": "Compounding booboos with zero learning, no bottlenecks, and delayed pain\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "bold": true,
                        "fontSize": {
                          "magnitude": 15.5,
                          "unit": "PT"
                        },
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {}
                          }
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Arial",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "headingId": "h.ehbp899rh0ig",
                  "keepLinesTogether": false,
                  "keepWithNext": false,
                  "lineSpacing": 100,
                  "namedStyleType": "HEADING_3",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 115058
            },
            {
              "endIndex": 115540,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 115540,
                    "startIndex": 115131,
                    "textRun": {
                      "content": "The problem with agents is that they make errors. Which is fine, humans also make errors. Maybe they are just correctness errors. Easy to identify and fix. Add a regression test on top for bonus points. Or maybe it's a code smell your linter doesn't catch. A useless method here, a type that doesn't make sense, duplicated code over there. On their own, these are harmless. A human will also do such booboos.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 115131
            },
            {
              "endIndex": 115749,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 115749,
                    "startIndex": 115540,
                    "textRun": {
                      "content": "But clankers aren't humans. A human makes the same error a few times. Eventually they learn not to make it again. Either because someone starts screaming at them or because they're on a genuine learning path.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 115540
            },
            {
              "endIndex": 115985,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 115985,
                    "startIndex": 115749,
                    "textRun": {
                      "content": "An agent has no such learning ability. At least not out of the box. It will continue making the same errors over and over again. Depending on the training data it might also come up with glorious new interpolations of different errors.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 115749
            },
            {
              "endIndex": 116309,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116309,
                    "startIndex": 115985,
                    "textRun": {
                      "content": "Now you can try to teach your agent. Tell it to not make that booboo again in your AGENTS.md. Concoct the most complex memory system and have it look up previous errors and best practices. And that can be effective for a specific category of errors. But it also requires you to actually observe the agent making that error.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 115985
            },
            {
              "endIndex": 116843,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 116843,
                    "startIndex": 116309,
                    "textRun": {
                      "content": "There's a much more important difference between clanker and human. A human is a bottleneck. A human cannot shit out 20,000 lines of code in a few hours. Even if the human creates such booboos at high frequency, there's only so many booboos the human can introduce in a codebase per day. The booboos will compound at a very slow rate. Usually, if the booboo pain gets too big, the human, who hates pain, will spend some time fixing up the booboos. Or the human gets fired and someone else fixes up the booboos. So the pain goes away.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderTop": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 116309
            },
            {
              "endIndex": 117178,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117178,
                    "startIndex": 116843,
                    "textRun": {
                      "content": "With an orchestrated army of agents, there is no bottleneck, no human pain. These tiny little harmless booboos suddenly compound at a rate that's unsustainable. You have removed yourself from the loop, so you don't even know that all the innocent booboos have formed a monster of a codebase. You only feel the pain when it's too late.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderBottom": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderLeft": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "borderRight": {
                    "color": {},
