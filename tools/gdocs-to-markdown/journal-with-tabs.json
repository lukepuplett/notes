                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33048
            },
            {
              "endIndex": 33120,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33120,
                    "startIndex": 33049,
                    "textRun": {
                      "content": "To view keyboard shortcuts, press question markView keyboard shortcuts\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
