                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5744
            },
            {
              "endIndex": 5827,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5827,
                    "startIndex": 5745,
                    "textRun": {
                      "content": "Claude Opus 4.5 scores 42% on CORE-Bench with one scaffold and 78% with another. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5745
            },
            {
              "endIndex": 5882,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5882,
                    "startIndex": 5827,
                    "textRun": {
                      "content": "Cursor's lazy tool loading cuts token usage by 46.9%. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5827
            },
            {
              "endIndex": 5981,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5981,
                    "startIndex": 5882,
                    "textRun": {
                      "content": "Vercel deleted 80% of their agent's tools and watched it go from failing tasks to completing them.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5882
            },
            {
              "endIndex": 5982,
              "paragraph": {
                "elements": [
                  {
