                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103316
            },
            {
              "endIndex": 103328,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103328,
                    "startIndex": 103317,
                    "textRun": {
                      "content": "Josh Wolfe\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103317
            },
            {
              "endIndex": 103339,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103339,
                    "startIndex": 103328,
                    "textRun": {
                      "content": "@wolfejosh\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103328
            },
            {
              "endIndex": 103340,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103340,
                    "startIndex": 103339,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103339
            },
            {
              "endIndex": 103364,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103364,
                    "startIndex": 103340,
                    "textRun": {
                      "content": "The Arctic Smokescreen \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103340
            },
            {
              "endIndex": 103365,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103365,
                    "startIndex": 103364,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103364
            },
            {
              "endIndex": 103446,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103446,
                    "startIndex": 103365,
                    "textRun": {
                      "content": "The most dangerous mistake about \"Greenland  is believing it is about Greenland.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103365
            },
            {
              "endIndex": 103447,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103447,
                    "startIndex": 103446,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103446
            },
            {
              "endIndex": 103819,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103819,
                    "startIndex": 103447,
                    "textRun": {
                      "content": "We are told this is a diplomatic spat, a real estate obsession, a chaotic throwback to 19th-century imperialism. The press treats it as spectacle. Commentators debate whether the administration is serious or simply trolling. Europeans express outrage at the affront to sovereignty. The whole affair is framed as noise: eccentric, embarrassing, ultimately inconsequential.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103447
            },
            {
              "endIndex": 103820,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103820,
                    "startIndex": 103819,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103819
            },
            {
              "endIndex": 103874,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103874,
                    "startIndex": 103820,
                    "textRun": {
                      "content": "This framing is comfortable. And almost surely wrong.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103820
            },
            {
              "endIndex": 103875,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103875,
                    "startIndex": 103874,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103874
            },
            {
              "endIndex": 104156,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104156,
                    "startIndex": 103875,
                    "textRun": {
                      "content": "The conventional reading of the Greenland saga is diplomatic incompetence in real time. The administration threatens force, gets rebuffed, escalates, gets rebuffed again, then retreats to the language of a purchase. Commentators shake their heads. Europeans express bewilderment. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103875
            },
            {
              "endIndex": 104157,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104157,
                    "startIndex": 104156,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104156
            },
            {
              "endIndex": 104326,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104326,
                    "startIndex": 104157,
                    "textRun": {
                      "content": "What looks like flailing is a classic Trump-style negotiation sequence. You open with an outrageous demand precisely so your real demand seems reasonable by comparison.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104157
            },
            {
              "endIndex": 104327,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104327,
                    "startIndex": 104326,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104326
            },
            {
              "endIndex": 104643,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104643,
                    "startIndex": 104327,
                    "textRun": {
                      "content": "It goes like this: Signal acquisition. Denmark scoffs. Mention force. Denmark recoils. Insist on force, loudly, repeatedly. Denmark reaches peak indignation. Others come to their side. Then pivot. A purchase offer that eliminates Denmark's entire national debt ($142B) and nearly doubles Greenland's GDP (~$450B)...\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104327
            },
            {
              "endIndex": 104719,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104719,
                    "startIndex": 104643,
                    "textRun": {
                      "content": "And suddenly the question is no longer \"how dare you\" but \"wait, how much?\"\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104643
            },
            {
              "endIndex": 104720,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104720,
                    "startIndex": 104719,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104719
            },
            {
              "endIndex": 104921,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104921,
                    "startIndex": 104720,
                    "textRun": {
                      "content": "The force rhetoric was never the plan. It was the anchor. Denmark is no longer defending sovereignty against an imperial aggressor; Denmark is evaluating a financial proposition. The frame has moved. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104720
            },
            {
              "endIndex": 104922,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104922,
                    "startIndex": 104921,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104921
            },
            {
              "endIndex": 104955,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104955,
                    "startIndex": 104922,
                    "textRun": {
                      "content": "And i feel crazy saying this... \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104922
            },
            {
              "endIndex": 104956,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 104956,
                    "startIndex": 104955,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104955
            },
            {
              "endIndex": 105295,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 105295,
                    "startIndex": 104956,
                    "textRun": {
                      "content": "The math is not absurd. The deal probably pays for itself within a generation. The minerals alone are worth multiples of the purchase price. Greenland's 57,000 residents become millionaires on paper. Denmark sheds a fiscal dependent and erases its debt. The United States secures the rare earth supply chain for the military of the 2030s.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 104956
            },
            {
              "endIndex": 105296,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 105296,
                    "startIndex": 105295,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 105295
            },
            {
              "endIndex": 105604,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 105398,
                    "startIndex": 105296,
                    "textRun": {
                      "content": "What is actually underway is a supply chain annexation dressed in the costume of territorial ambition.",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 105604,
                    "startIndex": 105398,
                    "textRun": {
                      "content": " The target is not an island; it is two geological formations in Southern Greenland—Kvanefjeld and Tanbreez—that contain the heavy rare earth elements without which no advanced weapons system can be built.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 105296
            },
            {
              "endIndex": 105605,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 105605,
                    "startIndex": 105604,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 105604
            },
            {
              "endIndex": 105998,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 105998,
                    "startIndex": 105605,
                    "textRun": {
                      "content": "Dysprosium. Terbium. Names that mean nothing to the public but everything to the Pentagon. These elements are irreplaceable in the actuators of F-35 fighters, the guidance fins of precision munitions, the sonar arrays of Virginia-class submarines, and the permanent magnets of every electric vehicle motor. China controls over 90% of global processing. The United States controls almost none.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 105605
            },
            {
              "endIndex": 105999,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 105999,
                    "startIndex": 105998,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 105998
            },
            {
              "endIndex": 106086,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106086,
                    "startIndex": 105999,
                    "textRun": {
                      "content": "The \"purchase\" of Greenland is not a land deal. It is an attempt to break a chokehold.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 105999
            },
            {
              "endIndex": 106087,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106087,
                    "startIndex": 106086,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106086
            },
            {
              "endIndex": 106254,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106254,
                    "startIndex": 106087,
                    "textRun": {
                      "content": "In 2026, prediction markets have become the closest thing we have to honest price signals on geopolitical risk. And right now, they are telling two different stories.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106087
            },
            {
              "endIndex": 106255,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106255,
                    "startIndex": 106254,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106254
            },
            {
              "endIndex": 106487,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106487,
                    "startIndex": 106255,
                    "textRun": {
                      "content": "Kalshi, the US-regulated exchange, prices the probability of American acquisition of Greenland at roughly 42%. Polymarket, the decentralized platform populated by global crypto-natives and offshore speculators, prices it at 15-23%.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106255
            },
            {
              "endIndex": 106488,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106488,
                    "startIndex": 106487,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106487
            },
            {
              "endIndex": 106571,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106571,
                    "startIndex": 106488,
                    "textRun": {
                      "content": "This is not market inefficiency but more a disagreement about the nature of power.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106488
            },
            {
              "endIndex": 106572,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106572,
                    "startIndex": 106571,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106571
            },
            {
              "endIndex": 106921,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106921,
                    "startIndex": 106572,
                    "textRun": {
                      "content": "The Kalshi bettors—institutional, US-based, integrated into the American financial system—believe the administration will force the deal through. They are pricing coercion. The Polymarket bettors—international, skeptical of American omnipotence, often operating outside US jurisdiction—believe European resistance will hold. They are pricing norms.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106572
            },
            {
              "endIndex": 106922,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 106922,
                    "startIndex": 106921,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106921
            },
            {
              "endIndex": 107183,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107183,
                    "startIndex": 106922,
                    "textRun": {
                      "content": "The 20-point spread between these markets is the most important signal in the world right now. If Polymarket moves up to meet Kalshi, it means the global \"smart money\" has accepted that the United States will break international law to secure the Arctic flank.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 106922
            },
            {
              "endIndex": 107184,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107184,
                    "startIndex": 107183,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107183
            },
            {
              "endIndex": 107549,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107549,
                    "startIndex": 107184,
                    "textRun": {
                      "content": "There is precedent for such acceptance. Weeks ago, a trader placed a $32,000 bet on the ouster of Venezuelan President Nicolás Maduro and netted over $400,000 when US forces captured him. The \"Maduro Effect\" has recalibrated risk appetites across every geopolitical market. Traders are no longer pricing diplomatic negotiations. They are pricing hostile takeovers.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107184
            },
            {
              "endIndex": 107550,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107550,
                    "startIndex": 107549,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107549
            },
            {
              "endIndex": 107576,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107576,
                    "startIndex": 107550,
                    "textRun": {
                      "content": "The Three-Theater Squeeze\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107550
            },
            {
              "endIndex": 107577,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107577,
                    "startIndex": 107576,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107576
            },
            {
              "endIndex": 107745,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107745,
                    "startIndex": 107577,
                    "textRun": {
                      "content": "The average observer sees three separate news stories: a trade dispute with Europe, a strange fixation on Greenland, and some localized internet outages in the Baltic.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107577
            },
            {
              "endIndex": 107746,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107746,
                    "startIndex": 107745,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107745
            },
            {
              "endIndex": 107822,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107822,
                    "startIndex": 107746,
                    "textRun": {
                      "content": "These are not separate stories. They are three fronts of a single conflict.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107746
            },
            {
              "endIndex": 107823,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 107823,
                    "startIndex": 107822,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107822
            },
            {
              "endIndex": 108142,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 108142,
                    "startIndex": 107823,
                    "textRun": {
                      "content": "The Resource Front: The administration is securing the mineral inputs for the military of the 2030s. The Tanbreez deposit—rich in heavy rare earths, free of uranium complications, owned by Western interests—is the crown jewel. The neighboring Kvanefjeld deposit, which has Chinese equity participation through Shenghe \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 107823
            },
            {
              "endIndex": 108143,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 108143,
                    "startIndex": 108142,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 108142
            },
            {
              "endIndex": 108222,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 108222,
                    "startIndex": 108143,
                    "textRun": {
                      "content": "Resources, is the problem to be neutralized. Control of Greenland solves both.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 108143
            },
            {
              "endIndex": 108223,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 108223,
                    "startIndex": 108222,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 108222
            },
            {
              "endIndex": 108680,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 108680,
                    "startIndex": 108223,
                    "textRun": {
                      "content": "The Economic Front: The tariffs announced against Denmark, France, Germany, the UK, and four other European nations are not protectionist measures. They are precision-guided economic strikes against political dissenters. The £31 billion US-UK Tech Prosperity Deal—Microsoft's data centers, Google's R&D investment—has been suspended indefinitely. The message is unambiguous: alignment with American geopolitical objectives is the price of American capital.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 108223
            },
            {
              "endIndex": 108681,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 108681,
                    "startIndex": 108680,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 108680
            },
            {
              "endIndex": 109164,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109164,
                    "startIndex": 108681,
                    "textRun": {
                      "content": "The Kinetic Front: While diplomats argue over tariffs, Russian vessels drag anchors across Baltic telecommunications cables. The cargo ship Fitburg, seized by Finnish and Estonian authorities, is part of the \"Shadow Fleet\"—vessels with opaque ownership that operate below the threshold of open war. These are not accidents. They are shaping operations, mapping vulnerabilities, demonstrating the capacity to sever the digital infrastructure that binds the Western alliance together.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 108681
            },
            {
              "endIndex": 109165,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109165,
                    "startIndex": 109164,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109164
            },
            {
              "endIndex": 109325,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109325,
                    "startIndex": 109165,
                    "textRun": {
                      "content": "The average observer sees chaos. The intelligence reality is coherence: resource acquisition, economic coercion, and kinetic preparation, operating in concert.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109165
            },
            {
              "endIndex": 109326,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109326,
                    "startIndex": 109325,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109325
            },
            {
              "endIndex": 109349,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109349,
                    "startIndex": 109326,
                    "textRun": {
                      "content": "The Rules-Based Mirage\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109326
            },
            {
              "endIndex": 109350,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109350,
                    "startIndex": 109349,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109349
            },
            {
              "endIndex": 109552,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109552,
                    "startIndex": 109350,
                    "textRun": {
                      "content": "The European response to all of this has been to invoke international law, sovereignty, and the rules-based order. These invocations are emotionally satisfying. They are also strategically meaningless.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109350
            },
            {
              "endIndex": 109553,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109553,
                    "startIndex": 109552,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109552
            },
            {
              "endIndex": 109915,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109915,
                    "startIndex": 109553,
                    "textRun": {
                      "content": "International law functions only among actors who agree to be constrained by it. It assumes a mutual understanding of legitimacy, a shared framework of rules, and an enforcement mechanism capable of compelling compliance. None of these conditions hold. There is no global sovereign. There is no monopoly on force. Agreements endure only until interests diverge.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109553
            },
            {
              "endIndex": 109916,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 109916,
                    "startIndex": 109915,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109915
            },
            {
              "endIndex": 110201,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110055,
                    "startIndex": 109916,
                    "textRun": {
                      "content": "The United States has decided that securing rare earth supply chains is more important than maintaining the post-war settlement with Europe",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 110201,
                    "startIndex": 110055,
                    "textRun": {
                      "content": ". The prediction markets have priced this in. The cable sabotage operations have demonstrated it. The tariff announcements have made it explicit.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 109916
            },
            {
              "endIndex": 110202,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110202,
                    "startIndex": 110201,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110201
            },
            {
              "endIndex": 110508,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110508,
                    "startIndex": 110202,
                    "textRun": {
                      "content": "European leaders can invoke norms. They cannot enforce them. And actors who openly reject the framework—whether by dragging anchors across undersea cables or by demanding territorial concessions under economic duress—gain advantage over those who internalize constraints the other side does not recognize.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110202
            },
            {
              "endIndex": 110509,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110509,
                    "startIndex": 110508,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110508
            },
            {
              "endIndex": 110753,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110753,
                    "startIndex": 110509,
                    "textRun": {
                      "content": "This is the asymmetry of the current moment. It is not new. Thucydides identified it twenty-five centuries ago: the strong do what they can, and the weak suffer what they must. The innovation of 2026 is the speed at which the mask has slipped.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110509
            },
            {
              "endIndex": 110754,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110754,
                    "startIndex": 110753,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110753
            },
            {
              "endIndex": 110779,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110779,
                    "startIndex": 110754,
                    "textRun": {
                      "content": "The Signal and the Noise\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110754
            },
            {
              "endIndex": 110780,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110780,
                    "startIndex": 110779,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110779
            },
            {
              "endIndex": 110936,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110936,
                    "startIndex": 110780,
                    "textRun": {
                      "content": "The public narrative offers comfort: this is chaos, incompetence, a diplomatic embarrassment that will resolve itself. The operational reality offers none.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110780
            },
            {
              "endIndex": 110937,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 110937,
                    "startIndex": 110936,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110936
            },
            {
              "endIndex": 111260,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111260,
                    "startIndex": 110937,
                    "textRun": {
                      "content": "The US is annexing a supply chain. Europe is being coerced into alignment. Russia is probing the infrastructure that holds the alliance together. The public is fragmented across information silos that prevent collective response. Prediction markets are pricing outcomes that official discourse still treats as unthinkable.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 110937
            },
            {
              "endIndex": 111261,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111261,
                    "startIndex": 111260,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111260
            },
            {
              "endIndex": 111549,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111549,
                    "startIndex": 111261,
                    "textRun": {
                      "content": "The statements in the press are not meaningless. But they're rarely decisive. The decisive forces operate quietly, guided not by norms but by leverage, not by law but by geology, not by principle but by the irreducible logic of who controls the inputs for the next generation of weapons.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111261
            },
            {
              "endIndex": 111550,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111550,
                    "startIndex": 111549,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111549
            },
            {
              "endIndex": 111595,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111595,
                    "startIndex": 111550,
                    "textRun": {
                      "content": "^ This is aligned with my thinking entirely.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111550
            },
            {
              "endIndex": 111596,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111596,
                    "startIndex": 111595,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111595
            },
            {
              "endIndex": 111598,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111598,
                    "startIndex": 111596,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111596
            },
            {
              "endIndex": 111599,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111599,
                    "startIndex": 111598,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111598
            },
            {
              "endIndex": 111612,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111612,
                    "startIndex": 111599,
                    "textRun": {
                      "content": "David Marcus\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111599
            },
            {
              "endIndex": 111625,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111625,
                    "startIndex": 111612,
                    "textRun": {
                      "content": "@davidmarcus\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111612
            },
            {
              "endIndex": 111626,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111626,
                    "startIndex": 111625,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111625
            },
            {
              "endIndex": 111783,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111783,
                    "startIndex": 111626,
                    "textRun": {
                      "content": "Somewhat hot take: a majority of SaaS companies are screwed and they don't know it yet. Companies will build their own tools with AI at an accelerated rate.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111626
            },
            {
              "endIndex": 111784,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111784,
                    "startIndex": 111783,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111783
            },
            {
              "endIndex": 111970,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111970,
                    "startIndex": 111784,
                    "textRun": {
                      "content": "^ One guy points out that anyone can cook but we still prefer restaurants. The following reply is probably more like it, because honestly, most people don’t do this, only big companies.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111784
            },
            {
              "endIndex": 111971,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111971,
                    "startIndex": 111970,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111970
            },
            {
              "endIndex": 111979,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111979,
                    "startIndex": 111971,
                    "textRun": {
                      "content": "Runemir\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111971
            },
            {
              "endIndex": 111990,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111990,
                    "startIndex": 111979,
                    "textRun": {
                      "content": "@RunemirQi\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111979
            },
            {
              "endIndex": 111991,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 111991,
                    "startIndex": 111990,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111990
            },
            {
              "endIndex": 112144,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 112144,
                    "startIndex": 111991,
                    "textRun": {
                      "content": "The meat is in small businesses. Build tools for mass consumption (freelancers, sole business owners), charge 10 bucks per month, and people will come. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 111991
            },
            {
              "endIndex": 112145,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 112145,
                    "startIndex": 112144,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 112144
            },
            {
              "endIndex": 112231,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 112231,
                    "startIndex": 112145,
                    "textRun": {
                      "content": "They don't have time to build tools; most people aren't even wired to do such things.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 112145
            },
            {
              "endIndex": 112232,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 112232,
                    "startIndex": 112231,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 112231
            },
            {
              "endIndex": 112683,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 112683,
                    "startIndex": 112232,
                    "textRun": {
                      "content": "^ I’ve felt this picking up pennies in front of AGI since ChatGPT ate my GPT API app in progress, but does this mean more bedroom developers helping small businesses, and when do they choose to get paid for that work vs. try to sell the app? \u000b\u000bWill companies make their own versions if the price and experience of a SaaS tool is great, and it’s just plugged in to an many tentacled AI that automates it, like Claude Desktop with MCP or an AI browser.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 112232
            },
            {
              "endIndex": 112684,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 112684,
                    "startIndex": 112683,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 112683
            },
            {
              "endIndex": 113087,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 113087,
                    "startIndex": 112684,
                    "textRun": {
                      "content": "And then we need to think about what workflows people will be doing, and what they need from software to help with it? Making decisions and staying compliant are two big ones. If we get reductive about this, most apps are SQL wrappers, and SQL is indexes, text and images. The rest of a SaaS app is gating usage based on data + rules, notifications, reports to inform decision making, and integrations.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 112684
            },
            {
              "endIndex": 113088,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 113088,
                    "startIndex": 113087,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 113087
            },
            {
              "endIndex": 113408,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 113408,
                    "startIndex": 113088,
                    "textRun": {
                      "content": "The integrations evaporate because the AI octopus will move the data between via what will become the main UI. Rules are probably still needed to prevent AI misuse, since it is just a human, and it’ll need to discover the rules, though it’s possible it could follow instructions and not mess up much, without the rules.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 113088
            },
            {
              "endIndex": 113409,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 113409,
                    "startIndex": 113408,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 113408
            },
            {
              "endIndex": 113899,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 113899,
                    "startIndex": 113409,
                    "textRun": {
                      "content": "So what is left? CRUD operations, indexes to rapidly find records which will could Markdown documents. So then an app could potentially be reduced to just a silo of indexes and docs. The silo seems arbitrary now, so that goes away and you’re left with Google Docs.\u000b\u000bIn other words, a filing cabinet, a world before computers. The future looks like the past. The computers vanish and humans no longer sit at screens and an office looks more like a dining room or the olde tea shop cum bank.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 113409
            },
            {
              "endIndex": 113900,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 113900,
                    "startIndex": 113899,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 113899
            },
            {
              "endIndex": 113906,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 113906,
                    "startIndex": 113900,
                    "textRun": {
