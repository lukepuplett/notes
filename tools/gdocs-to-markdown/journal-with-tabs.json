              "startIndex": 30293
            },
            {
              "endIndex": 30296,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30296,
                    "startIndex": 30295,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30295
            },
            {
              "endIndex": 30470,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30470,
                    "startIndex": 30296,
                    "textRun": {
                      "content": "^ Amazing meme, the day after ICE border patrol shot a woman in the head for driving sort of at/around an angry ICE man with a gun. All filmed. Wild. Both were in the wrong.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30296
            },
            {
              "endIndex": 30471,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30471,
                    "startIndex": 30470,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30470
            },
            {
              "endIndex": 30473,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30473,
                    "startIndex": 30471,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30471
            },
            {
              "endIndex": 30474,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30474,
                    "startIndex": 30473,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30473
            },
            {
              "endIndex": 30569,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30569,
                    "startIndex": 30474,
                    "textRun": {
                      "content": "> Developer of Tailwind CSS talking about how AI has ruined the business model of open source.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30474
            },
            {
              "endIndex": 30570,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30570,
                    "startIndex": 30569,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30569
            },
            {
              "endIndex": 30841,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30841,
                    "startIndex": 30570,
                    "textRun": {
                      "content": "All my new code will be closed-source from now on. I've contributed millions of lines of carefully written OSS code over the past decade, spent thousands of hours helping other people. If you want to use my libraries (1M+ downloads/month) in the future, you have to pay.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30570
            },
            {
              "endIndex": 30842,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30842,
                    "startIndex": 30841,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30841
            },
            {
              "endIndex": 31157,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31157,
                    "startIndex": 30842,
                    "textRun": {
                      "content": "I made good money funneling people through my OSS and being recognized as expert in several fields. This was entirely based on HUMANS knowing and seeing me by USING and INTERACTING with my code. No humans will ever read my docs again when coding agents do it in seconds. Nobody will even know it's me who built it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30842
            },
            {
              "endIndex": 31158,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31158,
                    "startIndex": 31157,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31157
            },
            {
              "endIndex": 31507,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31507,
                    "startIndex": 31158,
                    "textRun": {
                      "content": "Look at Tailwind: 75 million downloads/month, more popular than ever, revenue down 80%, docs traffic down 40%, 75% of engineering team laid off. Someone submitted a PR to add LLM-optimized docs and Wathan had to decline - optimizing for agents accelerates his business's death. He's being asked to build the infrastructure for his own obsolescence.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31158
            },
            {
              "endIndex": 31508,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31508,
                    "startIndex": 31507,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31507
            },
            {
              "endIndex": 31552,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31552,
                    "startIndex": 31508,
                    "textRun": {
                      "content": "Two of the most common OSS business models:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31508
            },
            {
              "endIndex": 31682,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31682,
                    "startIndex": 31552,
                    "textRun": {
                      "content": "- Open Core: Give away the library, sell premium once you reach critical mass (Tailwind UI, Prisma Accelerate, Supabase Cloud...)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31552
            },
            {
              "endIndex": 31773,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31773,
                    "startIndex": 31682,
                    "textRun": {
                      "content": "- Expertise Moat: Be THE expert in your library - consulting gigs, speaking, higher salary\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31682
            },
            {
              "endIndex": 31774,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 31774,
                    "startIndex": 31773,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31773
            },
            {
              "endIndex": 32024,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32024,
                    "startIndex": 31774,
                    "textRun": {
                      "content": "Tailwind just proved the first one is dying. Agents bypass the documentation funnel. They don't see your premium tier. Every project relying on docs-to-premium conversion will face the same pressure: Prisma, Drizzle, MikroORM, Strapi, and many more.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 31774
            },
            {
              "endIndex": 32025,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32025,
                    "startIndex": 32024,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32024
            },
            {
              "endIndex": 32314,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32314,
                    "startIndex": 32025,
                    "textRun": {
                      "content": "The core insight: OSS monetization was always about attention. Human eyeballs on your docs, brand, expertise. That attention has literally moved into attention layers. Your docs trained the models that now make visiting you unnecessary. Human attention paid. Artificial attention doesn't.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32025
            },
            {
              "endIndex": 32315,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32315,
                    "startIndex": 32314,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32314
            },
            {
              "endIndex": 32502,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32502,
                    "startIndex": 32315,
                    "textRun": {
                      "content": "Some OSS will keep going - wealthy devs doing it for fun or education. That's not a system, that's charity. Most popular OSS runs on economic incentives. Destroy them, they stop playing.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32315
            },
            {
              "endIndex": 32503,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32503,
                    "startIndex": 32502,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32502
            },
            {
              "endIndex": 32751,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32751,
                    "startIndex": 32503,
                    "textRun": {
                      "content": "Why go closed-source? When the monetization funnel is broken, you move payment to the only point that still exists: access. OSS gave away access hoping to monetize attention downstream. Agents broke downstream. Closed-source gates access directly.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32503
            },
            {
              "endIndex": 32837,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32837,
                    "startIndex": 32751,
                    "textRun": {
                      "content": "The final irony: OSS trained the models now killing it. We built our own replacement.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32751
            },
            {
              "endIndex": 32838,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 32838,
                    "startIndex": 32837,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32837
            },
            {
              "endIndex": 33112,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33112,
                    "startIndex": 32838,
                    "textRun": {
                      "content": "My prediction: a new marketplace emerges, built for agents. Want your agent to use Tailwind? Prisma? Pay per access. Libraries become APIs with meters. The old model: free code -> human attention -> monetization. The new model: pay at the gate or your agent doesn't get in.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 32838
            },
            {
              "endIndex": 33113,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33113,
                    "startIndex": 33112,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33112
            },
            {
              "endIndex": 33115,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33115,
                    "startIndex": 33113,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33113
            },
            {
              "endIndex": 33116,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33116,
                    "startIndex": 33115,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33115
            },
            {
              "endIndex": 33124,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33124,
                    "startIndex": 33116,
                    "textRun": {
                      "content": "tae kim\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33116
            },
            {
              "endIndex": 33138,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33138,
                    "startIndex": 33124,
                    "textRun": {
                      "content": "@firstadopter\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33124
            },
            {
              "endIndex": 33139,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33139,
                    "startIndex": 33138,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33138
            },
            {
              "endIndex": 33180,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33180,
                    "startIndex": 33139,
                    "textRun": {
                      "content": "Here's what's going to happen from here:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33139
            },
            {
              "endIndex": 33181,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33181,
                    "startIndex": 33180,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33180
            },
            {
              "endIndex": 33620,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33620,
                    "startIndex": 33181,
                    "textRun": {
                      "content": "-Nvidia will report blowout numbers the next several quarters on the NVL72 product supercycle (a step function up in capability with 72 GPUs in one AI server versus 8 GPUs). It will become one of the largest cycles in technology history, akin to the iPhone versus Blackberry. The clear signs are there in the latest quarter with Nvidia posting its first accelerating revenue growth in two years and triple-digit networking segment growth.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33181
            },
            {
              "endIndex": 33621,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33621,
                    "startIndex": 33620,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33620
            },
            {
              "endIndex": 33888,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33888,
                    "startIndex": 33621,
                    "textRun": {
                      "content": "-Google TPUs will be less than 10% of the market for the next few years as the major hyperscaler buyers don't want to support a cloud rival (outside of Meta), while Nvidia's software CUDA/developer ecosystem, TSMC allocation and performance advantages remain strong.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33621
            },
            {
              "endIndex": 33889,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 33889,
                    "startIndex": 33888,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 33888
            },
            {
