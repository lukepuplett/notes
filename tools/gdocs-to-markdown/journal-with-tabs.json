              "endIndex": 30595,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30595,
                    "startIndex": 30418,
                    "textRun": {
                      "content": "- **No clear unemployment impact**: no systematic rise in unemployment rates for highly exposed workers since late 2022 (difference-in-differences near zero and insignificant).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30418
            },
