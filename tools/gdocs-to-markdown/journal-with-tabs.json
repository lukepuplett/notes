                "elements": [
                  {
                    "endIndex": 12308,
                    "startIndex": 12278,
                    "textRun": {
                      "content": "Restoring the Monroe Doctrine:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
