                }
              },
              "startIndex": 44755
            },
            {
              "endIndex": 44788,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44788,
                    "startIndex": 44774,
                    "textRun": {
                      "content": "@BenjaminDEKR\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44774
            },
            {
              "endIndex": 44789,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44789,
                    "startIndex": 44788,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44788
            },
            {
              "endIndex": 44811,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44811,
                    "startIndex": 44789,
                    "textRun": {
                      "content": "Here is an xAI story.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44789
            },
            {
              "endIndex": 44812,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44812,
                    "startIndex": 44811,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44811
            },
            {
              "endIndex": 44927,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44927,
                    "startIndex": 44812,
                    "textRun": {
                      "content": "When I was first hired (low level) by xAI, I was extremely excited. I greatly admired Elon and what Grok could be.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44812
            },
            {
              "endIndex": 44928,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44928,
                    "startIndex": 44927,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44927
            },
            {
              "endIndex": 45040,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45040,
                    "startIndex": 44928,
                    "textRun": {
                      "content": "I have a pretty cool AI following here on X. Some big names see my stuff, including Elon himself (at the time).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 44928
            },
            {
              "endIndex": 45041,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45041,
                    "startIndex": 45040,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45040
            },
            {
              "endIndex": 45086,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45086,
                    "startIndex": 45041,
                    "textRun": {
                      "content": "Lex, Beff, Andreessen, Aravind, many others.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45041
            },
            {
              "endIndex": 45087,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45087,
                    "startIndex": 45086,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45086
            },
            {
              "endIndex": 45231,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45231,
                    "startIndex": 45087,
                    "textRun": {
                      "content": "During the interview and onboarding for xAI, they made a *big deal* about wanting people who \"take initiative\" and think outside the box. Ok...\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45087
            },
            {
              "endIndex": 45232,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45232,
                    "startIndex": 45231,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45231
            },
            {
              "endIndex": 45389,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45389,
                    "startIndex": 45232,
                    "textRun": {
                      "content": "So, some of the biggest names in tech follow me on X. I decided to ask for ideas and feedback on how Grok (then still early at version 2) could be improved.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45232
            },
            {
              "endIndex": 45390,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45390,
                    "startIndex": 45389,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45389
            },
            {
              "endIndex": 45582,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45582,
                    "startIndex": 45390,
                    "textRun": {
                      "content": "I asked my followers on X for the best \"how can we make Grok awesome?\" ideas, and was going to collect them (organized by Grok himself) into a big report for my boss(es) and ultimately, Elon.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45390
            },
            {
              "endIndex": 45583,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45583,
                    "startIndex": 45582,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45582
            },
            {
              "endIndex": 45700,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45700,
                    "startIndex": 45583,
                    "textRun": {
                      "content": "(xAI makes a big deal about how it's a \"flat structure\" also. You're supposed to be empowered to act on good ideas.)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45583
            },
            {
              "endIndex": 45701,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45701,
                    "startIndex": 45700,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45700
            },
            {
              "endIndex": 45890,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45890,
                    "startIndex": 45701,
                    "textRun": {
                      "content": "Well, my post got way more attention than I expected - great! Ideas to improve Grok poured in! I built a script to collect and sort all these great ideas to make xAI's core product better.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45701
            },
            {
              "endIndex": 45891,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 45891,
                    "startIndex": 45890,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45890
            },
            {
              "endIndex": 46009,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46009,
                    "startIndex": 45891,
                    "textRun": {
                      "content": "John Carmack (personal friend of Elon, creator of Doom, id software, legend) retweeted it. Carmack has 1M followers. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 45891
            },
            {
              "endIndex": 46010,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46010,
                    "startIndex": 46009,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46009
            },
            {
              "endIndex": 46113,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46113,
                    "startIndex": 46010,
                    "textRun": {
                      "content": "There were so many great ideas on how to improve Grok! I was collecting them and excited. Until.......\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46010
            },
            {
              "endIndex": 46114,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46114,
                    "startIndex": 46113,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46113
            },
            {
              "endIndex": 46346,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46346,
                    "startIndex": 46114,
                    "textRun": {
                      "content": "I woke up the next day to a threatening email from my main supervisor* at xAI, telling me I had messed up, that I was NEVER to ask for ideas to improve Grok ever again, that it wasn't my job (I thought our job was to improve Grok.)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46114
            },
            {
              "endIndex": 46347,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46347,
                    "startIndex": 46346,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46346
            },
            {
              "endIndex": 46463,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46463,
                    "startIndex": 46347,
                    "textRun": {
                      "content": "They suspended my account on X. They never explained why. It was obviously related to my post about improving Grok.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46347
            },
            {
              "endIndex": 46464,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46464,
                    "startIndex": 46463,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46463
            },
            {
              "endIndex": 46680,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46680,
                    "startIndex": 46464,
                    "textRun": {
                      "content": "I was told to delete those posts which had gone viral. I had to delete all the hundreds (thousands?) of genuinely good ideas for improving Grok that had poured in by users on X, because it stepped on someone's toes.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46464
            },
            {
              "endIndex": 46681,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46681,
                    "startIndex": 46680,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46680
            },
            {
              "endIndex": 46874,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46874,
                    "startIndex": 46681,
                    "textRun": {
                      "content": "It made me confused and sad. Incidents like this happened often, where xAI employees would come in full of excitement and enthusiasm, and would have it stomped out by managers who hated ideas.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46681
            },
            {
              "endIndex": 46875,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 46875,
                    "startIndex": 46874,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46874
            },
            {
              "endIndex": 47053,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47053,
                    "startIndex": 46875,
                    "textRun": {
                      "content": "They filled xAI with middle managers and busybodies. It was one of the most DEI and corporate-y places I've ever worked. I came in wanting Elon and xAI to win and left just sad.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 46875
            },
            {
              "endIndex": 47054,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47054,
                    "startIndex": 47053,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47053
            },
            {
              "endIndex": 47099,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47099,
                    "startIndex": 47054,
                    "textRun": {
                      "content": "*That manager is gone, for what it's worth. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 47054
            },
            {
              "endIndex": 47131,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 47131,
                    "startIndex": 47099,
                    "textRun": {
                      "content": "Everyone I knew at xAI is gone.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
