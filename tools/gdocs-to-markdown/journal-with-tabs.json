              "endIndex": 96568,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 96568,
                    "startIndex": 96524,
                    "textRun": {
                      "content": "Amazon also has a call option on Anthropic.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 96524
            },
