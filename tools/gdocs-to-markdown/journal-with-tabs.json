              "paragraph": {
                "elements": [
                  {
                    "endIndex": 96575,
                    "startIndex": 96569,
                    "textRun": {
                      "content": "10:50\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 96569
            },
            {
              "endIndex": 96584,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 96584,
                    "startIndex": 96575,
                    "textRun": {
                      "content": "Ah. Yes.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 96575
            },
            {
              "endIndex": 96585,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 96585,
                    "startIndex": 96584,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 96584
            },
            {
              "endIndex": 96752,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 96752,
                    "startIndex": 96585,
                    "textRun": {
                      "content": "So the pattern becomes clear: every major pure-play AI company is being slowly absorbed by a tech giant that's providing the capital and compute they need to survive.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 96585
            },
