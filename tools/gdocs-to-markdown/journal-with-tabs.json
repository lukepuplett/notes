                    "endIndex": 89574,
                    "startIndex": 89570,
                    "textRun": {
                      "content": "Grok",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 89584,
                    "startIndex": 89574,
                    "textRun": {
                      "content": " on that:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 89563
            },
            {
              "endIndex": 90181,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 89610,
                    "startIndex": 89584,
                    "textRun": {
                      "content": "Assuming the premise holds",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 90181,
                    "startIndex": 89610,
                    "textRun": {
                      "content": "—that rising compute, memory, power, and inference costs (or the effective pressure from exploding usage volume, complex agentic workflows, and ending subsidies) make API calls unsustainable for low-margin apps—the fallout creates a classic \"unit economics crisis.\" Many apps built as thin wrappers around models like GPT, Claude, or Gemini face negative gross margins, unpredictable bills, and no pricing power. Real-world data shows AI-native apps often run at 25-60% gross margins (vs. 70-90% for traditional SaaS), with inference sometimes eating 20-30%+ of revenue.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 89584
            },
            {
              "endIndex": 90428,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 90428,
                    "startIndex": 90181,
                    "textRun": {
                      "content": "This isn't just theoretical: high-volume use cases (document processing, support automation, consumer chatbots) get crushed fastest when per-user costs jump from ~$2 to $10/month or more, while fixed subscription prices can't scale without churn.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 90181
            },
            {
              "endIndex": 90475,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 90475,
                    "startIndex": 90428,
                    "textRun": {
                      "content": "Different Ways This Could Play Out (Scenarios)\n",
                      "textStyle": {
                        "bold": true,
                        "fontSize": {
                          "magnitude": 13,
                          "unit": "PT"
                        },
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {}
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "headingId": "h.1i24hrrp9cdo",
                  "keepLinesTogether": false,
                  "keepWithNext": false,
                  "lineSpacing": 100,
                  "namedStyleType": "HEADING_3",
                  "spaceAbove": {
                    "magnitude": 14,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 4,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 90428
            },
            {
              "endIndex": 91094,
              "paragraph": {
                "bullet": {
                  "listId": "kix.gz1gqi8k4qdo",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 90551,
                    "startIndex": 90475,
                    "textRun": {
                      "content": "Mass Extinction / Shakeout of Thin Wrappers (Most Likely Short-Term Outcome)",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 91094,
                    "startIndex": 90551,
                    "textRun": {
                      "content": " 80-99% of low-margin \"AI wrapper\" startups (simple UI + API calls, no proprietary data or deep workflows) fail or get acquired cheaply by 2026. They lack moats, so when costs rise or big platforms \"sherlock\" features (e.g., native summarization in CRMs), their value evaporates. Consumer apps and high-volume automations die fastest; the market consolidates around a few survivors with data loops or vertical lock-in. This creates a \"two-tier AI economy\": tech giants and well-funded players thrive, while SMEs and indie apps get priced out.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 90475
            },
            {
              "endIndex": 91477,
              "paragraph": {
                "bullet": {
                  "listId": "kix.gz1gqi8k4qdo",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 91130,
                    "startIndex": 91094,
                    "textRun": {
                      "content": "Price Increases + Market Contraction",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 91477,
                    "startIndex": 91130,
                    "textRun": {
                      "content": " Surviving apps pass costs to users (higher subs, usage-based tiers, or feature limits). This shrinks the addressable market—price-sensitive consumers churn, growth stalls, and innovation slows in casual/consumer segments. High-margin B2B verticals (legal, finance, healthcare) fare better because customers absorb or even value the cost for ROI.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 91094
            },
            {
              "endIndex": 92092,
              "paragraph": {
                "bullet": {
                  "listId": "kix.gz1gqi8k4qdo",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 91531,
                    "startIndex": 91477,
                    "textRun": {
                      "content": "Optimization and Cost-Deflation Wave (Rescue Scenario)",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 91599,
                    "startIndex": 91531,
                    "textRun": {
                      "content": " A new layer of tools and practices slashes effective costs 50-95%: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 91736,
                    "startIndex": 91599,
                    "textRun": {
                      "content": "intelligent routing (cheap small models for 80% of tasks), semantic caching, batching, prompt compression, distillation, and quantization",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 92092,
                    "startIndex": 91736,
                    "textRun": {
                      "content": ". API aggregation platforms (unified interfaces across 300+ models) deliver 20-80% savings via bulk deals and auto-failover, turning the crisis into an efficiency boom. Total spend still rises with usage (\"LLMflation\"), but per-task costs plummet. Low-margin apps that adapt survive and scale; this drives an \"AI FinOps\" or \"AIOps\" discipline as standard.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 91477
            },
            {
              "endIndex": 92695,
              "paragraph": {
                "bullet": {
                  "listId": "kix.gz1gqi8k4qdo",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 92136,
                    "startIndex": 92092,
                    "textRun": {
                      "content": "Self-Hosting / Open-Source Boom + Edge Shift",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 92137,
                    "startIndex": 92136,
                    "textRun": {
                      "content": " ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 92316,
                    "startIndex": 92137,
                    "textRun": {
                      "content": "Apps flee volatile cloud APIs for open models (Llama, Mistral, DeepSeek variants) on managed inference platforms (Groq, Together, Fireworks) or self-hosted infra (vLLM, TensorRT).",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 92695,
                    "startIndex": 92316,
                    "textRun": {
                      "content": " At scale (millions of tokens/month), this can be 4-10x cheaper with zero variable API fees—break-even happens quickly for high-volume apps. On-device/edge inference (phones, laptops, specialized chips) zeros out costs entirely for consumer apps, with privacy as a bonus. Power and ops overhead remain challenges, but hardware advances (Blackwell, custom ASICs) accelerate this.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 92092
            },
            {
              "endIndex": 93405,
              "paragraph": {
                "bullet": {
                  "listId": "kix.gz1gqi8k4qdo",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 92768,
                    "startIndex": 92695,
                    "textRun": {
                      "content": "Consolidation, Vertical Pivot, or Hybrid Models (Longer-Term Equilibrium)",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 92769,
                    "startIndex": 92768,
                    "textRun": {
                      "content": " ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 93034,
                    "startIndex": 92769,
                    "textRun": {
                      "content": "Big platforms acquire survivors or build the features in-house. Low-margin apps pivot to deep verticals (proprietary datasets, workflow integration, agents with memory), outcome-based pricing (pay for results, not tokens), or hybrid deterministic + AI architectures",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 93405,
                    "startIndex": 93034,
                    "textRun": {
                      "content": ". Consumer space shifts to ad-funded or freemium; enterprise wins with compliance and ROI. If energy/compute constraints bite harder (e.g., blackouts, grid limits), this accelerates stratification: cheap local/SLM AI for most uses vs. expensive frontier models for premium cases. Breakthroughs in efficiency could flip the script entirely, making the \"crisis\" temporary.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 92695
            },
            {
              "endIndex": 93463,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 93463,
                    "startIndex": 93405,
                    "textRun": {
                      "content": "Practical Options for Low-Margin Apps to Survive or Adapt\n",
                      "textStyle": {
                        "bold": true,
                        "fontSize": {
                          "magnitude": 13,
                          "unit": "PT"
                        },
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {}
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "headingId": "h.irxtqrrhh2mp",
                  "keepLinesTogether": false,
                  "keepWithNext": false,
                  "lineSpacing": 100,
                  "namedStyleType": "HEADING_3",
                  "spaceAbove": {
                    "magnitude": 14,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 4,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 93405
            },
            {
              "endIndex": 93746,
              "paragraph": {
                "bullet": {
                  "listId": "kix.ygu4brle803p",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 93519,
                    "startIndex": 93463,
                    "textRun": {
                      "content": "Ruthless Optimization First (Quick Wins, 40-80% Savings)",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 93746,
                    "startIndex": 93519,
                    "textRun": {
                      "content": ": Add middleware/aggregators for smart routing, caching, PII redaction, and fallbacks. Use smaller models or distilled versions for routine tasks; compress prompts and batch requests. Tools and patterns here are maturing fast.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 93463
            },
            {
              "endIndex": 93944,
              "paragraph": {
                "bullet": {
                  "listId": "kix.ygu4brle803p",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 93766,
                    "startIndex": 93746,
                    "textRun": {
                      "content": "Architectural Shifts",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 93944,
                    "startIndex": 93766,
                    "textRun": {
                      "content": ": Hybrid setups (rules-based for simple logic + AI only when needed); RAG with proprietary knowledge graphs; fine-tune open models on your data for better quality at lower cost.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 93746
            },
            {
              "endIndex": 94114,
              "paragraph": {
                "bullet": {
                  "listId": "kix.ygu4brle803p",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 93964,
                    "startIndex": 93944,
                    "textRun": {
                      "content": "Infrastructure Pivot",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 94114,
                    "startIndex": 93964,
                    "textRun": {
                      "content": ": Move to self-hosted or managed open inference (BYOK models). On-device for mobile/consumer apps. Break-even math favors this at moderate scale now.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 93944
            },
            {
              "endIndex": 94342,
              "paragraph": {
                "bullet": {
                  "listId": "kix.ygu4brle803p",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 94138,
                    "startIndex": 94114,
                    "textRun": {
                      "content": "Business Model Evolution",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 94342,
                    "startIndex": 94138,
                    "textRun": {
                      "content": ": Switch to usage tiers, outcome/success fees, or value-based pricing. Add switching costs (workflow lock-in, integrations). Focus on high-WTP verticals or enterprise where margins allow cost absorption.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 94114
            },
            {
              "endIndex": 94532,
              "paragraph": {
                "bullet": {
                  "listId": "kix.ygu4brle803p",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 94358,
                    "startIndex": 94342,
                    "textRun": {
                      "content": "Strategic Pivots",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 94532,
                    "startIndex": 94358,
                    "textRun": {
                      "content": ": Build moats (data, domain expertise, compliance). Reduce AI dependency where possible. Or join the consolidation wave—get acquired or become a feature in bigger platforms.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
                    "magnitude": 18,
                    "unit": "PT"
                  },
                  "indentStart": {
                    "magnitude": 36,
                    "unit": "PT"
                  },
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spacingMode": "COLLAPSE_LISTS"
                }
              },
              "startIndex": 94342
            },
            {
              "endIndex": 94980,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 94980,
                    "startIndex": 94532,
                    "textRun": {
                      "content": "In short, the premise accelerates a Darwinian filter: low-margin, undifferentiated apps get crushed, but it rewards real engineering, efficiency obsession, and defensible value. The winners won't be the ones calling the most APIs—they'll be the ones calling the fewest, smartest ones (or none at all). This dynamic is already playing out in 2026 discussions, pushing the industry toward more sustainable, innovative AI rather than subsidized hype.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 94532
            },
            {
              "endIndex": 95055,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 95055,
                    "startIndex": 94980,
                    "textRun": {
                      "content": "> I asked ChatGPT to assess it for plausibility and outlier eventualities:\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.91764706,
                              "green": 0.9137255,
                              "red": 0.90588236
                            }
                          }
                        },
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 94980
            },
            {
              "endIndex": 95056,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 95056,
                    "startIndex": 95055,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 95055
            },
            {
              "endIndex": 95274,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 95274,
                    "startIndex": 95056,
                    "textRun": {
                      "content": "Short answer: yes, broadly plausible—but it’s a very “inside-the-bubble” extrapolation. It assumes constraints persist linearly and that behaviour doesn’t adapt fast enough. Historically, that’s where forecasts break.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT",
                  "spaceAbove": {
                    "magnitude": 12,
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 95056
            },
