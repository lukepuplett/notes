                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 174041
            },
            {
              "endIndex": 174388,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 174097,
                    "startIndex": 174042,
                    "textRun": {
                      "content": "For extreme requirements (EUV lithography photomasks), ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 174193,
                    "startIndex": 174097,
                    "textRun": {
                      "content": "synthetic quartz is produced via chemical vapor deposition (CVD) or vapor-phase axial deposition",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 174388,
                    "startIndex": 174193,
                    "textRun": {
                      "content": " (VAD) from SiCl₄. CVD offers uniformity and UV transparency; VAD provides low thermal expansion (0.5 × 10⁻⁶/K). Synthetic quartz costs 5–10× more than natural HPQ, limiting it to critical uses.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
