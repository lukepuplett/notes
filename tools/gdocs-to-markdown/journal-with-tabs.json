                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300382
            },
            {
              "endIndex": 300415,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300415,
                    "startIndex": 300398,
                    "textRun": {
                      "content": "@lisaabramowicz1\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300398
            },
            {
              "endIndex": 300416,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300416,
                    "startIndex": 300415,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300415
            },
            {
              "endIndex": 300637,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300637,
                    "startIndex": 300416,
                    "textRun": {
                      "content": "On the more optimistic side, here’s Wharton Prof. Jeremy Siegel: “AI will not bring an economic apocalypse. AI will lead us to the greatest increase in the standard of living since the dawn of the Industrial Revolution.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300416
            },
            {
              "endIndex": 300638,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300638,
                    "startIndex": 300637,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300637
            },
            {
              "endIndex": 300640,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300640,
                    "startIndex": 300638,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300638
            },
            {
              "endIndex": 300641,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300641,
                    "startIndex": 300640,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300640
            },
            {
              "endIndex": 300668,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300668,
                    "startIndex": 300641,
                    "textRun": {
                      "content": "There is No AI Apocalypse \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300641
            },
            {
              "endIndex": 300698,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300698,
                    "startIndex": 300668,
                    "textRun": {
                      "content": "By Professor Jeremy J. Siegel\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300668
            },
            {
              "endIndex": 300699,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300699,
                    "startIndex": 300698,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300698
            },
            {
              "endIndex": 300891,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300891,
                    "startIndex": 300699,
                    "textRun": {
                      "content": "The recent report by Citrini Research paints a frightening future of massive AI- induced unemployment, crashing stock markets, rising default rates, and a general descent into economic chaos.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300699
            },
            {
              "endIndex": 300892,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300892,
                    "startIndex": 300891,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300891
            },
            {
              "endIndex": 301200,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 300949,
                    "startIndex": 300892,
                    "textRun": {
                      "content": "But such a prediction has no historical or economic basis",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 301200,
                    "startIndex": 300949,
                    "textRun": {
                      "content": ". Let us envision the following scenario. Assume that AI enables every worker to double his or her productivity, in other words, to be able to produce twice the output (automobiles, reports, deliveries, customer service, etc.) than they do currently.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 300892
            },
            {
              "endIndex": 301201,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 301201,
                    "startIndex": 301200,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 301200
            },
            {
              "endIndex": 301818,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 301326,
                    "startIndex": 301201,
                    "textRun": {
                      "content": "In such a world, all the goods and services that are produced today in a 5-day work week could be produced in half the time. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 301816,
                    "startIndex": 301326,
                    "textRun": {
                      "content": "If workers and firms cut back their hours by 50% (in other words, move to a 2 ½-day workweek), the same total output of the economy would be produced that is produced today. In this scenario, the average real hourly wage would double, since the same quantity of goods and services are produced in half the time. This conclusion is supported by both theory and historical evidence that increases in productivity lead to increases in real wages: double productivity and real wages will double",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 301818,
                    "startIndex": 301816,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 301201
            },
            {
              "endIndex": 301819,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 301819,
                    "startIndex": 301818,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 301818
            },
            {
              "endIndex": 302451,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 301837,
                    "startIndex": 301819,
                    "textRun": {
                      "content": "In this scenario, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 301949,
                    "startIndex": 301837,
                    "textRun": {
                      "content": "most workers would want to take advantage of their higher wages to expand their income and raise their lifestyle",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 302173,
                    "startIndex": 301949,
                    "textRun": {
                      "content": ". If workers toil just one more day a week (from 2 ½ to 3 ½ days), their real income will increase by 40%. In our $30 trillion economy, this extra day of work would produce $12 trillion of extra goods, services, and income. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 302399,
                    "startIndex": 302173,
                    "textRun": {
                      "content": "Workers would use their expanded purchasing power to buy better housing, transportation, schools, improved government services, and increase their leisure and travel experiences enabled by the vast expansion of their free time",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 302451,
                    "startIndex": 302399,
                    "textRun": {
                      "content": " (recall, weekends are now 3 ½, instead of 2 days).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 301819
            },
            {
              "endIndex": 302452,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 302452,
                    "startIndex": 302451,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 302451
            },
            {
              "endIndex": 303184,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 302673,
                    "startIndex": 302452,
                    "textRun": {
                      "content": "^ Yeah, so I would argue, I love this take. It’s simple and easy to understand, and it just seems so true. It stands up to everything that’s happened previously, everything that’s been observed. But I would add here that ",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 302820,
                    "startIndex": 302673,
                    "textRun": {
                      "content": "the reason most workers would want to take advantage of their higher wages to expand their income and raise their lifestyle is because of their ego",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        },
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 303071,
                    "startIndex": 302820,
                    "textRun": {
                      "content": ". It is the ego that drives them so that they can compete and look better and tell people that they have this thing, they have this other thing, and they feel better about themselves having those things. Okay? It’s all driven by basic status-seeking. ",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 303134,
                    "startIndex": 303071,
                    "textRun": {
                      "content": "Status seeking is no good when you have no humans to admire you",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        },
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 303184,
                    "startIndex": 303134,
                    "textRun": {
                      "content": ". So it’s no good building a big company of bots.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 302452
            },
            {
              "endIndex": 303185,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 303185,
                    "startIndex": 303184,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 303184
            },
            {
              "endIndex": 303494,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 303494,
                    "startIndex": 303185,
                    "textRun": {
                      "content": "Critics of AI focus on the white-collar workers whose specific task might be eliminated by AI. But most white-collar jobs rely on the worker’s general intelligence, diligence, and discipline. These skills can be readily transferred to the industries that will expand because of the surge of workers’ incomes.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 303185
            },
            {
              "endIndex": 303720,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 303718,
                    "startIndex": 303494,
                    "textRun": {
                      "content": "What about the millions of drivers who will lose their jobs because of automated self-driving? They will find more than enough jobs in the exploding entertainment and leisure industry, spurred by the increase in leisure time",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 303720,
                    "startIndex": 303718,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 303494
            },
            {
              "endIndex": 303721,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 303721,
                    "startIndex": 303720,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 303720
            },
            {
              "endIndex": 304082,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 304082,
                    "startIndex": 303721,
                    "textRun": {
                      "content": "The demand for healthcare will also soar since more workers can afford better treatments while technology will sharply reduce costs. CAT and PET scans will become as cheap as X-rays. Since AI hallucinations will never be eliminated, do you really think radiologists will disappear as patients demand a pair of human eyes to double-check an AI cancer diagnosis?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 303721
            },
            {
              "endIndex": 304083,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 304083,
                    "startIndex": 304082,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 304082
            },
            {
              "endIndex": 304466,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 304322,
                    "startIndex": 304083,
                    "textRun": {
                      "content": "Before the industrial revolution, humankind had to work 12 hours a day, seven days a week to produce the goods for bare-bones survival: food and basic shelter. Today, in the modern world, survival can be achieved by working less than a day",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 304466,
                    "startIndex": 304322,
                    "textRun": {
                      "content": ". In 1800, 80% of American workers toiled in the farming industry. Today that is less than 2% and the US exports food to the rest of the world.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 304083
            },
            {
              "endIndex": 304467,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 304467,
                    "startIndex": 304466,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 304466
            },
            {
              "endIndex": 305083,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 304687,
                    "startIndex": 304467,
                    "textRun": {
                      "content": "Pessimists maintain that the speed of the AI Revolution makes these historical comparisons irrelevant (although I remember predictions that Amazon and the internet would eliminate all retail by the middle of the 2020s). ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 304948,
                    "startIndex": 304687,
                    "textRun": {
                      "content": "But that assertion fails to take account of the great flexibility of workers to adapt to sudden changes. Shifts in production during wars and even the recent pandemic showed how economies can adapt to changes in circumstances far faster than those induced by AI",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 305083,
                    "startIndex": 304948,
                    "textRun": {
                      "content": ". Workers with highly developed skills will find great demand from the new industries that will be enabled by artificial intelligence.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 304467
            },
            {
              "endIndex": 305084,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305084,
                    "startIndex": 305083,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305083
            },
            {
              "endIndex": 305463,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305126,
                    "startIndex": 305084,
                    "textRun": {
                      "content": "AI will not bring an economic apocalypse. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 305236,
                    "startIndex": 305126,
                    "textRun": {
                      "content": "AI will lead us to the greatest increase in the standard of living since the dawn of the Industrial Revolution",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "green": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 305463,
                    "startIndex": 305236,
                    "textRun": {
                      "content": ". Although some professions will clearly be impacted, the dramatic increase in consumer income will more than offset the loss of jobs caused by the new technology. The AI future is not one to be feared, but one to be embraced.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305084
            },
            {
              "endIndex": 305464,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305464,
                    "startIndex": 305463,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305463
            },
            {
              "endIndex": 305481,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305481,
                    "startIndex": 305464,
                    "textRun": {
                      "content": "Jeremy J. Siegel\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305464
            },
            {
              "endIndex": 305565,
