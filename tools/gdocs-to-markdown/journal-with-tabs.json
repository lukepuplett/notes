              "endIndex": 13561,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 13561,
                    "startIndex": 13340,
                    "textRun": {
                      "content": "“In a decisive break from its origins as a sustainable footwear maker, Allbirds is exiting consumer products entirely to reposition itself as a provider of AI compute infrastructure, according to a company announcement.”\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
