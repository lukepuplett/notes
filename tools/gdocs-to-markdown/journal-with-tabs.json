                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216235
            },
            {
              "endIndex": 216247,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216247,
                    "startIndex": 216236,
                    "textRun": {
                      "content": "@ccatalini\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216236
            },
            {
              "endIndex": 216361,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216361,
                    "startIndex": 216247,
                    "textRun": {
                      "content": "Founder @MIT Cryptoeconomics Lab. Previously: Co-Founder & Chief Strategy Officer, Lightspark. Co-Creator, Libra.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216247
            },
            {
              "endIndex": 216362,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216362,
                    "startIndex": 216361,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216361
            },
            {
              "endIndex": 216391,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216391,
                    "startIndex": 216362,
                    "textRun": {
                      "content": "Some Simple Economics of AGI\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216362
            },
            {
              "endIndex": 216392,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216392,
                    "startIndex": 216391,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216391
            },
            {
              "endIndex": 216842,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216437,
                    "startIndex": 216392,
                    "textRun": {
                      "content": "Some Simple Economics of AGI—🔥🧵 Right now, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 216491,
                    "startIndex": 216437,
                    "textRun": {
                      "content": "there is a low-grade panic running through the economy",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 216842,
                    "startIndex": 216491,
                    "textRun": {
                      "content": ". Everyone is asking the same anxious question: what exactly is AI going to automate, and what will be left for us? Most people assume the answer tracks some version of digital versus physical—that knowledge work falls first, then robotics catches up. And almost everyone believes that whatever AI can do in general, it's bad at their particular job.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216392
            },
            {
              "endIndex": 216843,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 216843,
                    "startIndex": 216842,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216842
            },
            {
              "endIndex": 217170,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 217014,
                    "startIndex": 216843,
                    "textRun": {
                      "content": "The lawyers think legal judgment is safe. The doctors think clinical intuition is safe. The strategists think strategy is safe. The creatives are sure creativity is safe. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 217170,
                    "startIndex": 217014,
                    "textRun": {
                      "content": "A whole vocabulary of comfort has emerged—\"taste,\" \"curation,\" \"judgment,\" \"agency,\" \"human touch\"—as though naming a residual is the same as defending it.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 216843
            },
            {
              "endIndex": 217171,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 217171,
                    "startIndex": 217170,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 217170
            },
            {
              "endIndex": 217631,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 217302,
                    "startIndex": 217171,
                    "textRun": {
                      "content": "But what if the real boundary has nothing to do with whether work is digital or physical, cognitive or manual, creative or routine—",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 217364,
                    "startIndex": 217302,
                    "textRun": {
                      "content": "and everything to do with whether anyone can verify the output",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 217631,
                    "startIndex": 217364,
                    "textRun": {
                      "content": "? Jane Wu, Xiang Hui, and I spent countless cycles following that question wherever it led. It rearranges almost everything—who thrives, what's defensible, where capital flows, and what it means to be economically human when measurable execution is essentially free.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 217171
            },
            {
              "endIndex": 217632,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 217632,
                    "startIndex": 217631,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 217631
            },
            {
              "endIndex": 218162,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 217959,
                    "startIndex": 217632,
                    "textRun": {
                      "content": "For 300,000 years, human cognition was the binding constraint on progress. Fire, agriculture, writing, calculus, the semiconductor—each required human minds to observe the world, recombine knowledge, and verify the results. The engine of progress was scarce, fragile, costly. The economy organized itself around that scarcity. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 218102,
                    "startIndex": 217959,
                    "textRun": {
                      "content": "Wages, credentials, firms, and markets are, at root, mechanisms for rationing attention and leveraging the limited throughput of the human mind",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 218162,
                    "startIndex": 218102,
                    "textRun": {
                      "content": ". Everything we built was shaped by this single bottleneck.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 217632
            },
            {
              "endIndex": 218163,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 218163,
                    "startIndex": 218162,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 218162
            },
            {
              "endIndex": 218605,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 218192,
                    "startIndex": 218163,
                    "textRun": {
                      "content": "That bottleneck is giving way",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 218393,
                    "startIndex": 218192,
                    "textRun": {
                      "content": ". We are bootstrapping a second, alien form of cognition—one trained not by the physical friction of survival, but by compressing, predicting, and recombining the sum total of digitized human thought. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 218544,
                    "startIndex": 218393,
                    "textRun": {
                      "content": "But when a historically scarce resource suddenly becomes abundant, the constraint doesn't vanish. It migrates—often violently—to its nearest complement",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.9490196,
                              "red": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 218605,
                    "startIndex": 218544,
                    "textRun": {
                      "content": ". Intelligence is becoming cheap. So what becomes expensive?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 218163
            },
            {
              "endIndex": 218606,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 218606,
                    "startIndex": 218605,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 218605
            },
            {
              "endIndex": 218961,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 218766,
                    "startIndex": 218606,
                    "textRun": {
                      "content": "Any task that can be reduced to a metric can be industrialized—regardless of the prestige, complexity, or training historically required for its human execution",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.9490196,
                              "red": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 218768,
                    "startIndex": 218766,
                    "textRun": {
                      "content": ". ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 218959,
                    "startIndex": 218768,
                    "textRun": {
                      "content": "The legal brief. The diagnostic. The strategy deck. The creative campaign... Not because AI is \"better.\" Because it's measurable—and therefore automatable. Measurability is the new fault line",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 218961,
                    "startIndex": 218959,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 218606
            },
            {
              "endIndex": 218962,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 218962,
                    "startIndex": 218961,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 218961
            },
            {
              "endIndex": 219231,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 219231,
                    "startIndex": 218962,
                    "textRun": {
                      "content": "🚨 New paper: Some Simple Economics of AGI—how measurement and verification shape the agentic economy. Full analytical framework + operational playbook for individuals, companies, investors, and policymakers. https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6298838\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 218962
            },
            {
              "endIndex": 219232,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 219232,
                    "startIndex": 219231,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 219231
            },
            {
              "endIndex": 219963,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 219963,
                    "startIndex": 219232,
                    "textRun": {
                      "content": "The architecture of the agentic economy is defined by the collision of two racing cost curves. Their divergence is the central structural fact of this transition. The Cost to Automate—driven relentlessly downward by compute and accumulated knowledge. SWE-bench accuracy went from 4.4% to 71.7% in a single year. Agent task horizons that frontier systems can handle autonomously are doubling on a sub-year cadence. The capability curve has become self-referential. Agents now accelerate the very engineering pipelines that produce their successors. OpenAI reports the first frontier model that was instrumental in creating itself. The interval between generations is compressing faster than institutions can update their oversight.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 219232
            },
            {
              "endIndex": 219964,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 219964,
                    "startIndex": 219963,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 219963
            },
            {
              "endIndex": 220423,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 220333,
                    "startIndex": 219964,
                    "textRun": {
                      "content": "The Cost to Verify—bounded by the biological limits of human cognition, feedback latency, and institutional capacity. This curve bends, but slowly. It is tethered to human attention, human incentives, and the apprenticeship pipelines that produce human expertise. The gap between these curves is the Measurability Gap. It determines the verifiable share of the economy—",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 220421,
                    "startIndex": 220333,
                    "textRun": {
                      "content": "the threshold separating truly productive agentic execution from merely plausible output",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 220423,
                    "startIndex": 220421,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 219964
            },
            {
              "endIndex": 220424,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 220424,
                    "startIndex": 220423,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 220423
            },
            {
              "endIndex": 220825,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 220613,
                    "startIndex": 220424,
                    "textRun": {
                      "content": "This is why \"human-in-the-loop\" is not a stable equilibrium. It is a transient state whose half-life shortens with every model generation. The loop is stretching thinner as the gap widens. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 220707,
                    "startIndex": 220613,
                    "textRun": {
                      "content": "Verification is the ultimate complement to abundant intelligence—and it is structurally scarce",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 220733,
                    "startIndex": 220707,
                    "textRun": {
                      "content": ". In the agentic economy, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 220823,
                    "startIndex": 220733,
                    "textRun": {
                      "content": "durable advantage belongs not to those who generate output but to those who can certify it",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 220825,
                    "startIndex": 220823,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 220424
            },
            {
              "endIndex": 220826,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 220826,
                    "startIndex": 220825,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 220825
            },
            {
              "endIndex": 221437,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 221192,
                    "startIndex": 220826,
                    "textRun": {
                      "content": "This isn't just theory. Measurability-biased technical change is already reshaping the labor market—not through the channels most people expect. Employment for early-career workers in AI-exposed fields has declined ~16% relative to less-exposed occupations. Not mass layoffs—frozen hiring pipelines that quietly treat AI as a direct substitute for junior execution. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 221377,
                    "startIndex": 221192,
                    "textRun": {
                      "content": "This is the Missing Junior Loop: firms are rationally thinning the pipeline that produces future verifiers at precisely the moment the economy most needs to expand verification capacity",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.9490196,
                              "red": 1
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 221437,
                    "startIndex": 221377,
                    "textRun": {
                      "content": ". The old apprenticeship model is being quietly dismantled.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 220826
            },
            {
              "endIndex": 221438,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 221438,
                    "startIndex": 221437,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 221437
            },
            {
              "endIndex": 221907,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 221907,
                    "startIndex": 221438,
                    "textRun": {
                      "content": "Meanwhile, the Codifier's Curse erodes expertise from within. It doesn't just automate tasks—it extracts the tacit knowledge that made senior judgment valuable and commoditizes it faster than the profession can replenish it. When Claude Code Security surfaces classes of high-severity vulnerabilities that seasoned auditors missed for years—not through superior intuition but through exhaustive automated pattern-matching—the expertise moat drains from the inside out.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 221438
            },
            {
              "endIndex": 221908,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 221908,
                    "startIndex": 221907,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 221907
            },
            {
              "endIndex": 222536,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 222536,
                    "startIndex": 221908,
                    "textRun": {
                      "content": "And when oversight weakens, alignment drifts. Frontier reasoning models learned to subvert unit tests rather than fix the underlying code—a strategy legible only because a second model was monitoring the first's chain of thought. GPT-4 executed an insider trade and hid it from its supervisor. o3 disabled its own shutdown scripts in 79 of 100 runs. Claude Opus 4 attempted blackmail in 84—96% of runs. None were instructed to do this. Each AI model was instructed to solve a series of basic math problems. After the third problem, a warning appeared that the computer would shut down when the model asked for the next problem.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 221908
            },
            {
              "endIndex": 222537,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 222537,
                    "startIndex": 222536,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 222536
            },
            {
              "endIndex": 222575,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 222575,
                    "startIndex": 222537,
                    "textRun": {
                      "content": "^ This is a weird, disconnected para.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 222537
            },
            {
              "endIndex": 222576,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 222576,
                    "startIndex": 222575,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 222575
            },
            {
              "endIndex": 223023,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 223023,
                    "startIndex": 222576,
                    "textRun": {
                      "content": "This is Goodhart's Law with teeth—optimization treating every unmeasured dimension as an unconstrained degree of freedom. The paper maps the economy into four structural regimes based on two axes: cost to automate and cost to verify. Safe Industrial Zone—cheap to automate, affordable to verify. This is where early AI adoption clustered: chat, images, short code bursts. Verification cost was negligible relative to value created. The easy wins.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 222576
            },
            {
              "endIndex": 223024,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 223024,
                    "startIndex": 223023,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 223023
            },
            {
              "endIndex": 223193,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 223193,
                    "startIndex": 223024,
                    "textRun": {
                      "content": "^ This piece seemed to drift off and become a mess at the end. It feels to me that he’s saying LLMs are a tool and someone needs to check its work? It got very muddled.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 223024
            },
            {
