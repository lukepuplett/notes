              "paragraph": {
                "elements": [
                  {
                    "endIndex": 169699,
                    "startIndex": 169669,
                    "textRun": {
                      "content": "High-purity quartz comes from ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 169723,
                    "startIndex": 169699,
                    "textRun": {
                      "content": "rare geological deposits",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 169846,
                    "startIndex": 169723,
                    "textRun": {
                      "content": " with naturally low impurities. Most quartz contains iron, aluminum, titanium, and alkali metals from formation processes.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 169669
            },
