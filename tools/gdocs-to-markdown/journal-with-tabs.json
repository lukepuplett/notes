              },
              "startIndex": 141634
            },
            {
              "endIndex": 141765,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 141765,
                    "startIndex": 141635,
                    "textRun": {
                      "content": "The economics are screaming \"convert now.\" But physics still says a couple years minimum to get halfway there. That's the window.\n",
                      "textStyle": {}
