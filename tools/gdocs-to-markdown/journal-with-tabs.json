            {
              "endIndex": 177828,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 177828,
                    "startIndex": 177629,
                    "textRun": {
                      "content": "^ My immediate thoughts are that it’ll be a bullish market puff piece by someone who is well versed in maximising attention and doesn’t really think deeply, since thinking is not typically rewarded.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
