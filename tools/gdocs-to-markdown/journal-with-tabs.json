                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 239375,
                    "startIndex": 239271,
                    "textRun": {
                      "content": ". This concentration underpins investor concerns regarding the long-term sustainability of this growth.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239194
            },
            {
              "endIndex": 239376,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239376,
                    "startIndex": 239375,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239375
            },
            {
              "endIndex": 239378,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239378,
                    "startIndex": 239376,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239376
            },
            {
              "endIndex": 239379,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239379,
                    "startIndex": 239378,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239378
            },
            {
              "endIndex": 239395,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239395,
                    "startIndex": 239379,
                    "textRun": {
                      "content": "Charlie Bilello\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239379
            },
            {
              "endIndex": 239411,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239411,
                    "startIndex": 239395,
                    "textRun": {
                      "content": "@charliebilello\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239395
            },
            {
              "endIndex": 239412,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239412,
                    "startIndex": 239411,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239411
            },
            {
              "endIndex": 239549,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239549,
                    "startIndex": 239412,
                    "textRun": {
                      "content": "This was the 14th straight revenue beat for Nvidia. Wall Street has underestimated its growth every single quarter for over 3 years now.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239412
            },
            {
              "endIndex": 239550,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239550,
                    "startIndex": 239549,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239549
            },
            {
              "endIndex": 239552,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239552,
                    "startIndex": 239550,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239550
            },
            {
              "endIndex": 239553,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239553,
                    "startIndex": 239552,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239552
            },
            {
              "endIndex": 239703,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239703,
                    "startIndex": 239553,
                    "textRun": {
                      "content": "> I asked Grok to look into bottlenecks for AI buildout. Bear in mind that LLMs suffer same cognitive tunnelling as humans (thinking inside the box).\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239553
            },
            {
              "endIndex": 239704,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239704,
                    "startIndex": 239703,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239703
            },
            {
              "endIndex": 240270,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 239722,
                    "startIndex": 239704,
                    "textRun": {
                      "content": "Research suggests ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 239879,
                    "startIndex": 239722,
                    "textRun": {
                      "content": "EUV lithography machines, high-bandwidth memory (HBM), and advanced packaging (e.g., TSMC CoWoS) remain the tightest constraints for GPU production into 2026",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 239917,
                    "startIndex": 239879,
                    "textRun": {
                      "content": ", even as wafer starts grow modestly. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 240049,
                    "startIndex": 239917,
                    "textRun": {
                      "content": "Power delivery lags significantly, with grid transformers and gas turbines facing multi-year backlogs amid surging datacenter demand",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 240270,
                    "startIndex": 240049,
                    "textRun": {
                      "content": ". Supporting elements like silicon wafers, copper cabling, solar components, and EUV-specific materials (tin, hydrogen, precision optics) add friction but appear less immediately binding than compute and energy hardware.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 239704
            },
            {
              "endIndex": 240271,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 240271,
                    "startIndex": 240270,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 240270
            },
            {
              "endIndex": 240939,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 240423,
                    "startIndex": 240271,
                    "textRun": {
                      "content": "Semiconductor fabrication for GPUs relies on ASML’s EUV systems as the enabling technology for advanced nodes (e.g., 3nm/2nm used in NVIDIA/AMD chips). ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 240540,
                    "startIndex": 240423,
                    "textRun": {
                      "content": "Current high-volume EUV tools (NXE:3800E) achieve ~220 wafers per hour (wph), with software upgrades reaching 230 wph",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 240738,
                    "startIndex": 240540,
                    "textRun": {
                      "content": "; High-NA systems (EXE:5200B) hit 175 wph. A 2025 breakthrough in the light source (1,000W vs. prior 600W) targets 330 wph by 2030, potentially yielding 50% more chips per machine without new fabs. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 240773,
                    "startIndex": 240738,
                    "textRun": {
                      "content": "ASML shipped 48 EUV systems in 2025",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 240939,
                    "startIndex": 240773,
                    "textRun": {
                      "content": " (44 NXE + 4 High-NA EXE). Global wafer capacity additions average ~780,000 wafer starts per month annually through 2030, weighted toward advanced logic/DRAM for AI.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 240271
            },
            {
              "endIndex": 240940,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 240940,
                    "startIndex": 240939,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 240939
            },
            {
              "endIndex": 241410,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 241182,
                    "startIndex": 240940,
                    "textRun": {
                      "content": "EUV inputs include ~100,000 molten tin droplets per second (sourced mainly from Asian mining), hydrogen buffer gas for debris mitigation (consuming >20% of system energy, with reuse tech rolling out), high-power CO₂ lasers (TRUMPF, Germany), ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 241290,
                    "startIndex": 241182,
                    "textRun": {
                      "content": "and ultra-precise multilayer mirrors (Carl Zeiss SMT, Germany—ASML’s sole optics supplier, with equity stake",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 241410,
                    "startIndex": 241290,
                    "textRun": {
                      "content": "). These create single-point vulnerabilities, though no acute shortages are reported beyond general geopolitical risks.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 240940
            },
            {
              "endIndex": 241411,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 241411,
                    "startIndex": 241410,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 241410
            },
            {
              "endIndex": 241963,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 241476,
                    "startIndex": 241411,
                    "textRun": {
                      "content": "Memory and backend packaging emerge as even tighter chokepoints. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 241622,
                    "startIndex": 241476,
                    "textRun": {
                      "content": "HBM (essential for GPU performance) is fully sold out for 2026 by major producers (SK Hynix entire output booked; Micron pivoting heavily to HBM).",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 241963,
                    "startIndex": 241622,
                    "textRun": {
                      "content": " Producing HBM consumes 3–4× more wafer area per GB than standard DRAM, diverting capacity. TSMC’s CoWoS advanced packaging (2.5D/3D integration) ramped to ~75,000 wafers/month in 2025 and targets 120,000–130,000 by late 2026—still oversubscribed and sold out into 2026–2027, limiting full GPU assembly even when logic wafers are available.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 241411
            },
            {
              "endIndex": 241964,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 241964,
                    "startIndex": 241963,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 241963
            },
            {
              "endIndex": 242344,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 242344,
                    "startIndex": 241964,
                    "textRun": {
                      "content": "Silicon wafers (starting from high-purity silica/polysilicon) grew only ~5.4% in shipments in 2025 despite 22% chip revenue growth, reflecting concentration among few suppliers (Shin-Etsu, SUMCO, GlobalWafers) and focus on 300mm for AI. U.S. share of 300mm capacity is expanding from <5% to 12–15% by 2030 via CHIPS Act incentives, but overall supply trails advanced-node demand.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 241964
            },
            {
              "endIndex": 242345,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 242345,
                    "startIndex": 242344,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 242344
            },
            {
              "endIndex": 243131,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 242425,
                    "startIndex": 242345,
                    "textRun": {
                      "content": "Datacenter energy and power infrastructure is the broadest systemic constraint. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 242577,
                    "startIndex": 242425,
                    "textRun": {
                      "content": "Grid interconnection waits exceed 4 years in many markets; large power transformers have lead times of 80–210 weeks (some transmission units 3–6 years);",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 242685,
                    "startIndex": 242577,
                    "textRun": {
                      "content": " medium-voltage switchgear averages 45–80 weeks. On-site generation via gas turbines faces massive backlogs—",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 242773,
                    "startIndex": 242685,
                    "textRun": {
                      "content": "Siemens Energy €136B order book, GE Vernova ~55 GW queued, Mitsubishi sold out into 2028",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 243070,
                    "startIndex": 242773,
                    "textRun": {
                      "content": "—with production expansions unlikely to close the gap before late 2020s. Data centers consume 30–40 metric tons of copper per MW (power delivery, busbars, cooling); AI-driven demand could push datacenter copper use from 1.1M to 2.5M metric tons globally by 2040, raising systemic shortfall risks (",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 243128,
                    "startIndex": 243070,
                    "textRun": {
                      "content": "projected refined copper deficit ~150k–400k tonnes in 2026",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 243131,
                    "startIndex": 243128,
                    "textRun": {
                      "content": ").\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 242345
            },
            {
              "endIndex": 243132,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 243132,
                    "startIndex": 243131,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 243131
            },
            {
              "endIndex": 243517,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 243517,
                    "startIndex": 243132,
                    "textRun": {
                      "content": "Solar and renewables for datacenter power face policy-driven headwinds (potential tariffs on polysilicon/cells) but benefit from U.S. domestic ramp-up (full supply chain now active: polysilicon to modules, ~65 GW annual module capacity). On-site solar is limited by land/power density and copper intensity, though high-voltage DC architectures can reduce cabling needs by ~70% vs. AC.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 243132
            },
            {
              "endIndex": 243518,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 243518,
                    "startIndex": 243517,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 243517
            },
            {
              "endIndex": 243885,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 243885,
                    "startIndex": 243518,
                    "textRun": {
                      "content": "Cabling specifics: Fiber optics dominate long-haul and increasingly intra-rack data links (shift from copper Ethernet/InfiniBand at terabit rates due to power/heat limits), relying on high-purity silica. Copper remains essential for power distribution within dense AI racks; shortages could add delays, though substitution (aluminum in some transmission) is partial.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 243518
            },
            {
              "endIndex": 243886,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 243886,
                    "startIndex": 243885,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 243885
            },
            {
              "endIndex": 244319,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 244319,
                    "startIndex": 243886,
                    "textRun": {
                      "content": "Overall, these form an interconnected system where GPU output is gated by backend steps, while datacenter deployment is gated by power hardware—creating multi-year lags even with massive capex (hyperscalers planning hundreds of GW). Mitigations include behind-the-meter generation, efficiency gains (e.g., liquid cooling, higher EUV productivity), and geographic diversification, but constraints appear structural through 2026–2027.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 243886
            },
            {
              "endIndex": 244320,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 244320,
                    "startIndex": 244319,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 244319
            },
            {
              "endIndex": 245152,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 245152,
                    "startIndex": 244320,
                    "textRun": {
                      "content": "The full picture of AI/GPU/datacenter supply chains reveals a web of interdependent bottlenecks far beyond any single material like silica. While raw silica (quartz sand) is abundant and feeds into polysilicon for wafers or fused silica for fiber optics, the purification, ingot growth, and wafer slicing for 300mm substrates used in advanced nodes represent a capacity-constrained step. Global silicon wafer area shipments reached ~13.4 billion square inches in 2024 and grew modestly thereafter; 2025 chip revenue surged 22% while wafer shipments rose only ~5.4%, as AI demand prioritizes high-value advanced logic/DRAM over volume. Major producers are reallocating cleanroom space—e.g., SUMCO phasing out 200mm by late 2026 to focus on AI-grade 300mm—while U.S. expansions (GlobalWafers Texas plant) aim to reduce Asia reliance.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 244320
            },
            {
              "endIndex": 245153,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 245153,
                    "startIndex": 245152,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 245152
            },
            {
              "endIndex": 246556,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 245704,
                    "startIndex": 245153,
                    "textRun": {
                      "content": "EUV lithography sits at the heart of scaling for NVIDIA Blackwell/Rubin-class GPUs and custom AI accelerators. ASML’s 2025 systems (NXE:3800E at 220–230 wph; EXE:5200B at 175 wph) enable the critical layers at ≤7nm nodes. The April 2025 1,000W light-source demonstration (doubling tin droplets to 100k/sec, dual laser bursts for plasma shaping) unlocks the 330 wph roadmap by 2030, lowering cost per chip ~33% at scale without proportional fab expansion. Annual output per machine depends on utilization (typically 80–90% after maintenance/downtime), ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 245776,
                    "startIndex": 245704,
                    "textRun": {
                      "content": "yielding roughly 1.5–2 million wafers/year at peak for high-volume tools",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 246556,
                    "startIndex": 245776,
                    "textRun": {
                      "content": ", though actual fab layering means EUV handles only the most critical steps. ASML shipped 48 EUV units in 2025 (up from prior years), with installed base driving service revenue; >400,000 wafers processed on High-NA tools by year-end. Supply-chain dependencies are acute: tin from China/Indonesia/Malaysia mines; hydrogen (high consumption for tin debris mitigation via SnH₄ formation and in-situ plasma cleaning); CO₂ lasers exclusively from TRUMPF (Germany); and collector/imaging optics from Zeiss SMT (sole supplier, ASML holds ~25% stake with advance payments exceeding €1B). Hydrogen reuse tech (80% recovery) and energy-per-wafer reductions (57% since 2018 for NXE tools) mitigate operational inputs, but geopolitical export controls and single-source optics remain risks.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 245153
            },
            {
              "endIndex": 246557,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 246557,
                    "startIndex": 246556,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 246556
            },
            {
              "endIndex": 247595,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 246569,
                    "startIndex": 246557,
                    "textRun": {
                      "content": "Downstream, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 246646,
                    "startIndex": 246569,
                    "textRun": {
                      "content": "HBM memory and CoWoS packaging are the binding constraints for shippable GPUs",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 246967,
                    "startIndex": 246646,
                    "textRun": {
                      "content": ". HBM3E/HBM4 stacks require specialized processes; the three dominant suppliers (Samsung, SK Hynix, Micron—~90–95% DRAM control) have redirected wafers to AI, tightening conventional DRAM and pushing prices higher. HBM is sold out through 2026, with hyperscalers (Microsoft, Google, Meta) reserving capacity years ahead; ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 247020,
                    "startIndex": 246967,
                    "textRun": {
                      "content": "one GB of HBM can consume 3–4× the wafer area of DDR5",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 247243,
                    "startIndex": 247020,
                    "textRun": {
                      "content": ". TSMC’s CoWoS (chip-on-wafer-on-substrate) for 2.5D/3D integration of logic + HBM stacks ramped aggressively but stays oversubscribed: ~75k wafers/month in 2025 scaling to 120–130k by end-2026 (some projections 110–140k), ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 247406,
                    "startIndex": 247243,
                    "textRun": {
                      "content": "yet still insufficient for projected demand—NVIDIA alone takes ~55–60% allocation, supporting only ~50% of announced global datacenter GW buildout in some analyses",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 247595,
                    "startIndex": 247406,
                    "textRun": {
                      "content": ". Backend capacity (interposers, substrates, test/assembly) thus caps output even when front-end wafers are available; TSMC notes advanced-node logic is “about 3× short” of customer plans.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 246557
            },
            {
              "endIndex": 247596,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 247596,
                    "startIndex": 247595,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 247595
            },
            {
              "endIndex": 247947,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 247947,
                    "startIndex": 247596,
                    "textRun": {
                      "content": "Energy infrastructure for datacenters amplifies these issues. AI clusters demand 100s of MW to GW-scale sites, tripling U.S. datacenter power draw in a decade and potentially reaching 106 GW by 2035. Grid interconnection queues exceed 4 years in primary markets; utilities face 55% of distribution transformers >33 years old. Key hardware lead times:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 247596
            },
            {
              "endIndex": 247948,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 247948,
                    "startIndex": 247947,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 247947
            },
            {
              "endIndex": 248025,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 248025,
                    "startIndex": 247948,
                    "textRun": {
                      "content": "Large power transformers: 80–210 weeks (transmission-class up to 3–6 years).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 247948
            },
            {
              "endIndex": 248066,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 248066,
                    "startIndex": 248025,
                    "textRun": {
                      "content": "Medium-voltage switchgear: ~45–80 weeks.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 248025
            },
            {
              "endIndex": 248263,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 248263,
                    "startIndex": 248066,
                    "textRun": {
                      "content": "Gas turbines (for on-site/backup generation): Sold out into 2028; Siemens €136B backlog, GE ~55 GW queued, Mitsubishi doubling output but insufficient to close 20–25% supply gap before late 2020s.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 248066
            },
            {
              "endIndex": 248384,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 248384,
                    "startIndex": 248263,
                    "textRun": {
                      "content": "High-voltage cables, steel poles, circuit breakers: Multi-year backlogs, with copper/steel tariffs adding cost pressure.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 248263
            },
            {
              "endIndex": 248385,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 248385,
                    "startIndex": 248384,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 248384
            },
            {
              "endIndex": 249260,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 249260,
                    "startIndex": 248385,
                    "textRun": {
                      "content": "Copper intensity is high—30–40 metric tons/MW for non-crypto datacenters (power delivery, busbars, cold plates); AI training clusters drive datacenter copper demand from 1.1M metric tons (2025) toward 2.5M by 2040. Fiber optics increasingly replace short-reach copper for data interconnects (terabit+ rates cause copper to require thicker/shorter runs, higher power/heat), relying on high-purity silica preforms; this shift modestly reduces copper needs inside racks but not overall power infrastructure. Solar for behind-the-meter or PPA renewables faces polysilicon tariffs/investigations (China-dominant supply), though U.S. module capacity hit ~65 GW with full vertical integration (polysilicon → ingots → wafers → cells → modules) now online; high-voltage DC solar architectures can cut cabling current ~70%, easing copper constraints for direct datacenter integration.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 248385
            },
            {
              "endIndex": 249261,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 249261,
                    "startIndex": 249260,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 249260
            },
            {
              "endIndex": 249919,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 249919,
                    "startIndex": 249261,
                    "textRun": {
                      "content": "These bottlenecks interact: GPU shortages delay datacenter fill rates, while power delays strand compute assets. Hyperscalers respond with colocation, behind-the-meter gas/storage, and efficiency (liquid cooling, higher EUV utilization). Long-term relief comes from CoWoS/HBM expansions, EUV productivity gains, domestic wafer/transformer manufacturing, and diversified energy (gas + solar + nuclear). Yet structural concentration—Europe for EUV optics/lasers, Asia for tin/HBM wafers, limited U.S. heavy-equipment capacity—means constraints will likely persist as the “new normal” through at least 2027, shaping where and how fast AI infrastructure scales.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 249261
            },
            {
              "endIndex": 249920,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 249920,
                    "startIndex": 249919,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 249919
            },
            {
              "endIndex": 250568,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 250125,
                    "startIndex": 249920,
                    "textRun": {
                      "content": "Research suggests TSMC, ASML, SK Hynix, Micron, GE Vernova, and Siemens Energy are among the companies best positioned to benefit most over the next 5 years from AI, GPU, datacenter, and energy bottlenecks",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 250272,
                    "startIndex": 250125,
                    "textRun": {
                      "content": ". These firms control critical chokepoints—advanced packaging and foundry capacity, EUV lithography, high-bandwidth memory (HBM), and gas turbines—",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 250389,
                    "startIndex": 250272,
                    "textRun": {
                      "content": "where demand outstrips supply through at least 2030, supporting pricing power, backlogs, and sustained revenue growth",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 250568,
                    "startIndex": 250389,
                    "textRun": {
                      "content": ". Evidence leans toward strong tailwinds from hyperscaler capex, though geopolitical risks, execution on capacity ramps, and any softening in AI spending could moderate outcomes.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 249920
            },
            {
              "endIndex": 250569,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 250569,
                    "startIndex": 250568,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 250568
            },
            {
              "endIndex": 251319,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 251260,
                    "startIndex": 250569,
                    "textRun": {
                      "content": "Semiconductor chokepoints favor leaders with irreplaceable technology or sold-out capacity. TSMC dominates advanced-node logic and CoWoS packaging (essential for stacking GPUs with HBM), with Q1 2026 revenue guidance up ~25.5% year-over-year and full-year earnings growth projected around 33%. ASML holds a near-monopoly on EUV systems required for leading-edge nodes, guiding 2026 sales at €34–39 billion amid a €38.8 billion backlog driven by AI-related orders. In memory, SK Hynix (HBM market share >50%) and Micron benefit from HBM sold-out status into 2026–2027 and industry forecasts of 30%+ CAGR for AI memory through 2030, delivering pricing leverage and massive earnings expansion (",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 251316,
                    "startIndex": 251260,
                    "textRun": {
                      "content": "Micron projected +308% for FY2026 in one recent analysis",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 251319,
                    "startIndex": 251316,
                    "textRun": {
                      "content": ").\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 250569
            },
            {
              "endIndex": 251320,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 251320,
                    "startIndex": 251319,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 251319
            },
            {
              "endIndex": 251848,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 251443,
                    "startIndex": 251320,
                    "textRun": {
                      "content": "Energy and power delivery represent the broadest constraint, with datacenter demand projected to more than double by 2030. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 251762,
                    "startIndex": 251443,
                    "textRun": {
                      "content": "GE Vernova enters 2026 with an ~80 GW gas-turbine backlog (roughly one-third AI-linked), reservations sold out through 2030, and production ramping but insufficient to close the gap quickly. Siemens Energy reports a €138 billion order backlog, with AI datacenters a key driver and stock performance reflecting the surge",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 251848,
                    "startIndex": 251762,
                    "textRun": {
                      "content": ". These lead times (often 3–5+ years) create scarcity premiums for turbine suppliers.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 251320
            },
            {
              "endIndex": 252322,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 252322,
                    "startIndex": 251848,
                    "textRun": {
                      "content": "Supporting areas like silicon wafers and copper see solid but less explosive gains. Wafer leaders (Shin-Etsu, SUMCO, GlobalWafers) shift capacity toward 300mm AI-grade substrates amid 4–6% CAGR market growth, while copper demand from datacenters could add 330,000–500,000 tonnes annually by 2030, benefiting major miners indirectly through higher prices and volumes. Solar firms like First Solar gain from behind-the-meter renewable PPAs but face land and policy variables.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 251848
            },
            {
              "endIndex": 252323,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 252323,
                    "startIndex": 252322,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 252322
            },
            {
              "endIndex": 252633,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 252633,
                    "startIndex": 252323,
                    "textRun": {
                      "content": "Key risks include Taiwan/China tensions for TSMC/ASML exposure, supply-chain execution for all, and potential AI hype cycles. Overall, the structural nature of these bottlenecks—long-lead equipment, concentrated production, and surging hyperscaler spend—points to multi-year advantages for the listed players.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 252323
            },
            {
              "endIndex": 252634,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 252634,
                    "startIndex": 252633,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 252633
            },
            {
              "endIndex": 252636,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 252635,
                    "inlineObjectElement": {
                      "inlineObjectId": "kix.736m2ils00r3",
                      "textStyle": {}
                    },
                    "startIndex": 252634
                  },
                  {
