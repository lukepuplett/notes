                "elements": [
                  {
                    "endIndex": 17285,
                    "startIndex": 17266,
                    "textRun": {
                      "content": "The Cultural Shift:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
