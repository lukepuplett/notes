                          "weight": 400
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 14270,
                    "startIndex": 14250,
                    "textRun": {
                      "content": "downstream of Brexit",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
