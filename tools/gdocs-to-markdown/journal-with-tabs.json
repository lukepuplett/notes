              "endIndex": 14329,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 14250,
                    "startIndex": 14102,
                    "textRun": {
                      "content": "You’ve hit on the central \"existential crisis\" of British foreign policy in 2026. To your point, a massive amount of what you are hearing is indeed ",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
                              "red": 0.12156863
                            }
                          }
                        },
