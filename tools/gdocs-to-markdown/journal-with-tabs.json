                          "weight": 400
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 14329,
                    "startIndex": 14270,
                    "textRun": {
                      "content": ", but not necessarily in the way people predicted in 2016.\n",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
                              "red": 0.12156863
                            }
                          }
                        },
                        "weightedFontFamily": {
