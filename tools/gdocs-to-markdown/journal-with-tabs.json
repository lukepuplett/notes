              "endIndex": 131442,
              "paragraph": {
                "bullet": {
                  "listId": "kix.uz4i8xkk50yk",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 131442,
                    "startIndex": 131341,
                    "textRun": {
                      "content": "Attribute expansion: more schemas (e.g., location, KYC level, reputation score) → richer ProofPacks.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "indentFirstLine": {
