                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305712
            },
            {
              "endIndex": 305718,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305718,
                    "startIndex": 305713,
                    "textRun": {
                      "content": "####\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305713
            },
            {
              "endIndex": 305719,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305719,
                    "startIndex": 305718,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305718
            },
            {
              "endIndex": 306054,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 306054,
                    "startIndex": 305719,
                    "textRun": {
                      "content": "today we're making one of the hardest decisions in the history of our company: we're reducing our organization by nearly half, from over 10,000 people to just under 6,000. that means over 4,000 of you are being asked to leave or entering into consultation. i'll be straight about what's happening, why, and what it means for everyone.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305719
            },
            {
              "endIndex": 306055,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 306055,
                    "startIndex": 306054,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 306054
            },
            {
              "endIndex": 306616,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 306616,
                    "startIndex": 306055,
                    "textRun": {
                      "content": "first off, if you're one of the people affected, you'll receive your salary for 20 weeks + 1 week per year of tenure, equity vested through the end of may, 6 months of health care, your corporate devices, and $5,000 to put toward whatever you need to help you in this transition (if you’re outside the U.S. you’ll receive similar support but exact details are going to vary based on local requirements). i want you to know that before anything else. everyone will be notified today, whether you're being asked to leave, entering consultation, or asked to stay.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 306055
            },
            {
              "endIndex": 306617,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 306617,
                    "startIndex": 306616,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 306616
            },
            {
              "endIndex": 307086,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 307086,
                    "startIndex": 306617,
                    "textRun": {
                      "content": "we're not making this decision because we're in trouble. our business is strong. gross profit continues to grow, we continue to serve more and more customers, and profitability is improving. but something has changed. we're already seeing that the intelligence tools we’re creating and using, paired with smaller and flatter teams, are enabling a new way of working which fundamentally changes what it means to build and run a company. and that's accelerating rapidly.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 306617
            },
            {
              "endIndex": 307087,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 307087,
                    "startIndex": 307086,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 307086
            },
            {
              "endIndex": 307670,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 307141,
                    "startIndex": 307087,
                    "textRun": {
                      "content": "i had two options: cut gradually over months or years ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 307164,
                    "startIndex": 307141,
                    "textRun": {
                      "content": "as this shift plays out",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 307670,
                    "startIndex": 307164,
                    "textRun": {
                      "content": ", or be honest about where we are and act on it now. i chose the latter. repeated rounds of cuts are destructive to morale, to focus, and to the trust that customers and shareholders place in our ability to lead. i'd rather take a hard, clear action now and build from a position we believe in than manage a slow reduction of people toward the same outcome. a smaller company also gives us the space to grow our business the right way, on our own terms, instead of constantly reacting to market pressures.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 307087
            },
            {
              "endIndex": 307671,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 307671,
                    "startIndex": 307670,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 307670
            },
            {
              "endIndex": 308060,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 308060,
                    "startIndex": 307671,
                    "textRun": {
                      "content": "a decision at this scale carries risk. but so does standing still. we've done a full review to determine the roles and people we require to reliably grow the business from here, and we've pressure-tested those decisions from multiple angles. i accept that we may have gotten some of them wrong, and we've built in flexibility to account for that, and do the right thing for our customers.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 307671
            },
            {
              "endIndex": 308061,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 308061,
                    "startIndex": 308060,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 308060
            },
            {
              "endIndex": 308483,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 308483,
                    "startIndex": 308061,
                    "textRun": {
                      "content": "we're not going to just disappear people from slack and email and pretend they were never here. communication channels will stay open through thursday evening (pacific) so everyone can say goodbye properly, and share whatever you wish. i'll also be hosting a live video session to thank everyone at 3:35pm pacific. i know doing it this way might feel awkward. i'd rather it feel awkward and human than efficient and cold.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 308061
            },
            {
              "endIndex": 308484,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 308484,
                    "startIndex": 308483,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 308483
            },
            {
              "endIndex": 308772,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 308772,
                    "startIndex": 308484,
                    "textRun": {
                      "content": "to those of you leaving…i’m grateful for you, and i’m sorry to put you through this. you built what this company is today. that's a fact that i'll honor forever. this decision is not a reflection of what you contributed. you will be a great contributor to any organization going forward.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 308484
            },
            {
              "endIndex": 308773,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 308773,
                    "startIndex": 308772,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 308772
            },
            {
              "endIndex": 309291,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 309291,
                    "startIndex": 308773,
                    "textRun": {
                      "content": "to those staying…i made this decision, and i'll own it. what i'm asking of you is to build with me. we're going to build this company with intelligence at the core of everything we do. how we work, how we create, how we serve our customers. our customers will feel this shift too, and we're going to help them navigate it: towards a future where they can build their own features directly, composed of our capabilities and served through our interfaces. that's what i'm focused on now. expect a note from me tomorrow.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 308773
            },
            {
              "endIndex": 309292,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 309292,
                    "startIndex": 309291,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 309291
            },
            {
              "endIndex": 309297,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 309297,
                    "startIndex": 309292,
                    "textRun": {
                      "content": "Jack\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 309292
            },
