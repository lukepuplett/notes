            {
              "endIndex": 78840,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 78840,
                    "startIndex": 78795,
                    "textRun": {
                      "content": "^ I think this is wealthy and smart leaving.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
