                "elements": [
                  {
                    "endIndex": 6108,
                    "startIndex": 6045,
                    "textRun": {
                      "content": "And the single most underrated pattern inside these harnesses?\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 6045
            },
