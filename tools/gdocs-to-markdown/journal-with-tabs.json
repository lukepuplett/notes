              "endIndex": 15572,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 15572,
                    "startIndex": 15482,
                    "textRun": {
                      "content": "It ranks them on regulatory factors. It ranks them on cost and tolerance of being wrong. \n",
