              "endIndex": 131532,
              "paragraph": {
                "bullet": {
                  "listId": "kix.uz4i8xkk50yk",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 131532,
                    "startIndex": 131442,
                    "textRun": {
                      "content": "Cross-chain support: attestations/delegations portable (e.g., Injective ↔ Base/Ethereum).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
