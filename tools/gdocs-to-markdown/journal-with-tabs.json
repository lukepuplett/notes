                  {
                    "endIndex": 160458,
                    "startIndex": 160422,
                    "textRun": {
                      "content": " — to run huge AI clusters in Texas\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 160371
            },
            {
              "endIndex": 160559,
              "paragraph": {
