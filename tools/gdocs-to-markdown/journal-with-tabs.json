              "endIndex": 30660,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30660,
                    "startIndex": 30596,
                    "textRun": {
                      "content": "^ Actual job postings for software devs is rising very sharply \n",
                      "textStyle": {
