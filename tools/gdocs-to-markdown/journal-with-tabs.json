              "endIndex": 40060,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 40060,
                    "startIndex": 39876,
                    "textRun": {
                      "content": "Huge News!  Today, I am proud to introduce the Greenland Annexation and Statehood Act, a bill that allows the President to find the means necessary to bring Greenland into the Union. \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 39876
            },
            {
              "endIndex": 40061,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 40061,
                    "startIndex": 40060,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 40060
            },
            {
              "endIndex": 40176,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 40176,
                    "startIndex": 40061,
                    "textRun": {
                      "content": "Let me be clear, our adversaries are trying to establish a foothold in the Arctic, and we can’t let that happen.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 40061
            },
            {
              "endIndex": 40177,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 40177,
                    "startIndex": 40176,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 40176
            },
            {
              "endIndex": 40322,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 40322,
                    "startIndex": 40177,
                    "textRun": {
                      "content": "By acquiring Greenland, we would prevent our adversaries from controlling the Arctic Region and secure our northern flank from Russia and China.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
