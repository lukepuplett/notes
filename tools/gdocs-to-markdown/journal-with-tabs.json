            {
              "endIndex": 14783,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 14783,
                    "startIndex": 14632,
                    "textRun": {
                      "content": "Before Brexit, the UK's greatest value to the U.S. was its ability to \"speak European\" and influence the world's largest trading bloc from the inside.\n",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
