                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
                  },
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 118702
            },
            {
              "endIndex": 119372,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 119372,
                    "startIndex": 119291,
                    "textRun": {
                      "content": "With agents and a team of 2 humans, you can get to that complexity within weeks.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
