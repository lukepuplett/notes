              "paragraph": {
                "elements": [
                  {
                    "endIndex": 11789,
                    "startIndex": 11573,
                    "textRun": {
                      "content": "I suspect this is Apple's last mover play. They're waiting until the curves of improving narrow/specific models and efficient local matmul crossover and unlock local inference, adequate for 95% of consumer busywork.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 11573
            },
