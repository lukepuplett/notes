            {
              "endIndex": 5618,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 5618,
                    "startIndex": 5341,
                    "textRun": {
                      "content": "\"Bubbles tend to pop when debt that is perceived to be safe runs into trouble:\" Reynolds Strategy. Yesterday's $25bn bold sale from Oracle showed that financing for AI is still ample, \"but it does not change the big picture of a bubble that we expect will burst in 3-5 years.\"\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 5341
            },
