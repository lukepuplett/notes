              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61422,
                    "startIndex": 61384,
                    "textRun": {
                      "content": "OUT NOW - how @Rory_Johnston sees it:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61384
            },
            {
              "endIndex": 61423,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61423,
                    "startIndex": 61422,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61422
            },
            {
              "endIndex": 61512,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 61512,
                    "startIndex": 61423,
                    "textRun": {
                      "content": "Unless the Strait of Hormuz opens soon, $220 oil and a recession is \"almost guaranteed.\"\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 61423
            },
