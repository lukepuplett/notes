                "elements": [
                  {
                    "endIndex": 13926,
                    "startIndex": 13903,
                    "textRun": {
                      "content": "International Backlash:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
