            {
              "endIndex": 14586,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 14586,
                    "startIndex": 14329,
                    "textRun": {
                      "content": "The \"disalignment\" isn't just a mood; it’s the result of the UK losing its unique structural position in the world. Here is how that \"downstream\" effect is playing out in the context of the recent tensions with the U.S. and the rise of other power centers.\n",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
