              "endIndex": 44636,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 44636,
                    "startIndex": 44545,
                    "textRun": {
                      "content": "Now the most valuable person is the business/GTM person that understands some engineering.\n",
                      "textStyle": {}
