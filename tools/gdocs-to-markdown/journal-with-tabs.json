                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121311
            },
            {
              "endIndex": 121349,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121349,
                    "startIndex": 121331,
                    "textRun": {
                      "content": "June 30th, 2028  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121331
            },
            {
              "endIndex": 121350,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121350,
                    "startIndex": 121349,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121349
            },
            {
              "endIndex": 121385,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121385,
                    "startIndex": 121350,
                    "textRun": {
                      "content": "^ This is written from the future.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121350
            },
            {
              "endIndex": 121386,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121386,
                    "startIndex": 121385,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121385
            },
            {
              "endIndex": 121580,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121580,
                    "startIndex": 121386,
                    "textRun": {
                      "content": "The unemployment rate printed 10.2% this morning, a 0.3% upside surprise. The market sold off 2% on the number, bringing the cumulative drawdown in the S&P to 38% from its October 2026 highs.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121386
            },
            {
              "endIndex": 121581,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121581,
                    "startIndex": 121580,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121580
            },
            {
              "endIndex": 121682,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121682,
                    "startIndex": 121581,
                    "textRun": {
                      "content": "Traders have grown numb. Six months ago, a print like this would have triggered a circuit breaker.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121581
            },
            {
              "endIndex": 121683,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121683,
                    "startIndex": 121682,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121682
            },
            {
              "endIndex": 121942,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121942,
                    "startIndex": 121683,
                    "textRun": {
                      "content": "Two years. That’s all it took to get from “contained” and “sector-specific” to an economy that no longer resembles the one any of us grew up in. This quarter’s macro memo is our attempt to reconstruct the sequence — a post-mortem on the pre-crisis economy.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121683
            },
            {
              "endIndex": 121943,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 121943,
                    "startIndex": 121942,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121942
            },
            {
              "endIndex": 122298,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122221,
                    "startIndex": 121943,
                    "textRun": {
                      "content": "The euphoria was palpable. By October 2026, the S&P 500 flirted with 8000, the Nasdaq broke above 30k. The initial wave of layoffs due to human obsolescence began in early 2026, and they did exactly what layoffs are supposed to. Margins expanded, earnings beat, stocks rallied. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 122298,
                    "startIndex": 122221,
                    "textRun": {
                      "content": "Record-setting corporate profits were funneled right back into AI compute.  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.8
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 121943
            },
            {
              "endIndex": 122299,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122299,
                    "startIndex": 122298,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122298
            },
            {
              "endIndex": 122584,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122584,
                    "startIndex": 122299,
                    "textRun": {
                      "content": "The headline numbers were still great. Nominal GDP repeatedly printed mid-to-high single-digit annualized growth. Productivity was booming. Real output per hour rose at rates not seen since the 1950s, driven by AI agents that don’t sleep, take sick days or require health insurance.  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.65882355,
                              "green": 0.84313726,
                              "red": 0.7137255
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122299
            },
            {
              "endIndex": 122585,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122585,
                    "startIndex": 122584,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.65882355,
                              "green": 0.84313726,
                              "red": 0.7137255
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122584
            },
            {
              "endIndex": 122851,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122656,
                    "startIndex": 122585,
                    "textRun": {
                      "content": "The owners of compute saw their wealth explode as labor costs vanished.",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.65882355,
                              "green": 0.84313726,
                              "red": 0.7137255
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 122657,
                    "startIndex": 122656,
                    "textRun": {
                      "content": " ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 122847,
                    "startIndex": 122657,
                    "textRun": {
                      "content": "Meanwhile, real wage growth collapsed. Despite the administration’s repeated boasts of record productivity, white-collar workers lost jobs to machines and were forced into lower-paying roles",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 122851,
                    "startIndex": 122847,
                    "textRun": {
                      "content": ".  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122585
            },
            {
              "endIndex": 122852,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 122852,
                    "startIndex": 122851,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122851
            },
            {
              "endIndex": 123057,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123053,
                    "startIndex": 122852,
                    "textRun": {
                      "content": "When cracks began appearing in the consumer economy, economic pundits popularized the phrase “**Ghost GDP**”: output that shows up in the national accounts but never circulates through the real economy",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 123057,
                    "startIndex": 123053,
                    "textRun": {
                      "content": ".  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 122852
            },
            {
              "endIndex": 123058,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123058,
                    "startIndex": 123057,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123057
            },
            {
              "endIndex": 123166,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123166,
                    "startIndex": 123058,
                    "textRun": {
                      "content": "In every way AI was exceeding expectations, and the market was AI. The only problem… the economy was not.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123058
            },
            {
              "endIndex": 123167,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123167,
                    "startIndex": 123166,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123166
            },
            {
              "endIndex": 123632,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123341,
                    "startIndex": 123167,
                    "textRun": {
                      "content": "It should have been clear all along that a single GPU cluster in North Dakota generating the output previously attributed to 10,000 white-collar workers in midtown Manhattan ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 123388,
                    "startIndex": 123341,
                    "textRun": {
                      "content": "is more economic pandemic than economic panacea",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 123423,
                    "startIndex": 123388,
                    "textRun": {
                      "content": ". The velocity of money flatlined. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 123491,
                    "startIndex": 123423,
                    "textRun": {
                      "content": "The human-centric consumer economy, 70% of GDP at the time, withered",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 123493,
                    "startIndex": 123491,
                    "textRun": {
                      "content": ". ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 123610,
                    "startIndex": 123493,
                    "textRun": {
                      "content": "We probably could have figured this out sooner if we just asked how much money machines spend on discretionary goods.",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 123632,
                    "startIndex": 123610,
                    "textRun": {
                      "content": " (Hint: it’s zero.)  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123167
            },
            {
              "endIndex": 123633,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123633,
                    "startIndex": 123632,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123632
            },
            {
              "endIndex": 123759,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123759,
                    "startIndex": 123633,
                    "textRun": {
                      "content": "^ But those remaining at the firms will be paid vastly more and spend more, however trickle-down is said not to work (data?).\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123633
            },
            {
              "endIndex": 123760,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123760,
                    "startIndex": 123759,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123759
            },
            {
              "endIndex": 123959,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123816,
                    "startIndex": 123760,
                    "textRun": {
                      "content": "AI capabilities improved, companies needed fewer workers",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.827451,
                              "green": 0.91764706,
                              "red": 0.8509804
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 123850,
                    "startIndex": 123816,
                    "textRun": {
                      "content": ", white collar layoffs increased, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 123878,
                    "startIndex": 123850,
                    "textRun": {
                      "content": "displaced workers spent less",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 123959,
                    "startIndex": 123878,
                    "textRun": {
                      "content": ", margin pressure pushed firms to invest more in AI, AI capabilities improved…  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123760
            },
            {
              "endIndex": 123960,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 123960,
                    "startIndex": 123959,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123959
            },
            {
              "endIndex": 124316,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124014,
                    "startIndex": 123960,
                    "textRun": {
                      "content": "It was a negative feedback loop with no natural brake.",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 124235,
                    "startIndex": 124014,
                    "textRun": {
                      "content": " The **human intelligence displacement spiral**. White-collar workers saw their earnings power (and, rationally, their spending) structurally impaired. Their incomes were the bedrock of the $13 trillion mortgage market — ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 124313,
                    "startIndex": 124235,
                    "textRun": {
                      "content": "forcing underwriters to reassess whether prime mortgages are still money good.",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 124316,
                    "startIndex": 124313,
                    "textRun": {
                      "content": "  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 123960
            },
            {
              "endIndex": 124317,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124317,
                    "startIndex": 124316,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124316
            },
            {
              "endIndex": 124549,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124549,
                    "startIndex": 124317,
                    "textRun": {
                      "content": "Seventeen years without a real default cycle had left privates bloated with PE-backed software deals that assumed ARR would remain recurring. The first wave of defaults due to AI disruption in mid-2027 challenged that assumption.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124317
            },
            {
              "endIndex": 124550,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124550,
                    "startIndex": 124549,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124549
            },
            {
              "endIndex": 124611,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124611,
                    "startIndex": 124550,
                    "textRun": {
                      "content": "^ House price spiral on top of structural fertility changes.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        },
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124550
            },
            {
              "endIndex": 124612,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124612,
                    "startIndex": 124611,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124611
            },
            {
              "endIndex": 124871,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124732,
                    "startIndex": 124612,
                    "textRun": {
                      "content": "This would have been manageable if the disruption remained contained to software, but it didn’t. By the end of 2027, it ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 124792,
                    "startIndex": 124732,
                    "textRun": {
                      "content": "threatened every business model predicated on intermediation",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 124871,
                    "startIndex": 124792,
                    "textRun": {
                      "content": ". Swaths of companies built on monetizing friction for humans disintegrated.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124612
            },
            {
              "endIndex": 124872,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 124872,
                    "startIndex": 124871,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124871
            },
            {
              "endIndex": 125082,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125082,
                    "startIndex": 124872,
                    "textRun": {
                      "content": "The system turned out to be one long daisy chain of correlated bets on white-collar productivity growth. The November 2027 crash only served to accelerate all of the negative feedback loops already in place.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 124872
            },
            {
              "endIndex": 125083,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125083,
                    "startIndex": 125082,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125082
            },
            {
              "endIndex": 125436,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125436,
                    "startIndex": 125083,
                    "textRun": {
                      "content": "We’ve been waiting for “bad news is good news” for almost a year now. The government is starting to consider proposals, but public faith in the ability of the government to stage any sort of rescue has dwindled. Policy response has always lagged economic reality, but lack of a comprehensive plan is now threatening to accelerate a deflationary spiral.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125083
            },
            {
              "endIndex": 125437,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125437,
                    "startIndex": 125436,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125436
            },
            {
              "endIndex": 125458,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125458,
                    "startIndex": 125437,
                    "textRun": {
                      "content": "**How It Started**  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125437
            },
            {
              "endIndex": 125536,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125536,
                    "startIndex": 125458,
                    "textRun": {
                      "content": "In late 2025, agentic coding tools took a step function jump in capability.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125458
            },
            {
              "endIndex": 125537,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125537,
                    "startIndex": 125536,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125536
            },
            {
              "endIndex": 125854,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125854,
                    "startIndex": 125537,
                    "textRun": {
                      "content": "A competent developer working with Claude Code or Codex could now replicate the core functionality of a mid-market SaaS product in weeks. Not perfectly or with every edge case handled, but well enough that the CIO reviewing a $500k annual renewal started asking the question “what if we just built this ourselves?”  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125537
            },
            {
              "endIndex": 125855,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 125855,
                    "startIndex": 125854,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125854
            },
            {
              "endIndex": 126239,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 126239,
                    "startIndex": 125855,
                    "textRun": {
                      "content": "Fiscal years mostly line up with calendar years, so 2026 enterprise spend had been set in Q4 2025, when “agentic AI” was still a buzzword. The mid-year review was the first time procurement teams were making decisions with visibility into what these systems could actually do. Some watched their own internal teams spin up prototypes replicating six-figure SaaS contracts in weeks.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 125855
            },
            {
              "endIndex": 126240,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 126240,
                    "startIndex": 126239,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 126239
            },
            {
              "endIndex": 126810,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 126498,
                    "startIndex": 126240,
                    "textRun": {
                      "content": "That summer, we spoke with a procurement manager at a Fortune 500. He told us about one of his budget negotiations. The salesperson had expected to run the same playbook as last year: a 5% annual price increase, the standard “your team depends on us” pitch. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 126661,
                    "startIndex": 126498,
                    "textRun": {
                      "content": "The procurement manager told him he’d been in conversations with OpenAI about having their “forward deployed engineers” use AI tools to replace the vendor entirely",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 126810,
                    "startIndex": 126661,
                    "textRun": {
                      "content": ". They renewed at a 30% discount. That was a good outcome, he said. The “long-tail of SaaS”, like Monday.com, Zapier and Asana, had it much worse.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 126240
            },
            {
              "endIndex": 126811,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 126811,
                    "startIndex": 126810,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 126810
            },
            {
              "endIndex": 127078,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127002,
                    "startIndex": 126811,
                    "textRun": {
                      "content": "Investors were prepared — expectant, even — that the long tail would be hit hard. They may have made up a third of spending for the typical enterprise stack, but they were obviously exposed. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 127078,
                    "startIndex": 127002,
                    "textRun": {
                      "content": "The systems of record, however, were supposed to be safe from disruption.  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 126811
            },
            {
              "endIndex": 127079,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127079,
                    "startIndex": 127078,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127078
            },
            {
              "endIndex": 127173,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127173,
                    "startIndex": 127079,
                    "textRun": {
                      "content": "It wasn’t until ServiceNow’s Q3 26 report that the mechanism of reflexivity became clearer.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127079
            },
            {
              "endIndex": 127174,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127174,
                    "startIndex": 127173,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127173
            },
            {
              "endIndex": 127350,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127350,
                    "startIndex": 127174,
                    "textRun": {
                      "content": "> SERVICENOW NET NEW ACV GROWTH DECELERATES TO 14% FROM 23%; ANNOUNCES 15% WORKFORCE REDUCTION AND ‘STRUCTURAL EFFICIENCY PROGRAM’; SHARES FALL 18% | Bloomberg, October 2026  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127174
            },
            {
              "endIndex": 127351,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127351,
                    "startIndex": 127350,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127350
            },
            {
              "endIndex": 127960,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127458,
                    "startIndex": 127351,
                    "textRun": {
                      "content": "SaaS wasn’t “dead”. There was still a cost-benefit-analysis to running and supporting in-house builds. But ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 127525,
                    "startIndex": 127458,
                    "textRun": {
                      "content": "in-house was an option, and that factored into pricing negotiations",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 127651,
                    "startIndex": 127525,
                    "textRun": {
                      "content": ". Perhaps more importantly, the competitive landscape had changed. AI had made it easier to develop and ship new features, so ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 127676,
                    "startIndex": 127651,
                    "textRun": {
                      "content": "differentiation collapsed",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 127960,
                    "startIndex": 127676,
                    "textRun": {
                      "content": ". Incumbents were in a race to the bottom on pricing — a knife-fight with both each other and with the new crop of upstart challengers that popped up. Emboldened by the leap in agentic coding capabilities and with no legacy cost structure to protect, these aggressively took share.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127351
            },
            {
              "endIndex": 127961,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 127961,
                    "startIndex": 127960,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127960
            },
            {
              "endIndex": 128311,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128056,
                    "startIndex": 127961,
                    "textRun": {
                      "content": "The interconnected nature of these systems weren’t fully appreciated until this print, either. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 128307,
                    "startIndex": 128056,
                    "textRun": {
                      "content": "ServiceNow sold seats. When Fortune 500 clients cut 15% of their workforce, they cancelled 15% of their licenses. The same AI-driven headcount reductions that were boosting margins at their customers were mechanically destroying their own revenue base",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 128311,
                    "startIndex": 128307,
                    "textRun": {
                      "content": ".  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 127961
            },
            {
              "endIndex": 128312,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128312,
                    "startIndex": 128311,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128311
            },
            {
              "endIndex": 128531,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128449,
                    "startIndex": 128312,
                    "textRun": {
                      "content": "^ I think there’ll be a shift to outcome-based pricing. Model makers are already talking about this, but then open models exist. Anyway, ",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 128529,
                    "startIndex": 128449,
                    "textRun": {
                      "content": "the application layer can do outcome-based pricing, or take stock in the company",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        },
                        "bold": true
                      }
                    }
                  },
                  {
                    "endIndex": 128531,
                    "startIndex": 128529,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128312
            },
            {
              "endIndex": 128532,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128532,
                    "startIndex": 128531,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128531
            },
            {
              "endIndex": 128728,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128728,
                    "startIndex": 128532,
                    "textRun": {
                      "content": "The company that sold workflow automation was being disrupted by better workflow automation, and its response was to cut headcount and use the savings to fund the very technology disrupting it.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128532
            },
            {
              "endIndex": 128729,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128729,
                    "startIndex": 128728,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128728
            },
            {
              "endIndex": 128867,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128867,
                    "startIndex": 128729,
                    "textRun": {
                      "content": "What else were they supposed to do? Sit still and die slower? The companies most threatened by AI became AI’s most aggressive adopters.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128729
            },
            {
              "endIndex": 128868,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 128868,
                    "startIndex": 128867,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128867
            },
            {
              "endIndex": 129238,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129238,
                    "startIndex": 128868,
                    "textRun": {
                      "content": "This sounds obvious in hindsight, but it really wasn’t at the time (at least to me). The historical disruption model said incumbents resist new technology, they lose share to nimble entrants and die slowly. That’s what happened to Kodak, to Blockbuster, to BlackBerry. What happened in 2026 was different; the incumbents didn’t resist because they couldn’t afford to.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 128868
            },
            {
              "endIndex": 129239,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129239,
                    "startIndex": 129238,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129238
            },
            {
              "endIndex": 129392,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129392,
                    "startIndex": 129239,
                    "textRun": {
                      "content": "^ Why else do they resist? Is this really how companies die? Customers leave because of consumer shifts preference to products the incumbent laughed at.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129239
            },
            {
              "endIndex": 129393,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129393,
                    "startIndex": 129392,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129392
            },
            {
              "endIndex": 129612,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129608,
                    "startIndex": 129393,
                    "textRun": {
                      "content": "With stocks down 40-60% and boards demanding answers, the AI-threatened companies did the only thing they could. Cut headcount, redeploy the savings into AI tools, use those tools to maintain output with lower costs",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 129612,
                    "startIndex": 129608,
                    "textRun": {
                      "content": ".  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129393
            },
            {
              "endIndex": 129613,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129613,
                    "startIndex": 129612,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129612
            },
            {
              "endIndex": 129809,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129809,
                    "startIndex": 129613,
                    "textRun": {
                      "content": "Each company’s individual response was rational. The collective result was catastrophic. Every dollar saved on headcount flowed into AI capability that made the next round of job cuts possible.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129613
            },
            {
              "endIndex": 129810,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 129810,
                    "startIndex": 129809,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129809
            },
            {
              "endIndex": 130115,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130115,
                    "startIndex": 129810,
                    "textRun": {
                      "content": "**Software was only the opening act.** What investors missed while they debated whether SaaS multiples had bottomed was that the reflexive loop had already escaped the software sector. The same logic that justified ServiceNow cutting headcount applied to every company with a white-collar cost structure.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 129810
            },
            {
              "endIndex": 130116,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130116,
                    "startIndex": 130115,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130115
            },
            {
              "endIndex": 130149,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130149,
                    "startIndex": 130116,
                    "textRun": {
                      "content": "**When Friction Went to Zero**  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130116
            },
            {
              "endIndex": 130472,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130472,
                    "startIndex": 130149,
                    "textRun": {
                      "content": "By early 2027, LLM usage had become default. People were using AI agents who didn’t even know what an AI agent was, in the same way people who never learned what “cloud computing” was used streaming services. They thought of it the same way they thought of autocomplete or spell-check — a thing their phone just did now.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130149
            },
            {
              "endIndex": 130473,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130473,
                    "startIndex": 130472,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130472
            },
            {
              "endIndex": 130798,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130798,
                    "startIndex": 130473,
                    "textRun": {
                      "content": "Qwen’s open-source agentic shopper was the catalyst for AI handling consumer decisions. Within weeks, every major AI assistant had integrated some agentic commerce feature. Distilled models meant these agents could run on phones and laptops, not just cloud instances, reducing the marginal cost of inference significantly.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130473
            },
            {
              "endIndex": 130799,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 130799,
                    "startIndex": 130798,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130798
            },
            {
              "endIndex": 131257,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131257,
                    "startIndex": 130799,
                    "textRun": {
                      "content": "The part that should have unsettled investors more than it did was that these agents didn’t wait to be asked. They ran in the background according to the user’s preferences. Commerce stopped being a series of discrete human decisions and became a continuous optimization process, running 24/7 on behalf of every connected consumer. By March 2027, the median individual in the United States was consuming 400,000 tokens per day — 10x since the end of 2026.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 130799
            },
            {
              "endIndex": 131258,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131258,
                    "startIndex": 131257,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131257
            },
            {
              "endIndex": 131470,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131470,
                    "startIndex": 131258,
                    "textRun": {
                      "content": "^ Need to run the numbers on everyone consuming n tokens per day. 400K/tok is not much. One Cursor turn can cost me 1M tokens. Not that it matters, the broader point about consumer friction is the bad bad thing.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131258
            },
            {
              "endIndex": 131471,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131471,
                    "startIndex": 131470,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131470
            },
            {
              "endIndex": 131522,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131522,
                    "startIndex": 131471,
                    "textRun": {
                      "content": "The next link in the chain was already breaking.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131471
            },
            {
              "endIndex": 131523,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131523,
                    "startIndex": 131522,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131522
            },
            {
              "endIndex": 131545,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131545,
                    "startIndex": 131523,
                    "textRun": {
                      "content": "**Intermediation.**  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131523
            },
            {
              "endIndex": 131546,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131546,
                    "startIndex": 131545,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131545
            },
            {
              "endIndex": 131894,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131894,
                    "startIndex": 131546,
                    "textRun": {
                      "content": "Over the past fifty years, the U.S. economy built a giant rent-extraction layer on top of human limitations: things take time, patience runs out, brand familiarity substitutes for diligence, and most people are willing to accept a bad price to avoid more clicks. Trillions of dollars of enterprise value depended on those constraints persisting.  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131546
            },
            {
              "endIndex": 131895,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 131895,
                    "startIndex": 131894,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131894
            },
            {
              "endIndex": 132032,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132032,
                    "startIndex": 131895,
                    "textRun": {
                      "content": "^ Brilliant insight. This is one of my concerns for Zipwire; it is sold on UX but humans will no longer be posting HTML Forms very soon.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 131895
            },
            {
              "endIndex": 132033,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132033,
                    "startIndex": 132032,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132032
            },
            {
              "endIndex": 132090,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132090,
                    "startIndex": 132033,
                    "textRun": {
                      "content": "It started out simple enough. Agents removed friction.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132033
            },
            {
              "endIndex": 132091,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132091,
                    "startIndex": 132090,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132090
            },
            {
              "endIndex": 132429,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132429,
                    "startIndex": 132091,
                    "textRun": {
                      "content": "Subscriptions and memberships that passively renewed despite months of disuse. Introductory pricing that sneakily doubled after the trial period. Each one was rebranded as a hostage situation that agents could negotiate. The average customer lifetime value, the metric the entire subscription economy was built on, distinctly declined.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132091
            },
            {
              "endIndex": 132430,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132430,
                    "startIndex": 132429,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132429
            },
            {
              "endIndex": 132509,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132509,
                    "startIndex": 132430,
                    "textRun": {
                      "content": "Consumer agents began to change how nearly all consumer transactions worked.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132430
            },
            {
              "endIndex": 132510,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132510,
                    "startIndex": 132509,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132509
            },
            {
              "endIndex": 132643,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132643,
                    "startIndex": 132510,
                    "textRun": {
                      "content": "Humans don’t really have the time to price-match across five competing platforms before buying a box of protein bars. Machines do.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132510
            },
            {
              "endIndex": 132644,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132644,
                    "startIndex": 132643,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132643
            },
            {
              "endIndex": 132911,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132693,
                    "startIndex": 132644,
                    "textRun": {
                      "content": "Travel booking platforms were an early casualty, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 132723,
                    "startIndex": 132693,
                    "textRun": {
                      "content": "because they were the simplest",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 132911,
                    "startIndex": 132723,
                    "textRun": {
                      "content": ". By Q4 2026, our agents could assemble a complete itinerary (flights, hotels, ground transport, loyalty optimization, budget constraints, refunds) faster and cheaper than any platform.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132644
            },
            {
              "endIndex": 132912,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132912,
                    "startIndex": 132911,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132911
            },
            {
              "endIndex": 132981,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132981,
                    "startIndex": 132912,
                    "textRun": {
                      "content": "^ Flight booking is not simple, it turns out, but the point remains.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132912
            },
            {
              "endIndex": 132982,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 132982,
                    "startIndex": 132981,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132981
            },
            {
              "endIndex": 133205,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133205,
                    "startIndex": 132982,
                    "textRun": {
                      "content": "Insurance renewals, where the entire renewal model depended on policyholder inertia, were reformed. Agents that re-shop your coverage annually dismantled the 15-20% of premiums that insurers earned from passive renewals.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 132982
            },
            {
              "endIndex": 133206,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133206,
                    "startIndex": 133205,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133205
            },
            {
              "endIndex": 133276,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133276,
                    "startIndex": 133206,
                    "textRun": {
                      "content": "^ Intelligence, tokens, transistors, energy, sun, solar panels, sand:\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133206
            },
            {
              "endIndex": 133277,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133277,
                    "startIndex": 133276,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133276
            },
            {
              "endIndex": 133586,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133586,
                    "startIndex": 133277,
                    "textRun": {
                      "content": "^ High-Purity Silica Sand (The Tech Crisis): Solar panels, smartphones, and fibre optics require \"industrial sand\" that is at least 95% to 99.9% pure silicon dioxide. This sand is much rarer; less than 1% of the sand extracted globally is pure enough for regular glass, and even less for solar-grade silicon.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133277
            },
            {
              "endIndex": 133587,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133587,
                    "startIndex": 133586,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133586
            },
            {
              "endIndex": 133978,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133978,
                    "startIndex": 133587,
                    "textRun": {
                      "content": "^ Ultra-Pure Quartz (The Chip Crisis): Computer chips are made from \"electronic-grade\" silicon, which often starts as high-purity quartz rather than common beach sand. While silicon makes up 28% of the Earth's crust, the energy and cost to purify it to the \"eleven nines\" (99.999999999% purity) level needed for chips is the real bottleneck, not the raw availability of the element itself. \n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133587
            },
            {
              "endIndex": 133979,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 133979,
                    "startIndex": 133978,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133978
            },
            {
              "endIndex": 134207,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134207,
                    "startIndex": 133979,
                    "textRun": {
                      "content": "Financial advice. Tax prep. Routine legal work. Any category where the service provider’s value proposition was ultimately “I will navigate complexity that you find tedious” was disrupted, as the agents found nothing tedious.  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.8
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 133979
            },
            {
              "endIndex": 134208,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134208,
                    "startIndex": 134207,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134207
            },
            {
              "endIndex": 134803,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134803,
                    "startIndex": 134208,
                    "textRun": {
                      "content": "Even places we thought insulated by the value of human relationships proved fragile. Real estate, where buyers had tolerated 5-6% commissions for decades because of information asymmetry between agent and consumer, crumbled once AI agents equipped with MLS access and decades of transaction data could replicate the knowledge base instantly. A sell-side piece from March 2027 titled it “agent on agent violence”. The median buy-side commission in major metros had compressed from 2.5-3% to under 1%, and a growing share of transactions were closing with no human agent on the buy side at all.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134208
            },
            {
              "endIndex": 134804,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134804,
                    "startIndex": 134803,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134803
            },
            {
              "endIndex": 134962,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134861,
                    "startIndex": 134804,
                    "textRun": {
                      "content": "We had overestimated the value of “human relationships”. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 134958,
                    "startIndex": 134861,
                    "textRun": {
                      "content": "Turns out that a lot of what people called relationships was simply friction with a friendly face",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 134959,
                    "startIndex": 134958,
                    "textRun": {
                      "content": ".",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 134962,
                    "startIndex": 134959,
                    "textRun": {
                      "content": "  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.8
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134804
            },
            {
              "endIndex": 134963,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134963,
                    "startIndex": 134962,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.8
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134962
            },
            {
              "endIndex": 134991,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134991,
                    "startIndex": 134963,
                    "textRun": {
                      "content": "^ Absolutely stellar quote.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134963
            },
            {
              "endIndex": 134992,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 134992,
                    "startIndex": 134991,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134991
            },
            {
              "endIndex": 135206,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135064,
                    "startIndex": 134992,
                    "textRun": {
                      "content": "That was just the start of the disruption for the intermediation layer. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 135206,
                    "startIndex": 135064,
                    "textRun": {
                      "content": "Successful companies had spent billions to effectively exploit quirks of consumer behavior and human psychology that didn’t matter anymore.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 134992
            },
            {
              "endIndex": 135207,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135207,
                    "startIndex": 135206,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135206
            },
            {
              "endIndex": 135511,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135511,
                    "startIndex": 135207,
                    "textRun": {
                      "content": "Machines optimizing for price and fit do not care about your favorite app or the websites you’ve been habitually opening for the last four years, nor feel the pull of a well-designed checkout experience. They don’t get tired and accept the easiest option or default to “I always just order from here”.  \n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135207
            },
            {
              "endIndex": 135512,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135512,
                    "startIndex": 135511,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135511
            },
            {
              "endIndex": 135585,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135585,
                    "startIndex": 135512,
                    "textRun": {
                      "content": "That destroyed a particular kind of moat: **habitual intermediation.**  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135512
            },
            {
              "endIndex": 135586,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135586,
                    "startIndex": 135585,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135585
            },
            {
              "endIndex": 135629,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135629,
                    "startIndex": 135586,
                    "textRun": {
                      "content": "DoorDash (DASH US) was the poster child.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135586
            },
            {
              "endIndex": 135630,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135630,
                    "startIndex": 135629,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135629
            },
            {
              "endIndex": 136136,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 135778,
                    "startIndex": 135630,
                    "textRun": {
                      "content": "Coding agents had collapsed the barrier to entry for launching a delivery app. A competent developer could deploy a functional competitor in weeks, ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 135903,
                    "startIndex": 135778,
                    "textRun": {
                      "content": "and dozens did, enticing drivers away from DoorDash and Uber Eats by passing 90-95% of the delivery fee through to the driver",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 136136,
                    "startIndex": 135903,
                    "textRun": {
                      "content": ". Multi-app dashboards let gig workers track incoming jobs from twenty or thirty platforms at once, eliminating the lock-in that the incumbents depended on. The market fragmented overnight and margins compressed to nearly nothing.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 135630
            },
            {
              "endIndex": 136137,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136137,
                    "startIndex": 136136,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136136
            },
            {
              "endIndex": 136539,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136245,
                    "startIndex": 136137,
                    "textRun": {
                      "content": "Agents accelerated both sides of the destruction. They enabled the competitors and then they used them. The ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 136535,
                    "startIndex": 136245,
                    "textRun": {
                      "content": "DoorDash moat was literally “you’re hungry, you’re lazy, this is the app on your home screen.” An agent doesn’t have a home screen. It checks DoorDash, Uber Eats, the restaurant’s own site, and twenty new vibe-coded alternatives so it can pick the lowest fee and fastest delivery every time",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 136539,
                    "startIndex": 136535,
                    "textRun": {
                      "content": ".  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136137
            },
            {
              "endIndex": 136540,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136540,
                    "startIndex": 136539,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136539
            },
            {
              "endIndex": 136639,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136639,
                    "startIndex": 136540,
                    "textRun": {
                      "content": "Habitual app loyalty, the entire basis of the business model, simply didn’t exist for a machine.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136540
            },
            {
              "endIndex": 136640,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136640,
                    "startIndex": 136639,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136639
            },
            {
              "endIndex": 136739,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136739,
                    "startIndex": 136640,
                    "textRun": {
                      "content": "^ How do you get a machine to care about loyalty? Game theory. Everything will become a mechanism.\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136640
            },
            {
              "endIndex": 136740,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136740,
                    "startIndex": 136739,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136739
            },
            {
              "endIndex": 137087,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 136991,
                    "startIndex": 136740,
                    "textRun": {
                      "content": "This was oddly poetic, as perhaps the only example in this entire saga of agents doing a favor for the soon-to-be-displaced white collar workers. When they ended up as delivery drivers, at least half their earnings weren’t going to Uber and DoorDash. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 137085,
                    "startIndex": 136991,
                    "textRun": {
                      "content": "Of course, this favor from technology didn’t last for long as autonomous vehicles proliferated",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 137087,
                    "startIndex": 137085,
                    "textRun": {
                      "content": ".\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 136740
            },
            {
              "endIndex": 137088,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137088,
                    "startIndex": 137087,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137087
            },
            {
              "endIndex": 137092,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137092,
                    "startIndex": 137088,
                    "textRun": {
                      "content": "---\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137088
            },
            {
              "endIndex": 137093,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137093,
                    "startIndex": 137092,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137092
            },
            {
              "endIndex": 137200,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137200,
                    "startIndex": 137093,
                    "textRun": {
                      "content": "(The publicly visible portion ends around there; the full paid version continues the scenario analysis.)  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137093
            },
            {
              "endIndex": 137201,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137201,
                    "startIndex": 137200,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137200
            },
            {
              "endIndex": 137415,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137415,
                    "startIndex": 137201,
                    "textRun": {
                      "content": "This matches all the recent coverage (market reaction, stock drops in software/payment names like DoorDash/Salesforce/Visa, 38% S&P drawdown in the scenario, “Ghost GDP,” white-collar displacement spiral, etc.).  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137201
            },
            {
              "endIndex": 137416,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137416,
                    "startIndex": 137415,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137415
            },
            {
              "endIndex": 137827,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137827,
                    "startIndex": 137416,
                    "textRun": {
                      "content": "Alap Shah’s companion pieces (the ones explicitly about the broader “Global Intelligence Crisis” series, including discussion of avoidance/mitigation via policy) are on his Substack (e.g., https://alapshah1.substack.com or the direct link referenced in the Citrini post). One recent entry addresses paths forward, noting that “decisive policy action acts to prevent a crisis” as one of the possible outcomes.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137416
            },
            {
              "endIndex": 137828,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137828,
                    "startIndex": 137827,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137827
            },
            {
              "endIndex": 137917,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137917,
                    "startIndex": 137828,
                    "textRun": {
                      "content": "Let me know if you want me to pull more details from Alap’s follow-ups or anything else!\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137828
            },
            {
              "endIndex": 137918,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137918,
                    "startIndex": 137917,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137917
            },
            {
              "endIndex": 137920,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137920,
                    "startIndex": 137918,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137918
            },
            {
              "endIndex": 137921,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137921,
                    "startIndex": 137920,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137920
            },
            {
              "endIndex": 137934,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 137934,
                    "startIndex": 137921,
                    "textRun": {
                      "content": "Introduction\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137921
            },
            {
              "endIndex": 138489,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 138489,
                    "startIndex": 137934,
                    "textRun": {
                      "content": "After years of exponential growth, the recent capability jump to agentic AI is set to upend the world as we know it beginning in 2026. Here is the uncomfortable truth: AI is no longer just a tool for economic growth; it is a near-direct substitute for human cognitive labor. In the near term, it will displace white-collar workers far faster than new markets can absorb them. In this three-part series, I draw on 20 years of experience investing in public markets and 15 years building AI companies to outline my perspective on the coming economic storm.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 137934
            },
            {
              "endIndex": 138490,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 138490,
                    "startIndex": 138489,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 138489
            },
            {
              "endIndex": 139280,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 138597,
                    "startIndex": 138490,
                    "textRun": {
                      "content": "Our entire economic system is built on a single premise: human intelligence is a scarce, expensive resource",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 139280,
                    "startIndex": 138597,
                    "textRun": {
                      "content": ". It is the key input required to turn raw materials into goods and services that dictate our living standards. In 2026, as agentic AI comes of age, that foundational assumption is collapsing. AI is no longer a mere tool or complement; it is rapidly becoming a direct substitute for human cognitive labor. This shift fundamentally devalues white-collar work. Fueled by surging AI progress and capital, this displacement will inexorably accelerate, creating an economic shock that could eclipse the Industrial Revolution, the Global Financial Crisis and the pandemic. Without urgent policy action, this has the potential to cause a significant financial crisis in the next two years.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 138490
            },
            {
              "endIndex": 139281,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 139281,
                    "startIndex": 139280,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 139280
            },
            {
              "endIndex": 139557,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 139557,
                    "startIndex": 139281,
                    "textRun": {
                      "content": "^ What else about humans is scarce and irreplaceable? Compassion and companionship, other than from dogs, is a finite resource - so long as the assumption holds that humans will value synthetic compassion and companionship less (see Huey, Dewey, and Louie in Silent Running).\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 139281
            },
            {
              "endIndex": 139558,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 139558,
                    "startIndex": 139557,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "bold": true
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 139557
            },
