                }
              },
              "startIndex": 193897
            },
            {
              "endIndex": 193964,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 193964,
                    "startIndex": 193898,
                    "textRun": {
                      "content": "Part 1: Citrini & Alap Shah (The Dystopian / Disruption Scenario)\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 193898
            },
            {
              "endIndex": 193965,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 193965,
