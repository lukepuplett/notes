              "paragraph": {
                "elements": [
                  {
                    "endIndex": 165405,
                    "inlineObjectElement": {
                      "inlineObjectId": "kix.eepfprwvcjj1",
                      "textStyle": {}
                    },
                    "startIndex": 165404
                  },
                  {
                    "endIndex": 165406,
                    "startIndex": 165405,
