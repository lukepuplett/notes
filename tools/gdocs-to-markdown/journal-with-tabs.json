            {
              "endIndex": 29538,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 29538,
                    "startIndex": 29426,
                    "textRun": {
                      "content": "Here are the **main claims** from the March 5, 2026 Anthropic paper by Massenkoff & McCrory, stated succinctly:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 29426
            },
            {
              "endIndex": 29539,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 29539,
                    "startIndex": 29538,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 29538
            },
            {
              "endIndex": 29757,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 29757,
                    "startIndex": 29539,
                    "textRun": {
                      "content": "- Introduces **\"observed exposure\"**: new measure of AI displacement risk combining theoretical LLM capability (Eloundou et al. β) with real-world Claude usage data, weighting automated/work-related uses more heavily.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 29539
            },
            {
              "endIndex": 29758,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 29758,
                    "startIndex": 29757,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 29757
            },
            {
              "endIndex": 29941,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 29941,
                    "startIndex": 29758,
                    "textRun": {
                      "content": "- **AI far from theoretical limits**: actual task coverage remains a small fraction of what's feasible (e.g., only 33% in Computer & Math occupations vs. 94% theoretically possible).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 29758
            },
            {
              "endIndex": 29942,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 29942,
                    "startIndex": 29941,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 29941
            },
            {
              "endIndex": 30077,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 29974,
                    "startIndex": 29942,
                    "textRun": {
                      "content": "- **Most exposed occupations**: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 29994,
                    "startIndex": 29974,
                    "textRun": {
                      "content": "Computer Programmers",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.8,
                              "green": 0.8,
                              "red": 0.95686275
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 30077,
                    "startIndex": 29994,
                    "textRun": {
                      "content": " (~75%), Customer Service Reps, Data Entry Keyers (~67%), Financial Analysts, etc.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 29942
            },
            {
              "endIndex": 30078,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30078,
                    "startIndex": 30077,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30077
            },
            {
              "endIndex": 30295,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30295,
                    "startIndex": 30078,
                    "textRun": {
                      "content": "- **BLS projections align somewhat**: higher observed exposure correlates with slower projected employment growth 2024–2034 (≈ –0.6 pp growth per 10 pp exposure increase); no such link with pure theoretical measures.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30078
            },
            {
              "endIndex": 30296,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30296,
                    "startIndex": 30295,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30295
            },
            {
              "endIndex": 30417,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30417,
                    "startIndex": 30296,
                    "textRun": {
                      "content": "- **Exposed workers' profile**: older, more female, more educated, higher-paid, more white/Asian (pre-ChatGPT baseline).\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30296
            },
            {
              "endIndex": 30418,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 30418,
                    "startIndex": 30417,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 30417
            },
