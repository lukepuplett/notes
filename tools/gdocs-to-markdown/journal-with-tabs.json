                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 305643
            },
            {
              "endIndex": 305665,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 305665,
                    "startIndex": 305657,
                    "textRun": {
                      "content": "@blocks\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
