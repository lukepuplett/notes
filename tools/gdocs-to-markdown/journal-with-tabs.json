                    "endIndex": 10219,
                    "startIndex": 10130,
                    "textRun": {
                      "content": "Volkswagen Aims To Make Majority Of Its Cars In China On New Architecture By 2030 - RTRS\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
