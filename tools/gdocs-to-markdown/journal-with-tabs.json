                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103063
            },
            {
              "endIndex": 103082,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103082,
                    "startIndex": 103081,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103081
            },
            {
              "endIndex": 103106,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103106,
                    "startIndex": 103082,
                    "textRun": {
                      "content": "and geopolitical power.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103082
            },
            {
              "endIndex": 103107,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103107,
                    "startIndex": 103106,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103106
            },
            {
              "endIndex": 103242,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103242,
                    "startIndex": 103107,
                    "textRun": {
                      "content": "That’s why Burry’s intuition isn’t that AI is fake — it’s that the equity story is mispriced relative to where value actually settles.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103107
            },
            {
              "endIndex": 103243,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103243,
                    "startIndex": 103242,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103242
            },
            {
              "endIndex": 103247,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103247,
                    "startIndex": 103243,
                    "textRun": {
                      "content": "So:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103243
            },
            {
              "endIndex": 103279,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103279,
                    "startIndex": 103247,
                    "textRun": {
                      "content": "2026 is when the story changes.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103247
            },
            {
              "endIndex": 103312,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103312,
                    "startIndex": 103279,
                    "textRun": {
                      "content": "The balance sheets already have.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103279
            },
            {
              "endIndex": 103313,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103313,
                    "startIndex": 103312,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 103312
            },
            {
              "endIndex": 103315,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 103315,
