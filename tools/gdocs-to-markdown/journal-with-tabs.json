                  "namedStyleType": "NORMAL_TEXT",
                  "spaceBelow": {
                    "magnitude": 12,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 17560
            },
            {
              "endIndex": 18003,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 18003,
                    "startIndex": 17792,
                    "textRun": {
                      "content": "The \"disalignment\" is a defensive reflex. The UK is trying to figure out how to be a \"power center\" of its own (or part of a European one) so it doesn't get crushed in the transition between the U.S. and China.\n",
                      "textStyle": {
