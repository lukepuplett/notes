            },
            {
              "endIndex": 101599,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 101599,
                    "startIndex": 101598,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101598
            },
            {
              "endIndex": 101633,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 101633,
                    "startIndex": 101599,
                    "textRun": {
                      "content": "Here’s the devil’s advocate case:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101599
            },
            {
              "endIndex": 101634,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 101634,
                    "startIndex": 101633,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101633
            },
            {
              "endIndex": 101661,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 101661,
                    "startIndex": 101634,
                    "textRun": {
                      "content": "1. The treadmill buys time\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101634
            },
            {
              "endIndex": 101898,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 101898,
                    "startIndex": 101661,
                    "textRun": {
                      "content": "As you noted earlier, expectations ratchet. Each frontier step creates new dependency before the last one commoditizes. That can sustain revenue growth even as margins stay awful. Think Uber pre-IPO: structurally bad, narratively alive.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101661
            },
            {
              "endIndex": 101899,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 101899,
                    "startIndex": 101898,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101898
            },
            {
              "endIndex": 101937,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 101902,
                    "startIndex": 101899,
                    "textRun": {
                      "content": "2. ",
                      "textStyle": {}
                    }
                  },
                  {
                    "endIndex": 101937,
                    "startIndex": 101902,
                    "textRun": {
                      "content": "Sovereign capital is the wild card\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.9529412,
                              "green": 0.8862745,
                              "red": 0.8117647
                            }
                          }
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101899
            },
            {
              "endIndex": 102205,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 102205,
                    "startIndex": 101937,
                    "textRun": {
                      "content": "Middle Eastern and Asian capital doesn’t care about IPO timelines or IRRs the same way. If the goal is influence, compute sovereignty, or talent capture, they can fund losses far longer than VCs can stomach. That can delay consolidation without changing the endpoint.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 101937
            },
            {
              "endIndex": 102206,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 102206,
                    "startIndex": 102205,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 102205
            },
            {
              "endIndex": 102248,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 102248,
                    "startIndex": 102206,
                    "textRun": {
                      "content": "3. Acquisition is optional, not mandatory\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 102206
            },
            {
              "endIndex": 102445,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 102445,
                    "startIndex": 102248,
                    "textRun": {
                      "content": "Big Tech doesn’t need to buy these labs. Letting them bleed while absorbing talent, ideas, and customers via the cloud layer can be strictly superior. That could mean zombification, not clean M&A.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 102248
            },
            {
              "endIndex": 102446,
              "paragraph": {
                "elements": [
                  {
