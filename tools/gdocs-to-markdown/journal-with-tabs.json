            },
            {
              "endIndex": 215934,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 215934,
                    "startIndex": 215841,
                    "textRun": {
                      "content": "Tesla EV registrations in Europe fell to 8,075 units in January, a 17% drop from a year ago.\n",
