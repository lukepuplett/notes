                },
                "elements": [
                  {
                    "endIndex": 11078,
                    "startIndex": 11038,
                    "textRun": {
                      "content": "Control of the World’s Largest Reserves:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
                              "red": 0.12156863
                            }
                          }
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Arial",
                          "weight": 400
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 11279,
                    "startIndex": 11078,
                    "textRun": {
                      "content": " Venezuela possesses over 300 billion barrels of proven oil reserves, the largest in the world. Regime change allows the U.S. to \"run\" the country and oversee the rebuilding of its oil infrastructure.\n",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
