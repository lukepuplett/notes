            },
            {
              "endIndex": 117484,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 117484,
                    "startIndex": 117178,
                    "textRun": {
                      "content": "Then one day you turn around and want to add a new feature. But the architecture, which is largely booboos at this point, doesn't allow your army of agents to make the change in a functioning way. Or your users are screaming at you because something in the latest release broke and deleted some user data.\n",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
                          "magnitude": 13.5,
                          "unit": "PT"
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Georgia",
                          "weight": 400
                        }
                      }
                    }
                  }
                ],
                "paragraphStyle": {
                  "borderBetween": {
                    "color": {},
                    "dashStyle": "SOLID",
                    "padding": {
                      "unit": "PT"
                    },
                    "width": {
                      "unit": "PT"
                    }
