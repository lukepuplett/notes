              "endIndex": 95658,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 95598,
                    "startIndex": 95542,
                    "textRun": {
                      "content": "Nothing controversial there. The only debatable part is ",
                      "textStyle": {}
                    }
                  },
