                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              },
              "startIndex": 14632
            },
            {
              "endIndex": 15002,
              "paragraph": {
                "bullet": {
                  "listId": "kix.t92yrn3u9utr",
                  "textStyle": {}
                },
                "elements": [
                  {
                    "endIndex": 14804,
                    "startIndex": 14783,
                    "textRun": {
                      "content": "The \"Bridge\" is Gone:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
                              "red": 0.12156863
                            }
                          }
                        },
                        "weightedFontFamily": {
                          "fontFamily": "Arial",
                          "weight": 400
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 15002,
                    "startIndex": 14804,
                    "textRun": {
                      "content": " In the 2026 landscape, the U.S. (especially under a second Trump term) no longer sees London as the gateway to Europe. When the U.S. wants to talk to \"Europe,\" it calls Paris, Berlin, or Brussels.\n",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
                              "red": 0.12156863
                            }
                          }
                        },
                        "weightedFontFamily": {
