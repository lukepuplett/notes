              "startIndex": 175487
            },
            {
              "endIndex": 175730,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 175730,
                    "startIndex": 175488,
                    "textRun": {
                      "content": "SiO₂ properties (high melting point 1,723°C, inertness, low expansion) limit substitutes. Synthetic quartz replaces natural HPQ in high-end uses but is expensive. Alternatives like alumina, graphite, or SiC introduce impurities or cost more.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 175488
            },
            {
              "endIndex": 175731,
              "paragraph": {
                "elements": [
                  {
