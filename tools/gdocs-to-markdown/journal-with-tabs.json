                "elements": [
                  {
                    "endIndex": 57077,
                    "startIndex": 57020,
                    "textRun": {
                      "content": "Sad to see this. And I understand the reasons behind it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 57020
            },
            {
              "endIndex": 57078,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 57078,
                    "startIndex": 57077,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "lineSpacing": 100,
