            },
            {
              "endIndex": 73994,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 73994,
                    "startIndex": 73993,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 73993
            },
            {
              "endIndex": 74031,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74031,
                    "startIndex": 73994,
                    "textRun": {
                      "content": "^ Remember everyone. AI is a bubble.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 73994
            },
            {
              "endIndex": 74032,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74032,
                    "startIndex": 74031,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74031
            },
            {
              "endIndex": 74034,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74034,
                    "startIndex": 74032,
                    "textRun": {
                      "content": "-\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74032
            },
            {
              "endIndex": 74035,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74035,
                    "startIndex": 74034,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74034
            },
            {
              "endIndex": 74201,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74201,
                    "startIndex": 74035,
                    "textRun": {
                      "content": "Scaling long-running autonomous coding. Wilson Lin at Cursor has been doing some experiments to see how far you can push a large fleet of \"autonomous\" coding agents:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74035
            },
            {
              "endIndex": 74202,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74202,
                    "startIndex": 74201,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74201
            },
            {
              "endIndex": 74408,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74408,
                    "startIndex": 74202,
                    "textRun": {
                      "content": "This post describes what we've learned from running hundreds of concurrent agents on a single project, coordinating their work, and watching them write over a million lines of code and trillions of tokens.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74202
            },
            {
              "endIndex": 74409,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74409,
                    "startIndex": 74408,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74408
            },
            {
              "endIndex": 74645,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74645,
                    "startIndex": 74409,
                    "textRun": {
                      "content": "They ended up running planners and sub-planners to create tasks, then having workers execute on those tasks - similar to how Claude Code uses sub-agents. Each cycle ended with a judge agent deciding if the project was completed or not.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74409
            },
            {
              "endIndex": 74646,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74646,
                    "startIndex": 74645,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74645
            },
            {
              "endIndex": 74708,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74708,
                    "startIndex": 74646,
                    "textRun": {
                      "content": "In my predictions for 2026 the other day I said that by 2029:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74646
            },
            {
              "endIndex": 74709,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 74709,
                    "startIndex": 74708,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74708
            },
            {
              "endIndex": 75017,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75017,
                    "startIndex": 74709,
                    "textRun": {
                      "content": "I think somebody will have built a full web browser mostly using AI assistance, and it won’t even be surprising. Rolling a new web browser is one of the most complicated software projects I can imagine[...] the cheat code is the conformance suites. If there are existing tests that it’ll get so much easier.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 74709
            },
            {
              "endIndex": 75018,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75018,
                    "startIndex": 75017,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75017
            },
            {
              "endIndex": 75164,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75164,
                    "startIndex": 75018,
                    "textRun": {
                      "content": "I may have been off by three years, because Cursor chose \"building a web browser from scratch\" as their test case for their agent swarm approach:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75018
            },
            {
              "endIndex": 75165,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75165,
                    "startIndex": 75164,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75164
            },
            {
              "endIndex": 75395,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75395,
                    "startIndex": 75165,
                    "textRun": {
                      "content": "To test this system, we pointed it at an ambitious goal: building a web browser from scratch. The agents ran for close to a week, writing over 1 million lines of code across 1,000 files. You can explore the source code on GitHub.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75165
            },
            {
              "endIndex": 75396,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75396,
                    "startIndex": 75395,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75395
            },
            {
              "endIndex": 75634,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75634,
                    "startIndex": 75396,
                    "textRun": {
                      "content": "But how well did they do? Their initial announcement a couple of days ago was met with unsurprising skepticism, especially when it became apparent that their GitHub Actions CI was failing and there were no build instructions in the repo.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75396
            },
            {
              "endIndex": 75635,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75635,
                    "startIndex": 75634,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75634
            },
            {
              "endIndex": 75778,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75778,
                    "startIndex": 75635,
                    "textRun": {
                      "content": "It looks like they addressed that within the past 24 hours. The latest README includes build instructions which I followed on macOS like this:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75635
            },
            {
              "endIndex": 75779,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75779,
                    "startIndex": 75778,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75778
            },
            {
              "endIndex": 75787,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75787,
                    "startIndex": 75779,
                    "textRun": {
                      "content": "cd /tmp\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75779
            },
            {
              "endIndex": 75838,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75838,
                    "startIndex": 75787,
                    "textRun": {
                      "content": "git clone https://github.com/wilsonzlin/fastrender\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75787
            },
            {
              "endIndex": 75852,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75852,
                    "startIndex": 75838,
                    "textRun": {
                      "content": "cd fastrender\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75838
            },
            {
              "endIndex": 75895,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75895,
                    "startIndex": 75852,
                    "textRun": {
                      "content": "git submodule update --init vendor/ecma-rs\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75852
            },
            {
              "endIndex": 75951,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 75951,
                    "startIndex": 75895,
                    "textRun": {
                      "content": "cargo run --release --features browser_ui --bin browser\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75895
            },
            {
              "endIndex": 76051,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76051,
                    "startIndex": 75951,
                    "textRun": {
                      "content": "This got me a working browser window! Here are screenshots I took of google.com and my own website:\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 75951
            },
            {
              "endIndex": 76052,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76052,
                    "startIndex": 76051,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76051
            },
            {
              "endIndex": 76265,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76265,
                    "startIndex": 76052,
                    "textRun": {
                      "content": "The browser chrome is neat but has a garbled tab name at the top. The Google homepage looks mostly correct but the buttons are not styled correctly and the Google Search one has a huge plus icon floating near it.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76052
            },
            {
              "endIndex": 76266,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76266,
                    "startIndex": 76265,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76265
            },
            {
              "endIndex": 76457,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76457,
                    "startIndex": 76266,
                    "textRun": {
                      "content": "My blog looks mostly correct, but the right closing quotation mark on a quotation (which is implemented as a background image on the final paragraph) is displayed incorrectly multiple times.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76266
            },
            {
              "endIndex": 76458,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76458,
                    "startIndex": 76457,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76457
            },
            {
              "endIndex": 76663,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76663,
                    "startIndex": 76458,
                    "textRun": {
                      "content": "Honestly those are very impressive! You can tell they're not just wrapping an existing rendering engine because of those very obvious rendering glitches, but the pages are legible and look mostly correct.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76458
            },
            {
              "endIndex": 76664,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76664,
                    "startIndex": 76663,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76663
            },
            {
              "endIndex": 76880,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76880,
                    "startIndex": 76664,
                    "textRun": {
                      "content": "The FastRender repo even uses Git submodules to include various WhatWG and CSS-WG specifications in the repo, which is a smart way to make sure the agents have access to the reference materials that they might need.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76664
            },
            {
              "endIndex": 76881,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 76881,
                    "startIndex": 76880,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76880
            },
            {
              "endIndex": 77096,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 77096,
                    "startIndex": 76881,
                    "textRun": {
                      "content": "This is the second attempt I've seen at building a full web browser using AI-assisted coding in the past two weeks - the first was HiWave browser, a new browser engine in Rust first announced in this Reddit thread.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 76881
            },
            {
              "endIndex": 77097,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 77097,
                    "startIndex": 77096,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 77096
            },
            {
              "endIndex": 77377,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 77377,
                    "startIndex": 77097,
                    "textRun": {
