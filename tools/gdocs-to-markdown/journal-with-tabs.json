            {
              "endIndex": 15249,
              "paragraph": {
                "elements": [
                  {
                    "endIndex": 15249,
                    "startIndex": 15128,
                    "textRun": {
                      "content": "It breaks down every pool of economic rent extracted by the services economy based on market cap, revenue and margins.  \n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "direction": "LEFT_TO_RIGHT",
                  "namedStyleType": "NORMAL_TEXT"
                }
              },
              "startIndex": 15128
            },
            {
              "endIndex": 15250,
              "paragraph": {
                "elements": [
