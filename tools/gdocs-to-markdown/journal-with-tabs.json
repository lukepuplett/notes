                "elements": [
                  {
                    "endIndex": 11582,
                    "startIndex": 11559,
                    "textRun": {
                      "content": "Lowering Energy Prices:",
                      "textStyle": {
                        "bold": true,
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
                              "green": 0.12156863,
