                        }
                      }
                    }
                  },
                  {
                    "endIndex": 14099,
                    "startIndex": 13926,
                    "textRun": {
                      "content": " Nations like China and Russia have condemned the move as a violation of sovereignty, which may lead to retaliatory geopolitical shifts elsewhere (e.g., Ukraine or Taiwan).\n",
                      "textStyle": {
                        "foregroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 0.12156863,
