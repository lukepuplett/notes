                          "weight": 400
                        }
                      }
                    }
                  },
                  {
                    "endIndex": 121681,
                    "startIndex": 121669,
                    "textRun": {
                      "content": " applied to ",
                      "textStyle": {
                        "backgroundColor": {
                          "color": {
                            "rgbColor": {
                              "blue": 1,
                              "green": 1,
                              "red": 1
                            }
                          }
                        },
                        "fontSize": {
